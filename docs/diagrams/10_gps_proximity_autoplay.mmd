sequenceDiagram
    participant GPS as GPS (Maui Geolocation)
    participant Geo as GeolocationService
    participant Auto as AutoPlaybackService
    participant DB as LocalDatabaseService (SQLite)
    participant Api as RemoteApiService / ApiService
    participant Audio as AudioService

    loop Every 5 seconds
        Geo->>GPS: GetLocationAsync(Medium accuracy, 10s timeout)
        GPS-->>Geo: Location {lat, lng, accuracy}

        Geo->>Geo: CalculateVelocity(prevLoc, currLoc, delta time)
        Geo->>Geo: CalculateHeading(prevLoc, currLoc)
        Geo->>Geo: Save LatestLocation {lat, lng, Velocity, Heading}

        Geo->>Api: GetNearbyLocationsAsync(lat, lng, scanRadius)
        Api-->>Geo: List<Location> (ordered by dist, priority)

        Geo->>Auto: raise NearbyLocationDetected(candidates)
    end

    Auto->>Auto: Filter candidates where distance <= 5m (TriggerRadius)

    alt Multiple candidates within 5m (Tie-breaker)
        Auto->>Auto: ResolveTieBreaker(candidates)
        note over Auto: Score = Distance(40%) + Approach(30%) + Priority(20%) + Heading/Velocity(bonus)
        Auto->>Auto: Pick highest score candidate
    end

    alt LocationId NOT in currentlyInsideLocations
        Auto->>DB: GetLastPlayedAtAsync(locationId)
        DB-->>Auto: DateTime? lastTime

        alt lastTime exists AND diff < 5 min (cooldown)
            Auto->>Auto: MainThread.DisplayAlert("Muon nghe lai?")
            note over Auto: User clicks No -> return
        end

        alt AudioService.IsPlaying == true
            Auto->>DB: IsInPlaybackQueueAsync(locationId)
            DB-->>Auto: false
            Auto->>DB: EnqueuePlaybackAsync(locationId)
            note over Auto: Queue to SQLite, do NOT interrupt current audio
        else AudioService.IsPlaying == false
            Auto->>Api: GetLocationByIdAsync(locationId)
            Api-->>Auto: Location {AudioGuides[]}
            Auto->>DB: SetLastPlayedAtAsync(locationId, now)
            Auto->>Audio: PlayAsync(url, locationId, guideId, isDirectTap=false)
        end
    end

    Audio->>Audio: LoadPlayerAsync(url) via HTTP
    Audio->>Audio: player.Play()
    Audio->>Auto: raise StateChanged(Playing)

    note over Auto: When audio finishes (Stopped/None state)
    Audio->>Auto: raise StateChanged(Stopped)
    Auto->>DB: DequeuePlaybackAsync()
    DB-->>Auto: nextLocationId (FIFO)
    Auto->>Api: GetLocationByIdAsync(nextLocationId)
    Auto->>Audio: PlayAsync(nextUrl, ...)
