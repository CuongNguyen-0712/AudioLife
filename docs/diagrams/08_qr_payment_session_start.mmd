sequenceDiagram
    participant User
    participant QrPage as QR Scan Page
    participant PayPage as Payment Page
    participant Payload as QrCodePayloadService
    participant Api as RemoteApiService
    participant Server as Web API Server
    participant Store as AppSessionStore
    participant Hb as AppHeartbeatService

    User->>QrPage: Aim camera at QR code
    QrPage->>Payload: TryParseAudioPayload(rawQrValue)
    Payload->>Payload: Parse URI scheme://host/audio?locationId=...&identityToken=...&packageId=...
    Payload-->>QrPage: QrAudioPayload {LocationId, IdentityToken, PaymentPackageId, AudioGuideId, AudioUrl}

    QrPage->>Api: CheckDeviceSessionAsync(deviceId)
    Api->>Server: GET api/mobile/session/by-device?deviceId=...
    Server-->>Api: DeviceSessionCheckResult {HasSession, SessionToken}

    alt Has active session
        QrPage->>Store: SaveSnapshotAsync(snapshot)
        QrPage->>QrPage: Navigate to main page
    else No session
        QrPage->>Api: GetPaymentPackagesAsync()
        Api->>Server: GET api/mobile/payment/packages
        Server-->>Api: List<PaymentPackage> (active, ordered by price)
        Api-->>PayPage: packages

        User->>PayPage: Select package, confirm payment

        PayPage->>Api: CompletePaymentAsync(PaymentCompletionRequest)
        note over PayPage: Request includes DeviceId, QrToken, PackageId, PaymentStatus, LocationId, AudioGuideId
        Api->>Server: POST api/mobile/payment/complete {payload}
        Server-->>Api: PaymentCompletionResult {Success, SessionToken, RefreshToken, ExpiresAtUtc}

        alt Payment success
            PayPage->>Store: SaveSnapshotAsync(new snapshot with SessionToken)
            PayPage->>Hb: StartAsync()
            PayPage->>PayPage: Navigate to main page
            PayPage->>PayPage: Auto-play AudioGuide from QR payload
        else Payment failed
            PayPage->>User: Show error message
        end
    end
