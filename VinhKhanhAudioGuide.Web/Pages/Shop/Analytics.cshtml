@page
@model VinhKhanhAudioGuide.Web.Pages.Shop.AnalyticsModel
@{
    ViewData["Title"] = "Thống kê và phân tích";
    ViewData["ActivePage"] = "ShopAnalytics";

    var avgMinutes = Model.TotalAudios == 0 ? 0 : Math.Round((double)Model.TotalAudioMinutes / Model.TotalAudios, 1);
    var topListenSeconds = Model.TopAudios.Any() ? Model.TopAudios.Max(x => x.ListenSeconds) : 0;
    var totalListenMinutes = Math.Round(Model.TotalListenSeconds / 60.0, 1);
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-chart-pie"></i> Thống kê POI</p>
        <h1 class="hero-title">Thống kê và phân tích</h1>
        <p class="hero-subtitle">Địa điểm đang xem: @Model.SelectedLocationName</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-wave-square"></i> Hiệu suất audio</span>
</div>

<div class="shop-card card-v2 mb-4">
    <div class="shop-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="locationId">Địa điểm</label>
                <select id="locationId" name="locationId" class="form-select">
                    @foreach (var location in Model.AccessibleLocations)
                    {
                        <option value="@location.Id" selected="@(location.Id == Model.LocationId)">@location.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><button class="btn btn-shop w-100" type="submit">Xem thống kê</button></div>
        </form>
    </div>
</div>

<div class="metric-grid mb-4">
    <div class="metric-box"><div class="k">Tổng audio</div><div class="v">@Model.TotalAudios</div></div>
    <div class="metric-box"><div class="k">Tổng phút nghe</div><div class="v">@Model.TotalAudioMinutes</div></div>
    <div class="metric-box"><div class="k">Trung bình phút / audio</div><div class="v">@avgMinutes</div></div>
    <div class="metric-box"><div class="k">Bản ghi lịch sử nghe</div><div class="v">@Model.TotalHistoryRecords</div></div>
    <div class="metric-box"><div class="k">Số audio hoàn thành</div><div class="v">@Model.TotalCompletedRecords</div></div>
    <div class="metric-box"><div class="k">Tổng phút nghe thực tế</div><div class="v">@totalListenMinutes</div></div>
    <div class="metric-box"><div class="k">Tiến độ nghe trung bình</div><div class="v">@Model.AverageProgressPercent%</div></div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="shop-card card-v2 h-100">
            <div class="shop-card-header">Top audio theo thời lượng nghe thực tế</div>
            <div class="shop-card-body">
                <div class="chart-wrap"><canvas id="shopTopAudioChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="shop-card card-v2 h-100">
            <div class="shop-card-header">Chi tiết xếp hạng</div>
            <div class="shop-card-body">
                @if (!Model.TopAudios.Any())
                {
                    <div class="shop-muted">Chưa có dữ liệu audio để phân tích.</div>
                }
                else
                {
                    <div class="progress-list">
                        @foreach (var item in Model.TopAudios)
                        {
                            var percent = topListenSeconds == 0 ? 0 : Math.Round((double)item.ListenSeconds / topListenSeconds * 100, 0);
                            <div class="progress-item">
                                <div class="progress-head">
                                    <span>@item.Title</span>
                                    <span>@Math.Round(item.ListenSeconds / 60.0, 1) phút nghe</span>
                                </div>
                                <div class="progress-track"><div class="progress-fill" style="width:@percent%"></div></div>
                                <div class="small text-muted mt-1">@item.ListenCount bản ghi · @item.CompletionRatePercent% hoàn thành trung bình</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const topAudioLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopAudios.Select(x => x.Title)));
        const topAudioValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopAudios.Select(x => x.ListenSeconds)));

        const topAudioCtx = document.getElementById('shopTopAudioChart');
        if (topAudioCtx) {
            new Chart(topAudioCtx, {
                type: 'bar',
                data: {
                    labels: topAudioLabels,
                    datasets: [{
                        label: 'Giây nghe',
                        data: topAudioValues,
                        borderRadius: 8,
                        backgroundColor: '#0ea5e9'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }
    </script>
}
