@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Shop.Locations.EditModel
@{
    ViewData["Title"] = "Sửa địa điểm";
    ViewData["ActivePage"] = "ShopDashboard";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-location-dot"></i> Cập nhật POI</p>
        <h1 class="hero-title">Sửa thông tin địa điểm</h1>
        <p class="hero-subtitle">Điều chỉnh mô tả, vị trí và thời lượng để đồng bộ nội dung theo từng POI.</p>
    </div>
    <a asp-page="/Shop/Index" asp-route-locationId="@Model.Location.Id" class="btn btn-outline-secondary">Quay lại bảng điều khiển POI</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="shop-card card-v2">
    <div class="shop-card-body">
        <form method="post" style="max-width:760px;">
            <input asp-for="Location.Id" type="hidden" />
            <input asp-for="Location.CategoryId" type="hidden" />

            <div class="mb-3">
                <label asp-for="Location.Name" class="form-label">Tên địa điểm</label>
                <input asp-for="Location.Name" class="form-control" />
                <span asp-validation-for="Location.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location.Description" class="form-label">Mô tả</label>
                <textarea asp-for="Location.Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Location.Address" class="form-label">Địa chỉ</label>
                <input asp-for="Location.Address" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Latitude" class="form-label">Vĩ độ</label>
                    <input asp-for="Location.Latitude" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Longitude" class="form-label">Kinh độ</label>
                    <input asp-for="Location.Longitude" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Duration" class="form-label">Thời lượng (phút)</label>
                    <input asp-for="Location.Duration" type="number" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Location.ImageUrl" class="form-label">URL hình ảnh</label>
                <input asp-for="Location.ImageUrl" class="form-control" />
            </div>

            <button type="submit" class="btn btn-shop">Lưu cập nhật</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
