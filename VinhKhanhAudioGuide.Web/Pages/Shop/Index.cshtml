@page
@model VinhKhanhAudioGuide.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Bảng điều khiển Admin POI";
    ViewData["ActivePage"] = "ShopDashboard";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-store"></i> Không gian POI</p>
        <h1 class="hero-title">Bảng điều khiển Admin POI</h1>
        <p class="hero-subtitle">Quản trị nội dung audio theo từng địa điểm được cấp quyền.</p>
    </div>
    <div class="hero-actions-shop">
        <a asp-page="/Shop/Locations/Create" class="btn btn-shop"><i class="fas fa-location-plus me-1"></i>Tạo POI mới (gửi duyệt)</a>
        <span class="hero-badge"><i class="fa-solid fa-location-dot"></i> Phạm vi theo địa điểm</span>
        <button type="button" class="hero-close-btn-shop" id="closePoiDashboardHero"><i class="fas fa-xmark"></i> Đóng</button>
    </div>
</div>

<div class="alert alert-info mb-4 alert-admin" role="alert">
    <i class="fas fa-circle-info me-2"></i>
    Vai trò Admin POI chỉ quản lý nội dung audio tại các địa điểm đã được phân quyền.
</div>

@section Scripts {
    <script>
        const closePoiHeroButton = document.getElementById('closePoiDashboardHero');
        const poiDashboardHero = document.querySelector('.dashboard-hero');

        if (closePoiHeroButton && poiDashboardHero) {
            closePoiHeroButton.addEventListener('click', function () {
                poiDashboardHero.classList.add('is-closed');
            });
        }
    </script>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="shop-card card-v2">
            <div class="shop-card-header">Chọn địa điểm quản trị</div>
            <div class="shop-card-body">
                <form method="get">
                    <label asp-for="SelectedLocationId" class="form-label">Địa điểm</label>
                    <select asp-for="SelectedLocationId" class="form-select mb-3">
                        <option value="">-- Chọn một địa điểm --</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.Id">@location.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-shop w-100">Mở bảng điều khiển địa điểm</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="shop-card h-100 card-v2">
            <div class="shop-card-header">Tổng quan</div>
            <div class="shop-card-body">
                @if (Model.SelectedLocation is null)
                {
                    <p class="shop-muted mb-0">Chưa chọn địa điểm. Hãy chọn một địa điểm để xem bảng điều khiển Admin POI.</p>
                }
                else
                {
                    <h5 class="mb-2">@Model.SelectedLocation.Name</h5>
                    <p class="shop-muted mb-1">@Model.SelectedLocation.Address</p>
                    <p class="shop-muted mb-4">Danh mục: @Model.CategoryName</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 border rounded">
                                <div class="shop-muted small">Tổng audio</div>
                                <div class="shop-stat">@Model.AudioGuideCount</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded">
                                <div class="shop-muted small">Tổng phút audio</div>
                                <div class="shop-stat">@Model.AudioDurationMinutes</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded">
                                <div class="shop-muted small">Tour ẩm thực liên quan</div>
                                <div class="shop-stat">@Model.TourCount</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="fw-semibold mb-2">Audio mới nhất</div>
                        @if (Model.RecentAudioGuides.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 table-v2">
                                    <thead>
                                        <tr>
                                            <th>Tiêu đề</th>
                                            <th>Thời lượng</th>
                                            <th>Ngôn ngữ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var audio in Model.RecentAudioGuides)
                                        {
                                            <tr>
                                                <td>@audio.Title</td>
                                                <td>@audio.Duration phút</td>
                                                <td>@audio.Language</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="shop-muted">Địa điểm chưa có audio nào.</div>
                        }
                    </div>

                    <div class="mb-4">
                        <div class="fw-semibold mb-2">Tours có ghé địa điểm này</div>
                        @if (Model.RelatedTours.Any())
                        {
                            <div class="shop-action-buttons">
                                @foreach (var tour in Model.RelatedTours)
                                {
                                    <span class="badge text-bg-light border">@tour.Name</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="shop-muted">Chưa có tour nào liên kết.</div>
                        }
                    </div>

                    <div class="shop-action-buttons">
                        <a class="btn btn-outline-primary" asp-page="/Shop/Locations/Edit" asp-route-id="@Model.SelectedLocation.Id">Sửa thông tin địa điểm</a>
                        <a class="btn btn-outline-secondary" asp-page="/Shop/Locations/Create">Tạo POI mới (gửi duyệt)</a>
                        <a class="btn btn-outline-success" asp-page="/Shop/AudioGuides/Index" asp-route-locationId="@Model.SelectedLocation.Id">Quản lý audio</a>
                        <a class="btn btn-outline-dark" asp-page="/Shop/ChangeRequests">Theo dõi yêu cầu duyệt</a>
                    </div>
                    <p class="shop-muted small mt-2 mb-0">Mọi chỉnh sửa tại khu POI sẽ tự động gửi về Admin Hệ thống để duyệt trước khi áp dụng.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="shop-card card-v2 mt-4">
    <div class="shop-card-header d-flex justify-content-between align-items-center">
        <span>Yêu cầu review gần đây của bạn</span>
        <a asp-page="/Shop/ChangeRequests" class="btn btn-sm btn-outline-secondary">Xem toàn bộ</a>
    </div>
    <div class="shop-card-body">
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-lg-3"><div class="p-2 border rounded"><div class="shop-muted small">Pending</div><div class="shop-stat">@Model.PendingRequestCount</div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="p-2 border rounded"><div class="shop-muted small">In Review</div><div class="shop-stat">@Model.InReviewRequestCount</div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="p-2 border rounded"><div class="shop-muted small">Approved</div><div class="shop-stat">@Model.ApprovedRequestCount</div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="p-2 border rounded"><div class="shop-muted small">Rejected</div><div class="shop-stat">@Model.RejectedRequestCount</div></div></div>
        </div>

        @if (!Model.RecentSubmittedRequests.Any())
        {
            <div class="shop-muted">Bạn chưa gửi yêu cầu review nào.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 table-v2">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>POI</th>
                            <th>Tiêu đề</th>
                            <th>Trạng thái</th>
                            <th>Review</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var request in Model.RecentSubmittedRequests)
                    {
                        <tr>
                            <td>@request.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@request.LocationName</td>
                            <td>
                                <div class="fw-semibold">@request.Title</div>
                                <div class="small text-muted">@request.Topic</div>
                            </td>
                            <td><span class="badge @IndexModel.GetStatusBadgeClass(request.Status)">@request.Status</span></td>
                            <td>
                                @if (request.UpdatedAtUtc.HasValue)
                                {
                                    <div class="small text-muted">@request.UpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="small text-muted">@request.UpdatedBy</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(request.ReviewNote))
                                {
                                    <div class="small">@request.ReviewNote</div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
