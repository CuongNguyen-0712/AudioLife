@page
@model VinhKhanhAudioGuide.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Dashboard Chủ Shop";
    ViewData["ActivePage"] = "ShopDashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0"><i class="fas fa-store me-2"></i>Quản trị theo chủ shop</h1>
    <span class="shop-muted">Mỗi chủ shop chọn địa điểm mình phụ trách để quản trị.</span>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="shop-card">
            <div class="shop-card-header">Chọn địa điểm quản trị</div>
            <div class="shop-card-body">
                <form method="get">
                    <label for="locationId" class="form-label">Địa điểm</label>
                    <select id="locationId" name="locationId" class="form-select mb-3">
                        <option value="">-- Chọn một địa điểm --</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.Id" selected="@(location.Id == Model.SelectedLocationId)">@location.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-shop">Mở quản trị địa điểm</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="shop-card h-100">
            <div class="shop-card-header">Tổng quan</div>
            <div class="shop-card-body">
                @if (Model.SelectedLocation is null)
                {
                    <p class="shop-muted mb-0">Chưa chọn địa điểm. Hãy chọn một địa điểm bên trái để xem dashboard của chủ shop.</p>
                }
                else
                {
                    <h5 class="mb-3">@Model.SelectedLocation.Name</h5>
                    <p class="shop-muted mb-4">@Model.SelectedLocation.Address</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="shop-muted small">Số Audio Guide</div>
                                <div class="shop-stat">@Model.AudioGuideCount</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="shop-muted small">Thời lượng tham quan</div>
                                <div class="shop-stat">@Model.SelectedLocation.Duration phút</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" asp-page="/Shop/Locations/Edit" asp-route-id="@Model.SelectedLocation.Id">Sửa thông tin địa điểm</a>
                        <a class="btn btn-outline-success" asp-page="/Shop/AudioGuides/Index" asp-route-locationId="@Model.SelectedLocation.Id">Quản lý Audio Guides</a>
                        <a class="btn btn-outline-secondary" asp-page="/Shop/AudioGuides/Index" asp-route-locationId="@Model.SelectedLocation.Id">Xem danh sách audio</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
