@page
@model VinhKhanhAudioGuide.Web.Pages.Shop.ReviewsModel
@{
    ViewData["Title"] = "Quản lý đánh giá";
    ViewData["ActivePage"] = "ShopReviews";

    var totalReviews = Model.Reviews.Count;
    var waitingReviews = Model.Reviews.Count(x => x.PendingReply);
    var avgRating = totalReviews == 0 ? 0 : Math.Round(Model.Reviews.Average(x => x.Rating), 1);
    var fiveStar = Model.Reviews.Count(x => x.Rating == 5);
    var fourStar = Model.Reviews.Count(x => x.Rating == 4);
    var threeStar = Model.Reviews.Count(x => x.Rating == 3);
    var twoStar = Model.Reviews.Count(x => x.Rating == 2);
    var oneStar = Model.Reviews.Count(x => x.Rating == 1);
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-comments"></i> Phản hồi người dùng</p>
        <h1 class="hero-title">Quản lý đánh giá</h1>
        <p class="hero-subtitle">Theo dõi phản hồi cho từng audio, ưu tiên xử lý đánh giá đang chờ.</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-star"></i> Kiểm duyệt đánh giá</span>
</div>

<div class="shop-card card-v2 mb-4">
    <div class="shop-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="locationId">Địa điểm</label>
                <select id="locationId" name="locationId" class="form-select">
                    @foreach (var location in Model.AccessibleLocations)
                    {
                        <option value="@location.Id" selected="@(location.Id == Model.LocationId)">@location.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><button class="btn btn-shop w-100" type="submit">Xem đánh giá</button></div>
        </form>
    </div>
</div>

<div class="metric-grid mb-4">
    <div class="metric-box"><div class="k">Tổng đánh giá</div><div class="v">@totalReviews</div></div>
    <div class="metric-box"><div class="k">Đánh giá chờ phản hồi</div><div class="v">@waitingReviews</div></div>
    <div class="metric-box"><div class="k">Điểm trung bình</div><div class="v">@avgRating</div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="shop-card card-v2 h-100">
            <div class="shop-card-header">Phân bổ số sao</div>
            <div class="shop-card-body">
                <div class="chart-wrap-sm"><canvas id="ratingChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="shop-card card-v2 h-100">
            <div class="shop-card-header">Tình trạng phản hồi</div>
            <div class="shop-card-body">
                <div class="progress-list">
                    @{
                        var doneReviews = totalReviews - waitingReviews;
                        var waitingPercent = totalReviews == 0 ? 0 : Math.Round((double)waitingReviews / totalReviews * 100, 0);
                        var donePercent = totalReviews == 0 ? 0 : Math.Round((double)doneReviews / totalReviews * 100, 0);
                    }
                    <div class="progress-item">
                        <div class="progress-head"><span>Chờ phản hồi</span><span>@waitingReviews đánh giá</span></div>
                        <div class="progress-track"><div class="progress-fill" style="width:@waitingPercent%"></div></div>
                    </div>
                    <div class="progress-item">
                        <div class="progress-head"><span>Đã phản hồi</span><span>@doneReviews đánh giá</span></div>
                        <div class="progress-track"><div class="progress-fill" style="width:@donePercent%"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="shop-card card-v2">
    <div class="shop-card-header">Danh sách đánh giá chi tiết</div>
    <div class="shop-card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 table-v2">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Audio</th>
                        <th>Đánh giá</th>
                        <th>Nội dung</th>
                        <th>Phản hồi</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var review in Model.Reviews)
                {
                    <tr>
                        <td>@review.UserName</td>
                        <td>@review.AudioTitle</td>
                        <td>
                            @for (var i = 0; i < review.Rating; i++)
                            {
                                @:&#9733;
                            }
                        </td>
                        <td>@review.Comment</td>
                        <td>
                            @if (review.PendingReply)
                            {
                                <span class="badge text-bg-warning">Chờ phản hồi</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Đã phản hồi</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ratingCtx = document.getElementById('ratingChart');
        if (ratingCtx) {
            new Chart(ratingCtx, {
                type: 'bar',
                data: {
                    labels: ['5 sao', '4 sao', '3 sao', '2 sao', '1 sao'],
                    datasets: [{
                        label: 'Số lượng',
                        data: [@fiveStar, @fourStar, @threeStar, @twoStar, @oneStar],
                        borderRadius: 8,
                        backgroundColor: ['#10b981', '#22c55e', '#f59e0b', '#fb923c', '#ef4444']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }
    </script>
}
