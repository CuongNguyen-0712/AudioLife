@page
@model VinhKhanhAudioGuide.Web.Pages.Shop.AudioGuides.IndexModel
@{
    ViewData["Title"] = "Quản lý âm thanh";
    ViewData["ActivePage"] = "ShopAudios";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-headphones"></i> Studio nội dung</p>
        <h1 class="hero-title">Quản lý âm thanh</h1>
        <p class="hero-subtitle">Quản trị thư viện audio theo từng POI và cập nhật nội dung nhanh.</p>
    </div>
    <a asp-page="/Shop/Index" asp-route-locationId="@Model.LocationId" class="btn btn-outline-secondary">Về bảng điều khiển POI</a>
</div>

<div class="shop-card card-v2 mb-4">
    <div class="shop-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label for="locationId" class="form-label">Địa điểm</label>
                <select id="locationId" name="locationId" class="form-select">
                    @foreach (var location in Model.AccessibleLocations)
                    {
                        <option value="@location.Id" selected="@(location.Id == Model.LocationId)">@location.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-shop w-100">Xem danh sách âm thanh</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="shop-card card-v2">
    <div class="shop-card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 table-v2">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Ngôn ngữ</th>
                        <th>Thời lượng</th>
                        <th>Audio URL</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AudioGuides)
                    {
                        <tr>
                            <td><code>@item.Id</code></td>
                            <td>
                                <strong>@item.Title</strong>
                                <div class="small text-muted">@item.Description</div>
                            </td>
                            <td>@item.Language</td>
                            <td>@item.Duration phút</td>
                            <td class="audio-preview-cell">
                                @{ var selectedAudioUrl = !string.IsNullOrWhiteSpace(item.AudioUrl) ? item.AudioUrl : item.CloudinaryAudioUrl; }
                                @if (!string.IsNullOrEmpty(item.CloudinaryAudioUrl) || !string.IsNullOrEmpty(item.AudioUrl))
                                {
                                    <div class="audio-preview-box">
                                        <audio controls class="audio-preview-player">
                                            <source src="@selectedAudioUrl" type="audio/mpeg">
                                        </audio>
                                        <small class="audio-preview-url" title="@selectedAudioUrl">@selectedAudioUrl</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có file audio</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="/Shop/AudioGuides/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.AudioGuides.Any())
        {
            <p class="shop-muted mt-3 mb-0">Chưa có audio guide nào cho địa điểm này.</p>
        }
    </div>
</div>
