@page
@model VinhKhanhAudioGuide.Web.Pages.Locations.IndexModel
@{
    ViewData["Title"] = "Địa điểm";
    ViewData["ActivePage"] = "Locations";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-location-dot"></i> Danh bạ POI</p>
        <h1 class="hero-title">Quản lý địa điểm</h1>
        <p class="hero-subtitle">Quản trị điểm đến ẩm thực, category mapping và metadata hiển thị.</p>
    </div>
    <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm địa điểm</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card card-v2 mb-4">
    <div class="p-3 p-md-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label for="keyword" class="form-label">Tìm POI</label>
                <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên, địa chỉ, mô tả..." />
            </div>
            <div class="col-md-4">
                <label for="categoryId" class="form-label">Danh mục</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input id="onlyNoAudio" name="onlyNoAudio" value="true" type="checkbox" class="form-check-input" checked="@Model.OnlyNoAudio" />
                    <label class="form-check-label" for="onlyNoAudio">Chỉ POI chưa có audio</label>
                </div>
            </div>
            <div class="col-md-1">
                <button class="btn-admin btn-admin-primary w-100" type="submit">Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card card-v2">
    <div class="p-3 small text-muted">Đang hiển thị @Model.Locations.Count POI.</div>
    <table class="admin-table table-v2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên địa điểm</th>
                <th>Danh mục</th>
                <th>Địa chỉ</th>
                <th>Thời lượng</th>
                <th>Audio</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loc in Model.Locations)
            {
                <tr>
                    <td><code>@loc.Id</code></td>
                    <td><strong>@loc.Name</strong></td>
                    <td><span class="badge-admin badge-category"><i class="fas @(loc.Category?.Icon ?? "fa-folder") me-1"></i>@(loc.Category?.Name ?? "N/A")</span></td>
                    <td class="address-cell">@loc.Address</td>
                    <td>@loc.Duration phút</td>
                    <td><span class="badge-admin badge-count">@loc.AudioGuides.Count</span></td>
                    <td class="action-cell">
                        <div class="action-buttons">
                            <a asp-page="Edit" asp-route-id="@loc.Id" class="btn-admin btn-sm-admin btn-sm-icon btn-admin-warning" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                            <a asp-page="Delete" asp-route-id="@loc.Id" class="btn-admin btn-sm-admin btn-sm-icon btn-admin-danger" title="Xóa"><i class="fas fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Locations.Any())
    {
        <div class="empty-state"><i class="fas fa-map-marker-alt d-block"></i>Chưa có địa điểm nào</div>
    }
</div>
