@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Locations.DeleteModel
@{
    ViewData["Title"] = "Xóa địa điểm";
    ViewData["ActivePage"] = "Locations";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-trash-can"></i> Xóa POI</p>
        <h1 class="hero-title">Xóa địa điểm</h1>
        <p class="hero-subtitle">Xác nhận thao tác xóa địa điểm và các liên kết dữ liệu liên quan.</p>
    </div>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card card-v2">
    <div class="p-4" style="max-width:600px;">
        <div class="alert alert-danger alert-admin">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Bạn có chắc muốn xóa địa điểm <strong>"@Model.Location.Name"</strong>?
            <br/><small>Tất cả audio guide liên quan cũng sẽ bị xóa.</small>
        </div>
        <form method="post">
            <input type="hidden" asp-for="Location.Id" />
            <button type="submit" class="btn-admin btn-admin-danger"><i class="fas fa-trash"></i> Xác nhận xóa</button>
            <a asp-page="Index" class="btn-admin btn-admin-outline ms-2">Hủy</a>
        </form>
    </div>
</div>
