@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Locations.EditModel
@{
    ViewData["Title"] = "Sửa địa điểm";
    ViewData["ActivePage"] = "Locations";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-pen"></i> Cập nhật POI</p>
        <h1 class="hero-title">Sửa địa điểm</h1>
        <p class="hero-subtitle">Cập nhật thông tin chi tiết địa điểm để đồng bộ với nội dung audio.</p>
    </div>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card card-v2">
    <div class="p-4">
        <form method="post" class="admin-form" style="max-width:700px;">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Location.Id" class="form-label">Mã địa điểm</label>
                    <input asp-for="Location.Id" class="form-control" readonly />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location.CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="Location.CategoryId" asp-items="Model.CategoryList" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Location.Name" class="form-label">Tên địa điểm</label>
                <input asp-for="Location.Name" class="form-control" />
                <span asp-validation-for="Location.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Location.Description" class="form-label">Mô tả</label>
                <textarea asp-for="Location.Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Location.Address" class="form-label">Địa chỉ</label>
                <input asp-for="Location.Address" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Latitude" class="form-label">Vĩ độ (Latitude)</label>
                    <input asp-for="Location.Latitude" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Longitude" class="form-label">Kinh độ (Longitude)</label>
                    <input asp-for="Location.Longitude" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Location.Duration" class="form-label">Thời lượng (phút)</label>
                    <input asp-for="Location.Duration" class="form-control" type="number" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Location.ImageUrl" class="form-label">URL hình ảnh</label>
                <input asp-for="Location.ImageUrl" class="form-control" />
            </div>
            <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-save"></i> Cập nhật</button>
        </form>
    </div>
</div>
