@page
@model VinhKhanhAudioGuide.Web.Pages.Locations.MapViewModel
@{
    ViewData["Title"] = "Bản đồ POI";
    ViewData["ActivePage"] = "Map";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        #map { height: 600px; width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .poi-popup img { width: 100%; height: 120px; object-fit: cover; border-radius: 4px; margin-bottom: 8px; }
        .poi-popup h5 { margin: 0 0 5px 0; font-size: 16px; font-weight: 600; }
        .poi-popup p { margin: 0; font-size: 13px; color: #666; }
        .poi-popup .badge { margin-top: 5px; }
    </style>
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-map"></i> Xem Bản Đồ</p>
        <h1 class="hero-title">Bản Đồ Địa Điểm</h1>
        <p class="hero-subtitle">Trực quan hóa vị trí của tất cả POI trên bản đồ.</p>
    </div>
    <div>
        <a asp-page="Index" class="btn-admin btn-admin-outline me-2"><i class="fas fa-list"></i> Xem danh sách</a>
        <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm địa điểm</a>
    </div>
</div>

<div class="admin-card card-v2 p-3">
    <div id="map"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Khởi tạo bản đồ với tâm là TP.HCM
        var map = L.map('map').setView([10.7600, 106.7040], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Nạp dữ liệu POI từ Model
        var locations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Locations.Select(l => new {
            id = l.Id,
            name = l.Name,
            lat = l.Latitude,
            lng = l.Longitude,
            address = l.Address,
            image = l.ImageUrl,
            cat = l.Category != null ? l.Category.Name : "Khác",
            audioCount = l.AudioGuides.Count
        })));

        var bounds = [];
        
        locations.forEach(function(loc) {
            if (loc.lat && loc.lng) {
                var popupContent = `
                    <div class="poi-popup">
                        <img src="${loc.image}" alt="${loc.name}" onerror="this.src='/images/placeholder.jpg'" />
                        <h5>${loc.name}</h5>
                        <p><i class="fas fa-map-marker-alt text-danger me-1"></i> ${loc.address}</p>
                        <span class="badge bg-primary mt-2">${loc.cat}</span>
                        <span class="badge bg-secondary mt-2 ms-1"><i class="fas fa-headphones me-1"></i> ${loc.audioCount} audio</span>
                        <div class="mt-2 text-end">
                            <a href="/Locations/Edit/${loc.id}" class="btn btn-sm btn-outline-primary" style="font-size: 12px; padding: 2px 8px;">Cập nhật</a>
                        </div>
                    </div>`;

                L.marker([loc.lat, loc.lng])
                    .addTo(map)
                    .bindPopup(popupContent);
                    
                bounds.push([loc.lat, loc.lng]);
            }
        });

        // Tự động zoom để thấy hết tất cả markers
        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [50, 50] });
        }
    });
</script>