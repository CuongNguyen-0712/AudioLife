<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <i class="fas fa-headphones"></i>
                <span>Audio Guide</span>
            </div>
            <nav class="sidebar-nav">
                <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")" asp-page="/Index">
                    <i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
                </a>
                <div class="sidebar-heading">Quản lý nội dung</div>
                <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Categories" ? "active" : "")" asp-page="/Categories/Index">
                    <i class="fas fa-folder"></i> <span>Danh mục</span>
                </a>
                <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Locations" ? "active" : "")" asp-page="/Locations/Index">
                    <i class="fas fa-map-marker-alt"></i> <span>Địa điểm</span>
                </a>
                <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Tours" ? "active" : "")" asp-page="/Tours/Index">
                    <i class="fas fa-route"></i> <span>Tours</span>
                </a>
                <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AudioGuides" ? "active" : "")" asp-page="/AudioGuides/Index">
                    <i class="fas fa-headphones-alt"></i> <span>Audio Guides</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <header class="admin-topbar">
                <button class="btn btn-link sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-right">
                    <span class="text-muted me-3"><i class="fas fa-user-shield me-1"></i> Admin</span>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.querySelector('.admin-wrapper').classList.toggle('sidebar-collapsed');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>