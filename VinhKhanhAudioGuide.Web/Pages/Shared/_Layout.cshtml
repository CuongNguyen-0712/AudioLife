<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Audio Guide Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @{
        var isSystemAdmin = User.IsInRole("SystemAdmin");
        var isPoiAdmin = User.IsInRole("PoiAdmin");
    }
    <div class="admin-wrapper">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-brand-wrap">
                <div class="sidebar-brand-row">
                    <div class="sidebar-brand">
                        <i class="fas fa-headphones"></i>
                        <span>AudioAdmin</span>
                    </div>
                    <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Đóng thanh bên">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="sidebar-subtitle">@(isPoiAdmin ? "POI Content Workspace" : "Vĩnh Khánh Food Audio")</div>
            </div>
            <nav class="sidebar-nav">
                @if (isPoiAdmin)
                {
                    <div class="sidebar-heading">Không gian POI</div>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "ShopDashboard" ? "active" : "")" asp-page="/Shop/Index">
                        <i class="fas fa-store"></i> <span>Bảng điều khiển POI</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "ShopAudios" ? "active" : "")" asp-page="/Shop/AudioGuides/Index">
                        <i class="fas fa-headphones-alt"></i> <span>Quản lý audio</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "ShopLocations" ? "active" : "")" asp-page="/Shop/Locations/Index">
                        <i class="fas fa-map-location-dot"></i> <span>Quản lý địa điểm</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "ShopLocationsCreate" ? "active" : "")" asp-page="/Shop/Locations/Create">
                        <i class="fas fa-location-plus"></i> <span>Tạo POI mới</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "ShopRequests" ? "active" : "")" asp-page="/Shop/ChangeRequests">
                        <i class="fas fa-inbox"></i> <span>Theo dõi yêu cầu duyệt</span>
                    </a>
                }
                else
                {
                    <div class="sidebar-heading">Điều hành</div>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")" asp-page="/Admin/Index">
                        <i class="fas fa-tachometer-alt"></i> <span>Bảng điều khiển</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminUsers" ? "active" : "")" asp-page="/Admin/Users">
                        <i class="fas fa-users"></i> <span>Tài khoản POI</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminRequests" ? "active" : "")" asp-page="/Admin/ChangeRequests">
                        <i class="fas fa-inbox"></i> <span>Yêu cầu từ POI</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminReviews" ? "active" : "")" asp-page="/Admin/Reviews">
                        <i class="fas fa-star"></i> <span>Đánh giá & Bình luận</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminReports" ? "active" : "")" asp-page="/Admin/Reports">
                        <i class="fas fa-chart-line"></i> <span>Báo cáo trực quan</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminUsageHistory" ? "active" : "")" asp-page="/Admin/UsageHistory">
                        <i class="fas fa-clock-rotate-left"></i> <span>Lịch sử sử dụng</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminSettings" ? "active" : "")" asp-page="/Admin/Settings">
                        <i class="fas fa-sliders"></i> <span>Thiết lập hệ thống</span>
                    </a>
                    <div class="sidebar-heading">Nội dung</div>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Categories" ? "active" : "")" asp-page="/Categories/Index">
                        <i class="fas fa-folder"></i> <span>Danh mục</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Locations" ? "active" : "")" asp-page="/Locations/Index">
                        <i class="fas fa-map-marker-alt"></i> <span>Địa điểm</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Map" ? "active" : "")" asp-page="/Locations/MapView">
                        <i class="fas fa-map"></i> <span>Bản đồ POI</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Tours" ? "active" : "")" asp-page="/Tours/Index">
                        <i class="fas fa-route"></i> <span>Tour ẩm thực</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminAudioTranslations" ? "active" : "")" asp-page="/Admin/Translations">
                        <i class="fas fa-headphones-alt"></i> <span>Audio & bản dịch</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "MediaExplorer" ? "active" : "")" asp-page="/Admin/MediaExplorer">
                        <i class="fas fa-cloud"></i> <span>Quản lý Media Cloud</span>
                    </a>
                    <div class="sidebar-heading">Người Dùng & Thanh Toán</div>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminEndUsers" ? "active" : "")" asp-page="/Admin/Users/Index">
                        <i class="fas fa-user-circle"></i> <span>Người dùng app</span>
                    </a>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminPaymentPackages" ? "active" : "")" asp-page="/Admin/PaymentPackages/Index">
                        <i class="fas fa-credit-card"></i> <span>Gói thanh toán</span>
                    </a>
                    <div class="sidebar-heading">Kiểm thử hệ thống</div>
                    <a class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AdminSimulation" ? "active" : "")" asp-page="/Admin/Simulation">
                        <i class="fas fa-flask"></i> <span>Giả lập Tải POI</span>
                    </a>
                }
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="btn btn-link sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-right d-flex align-items-center gap-2">
                    @if (isPoiAdmin)
                    {
                        <span class="role-pill role-pill-shop"><i class="fas fa-store"></i>Admin POI</span>
                    }
                    else
                    {
                        <span class="role-pill role-pill-admin"><i class="fas fa-crown"></i>Admin Hệ Thống</span>
                    }
                    <span class="text-muted"><i class="fas fa-user-shield me-1"></i> @User.Identity?.Name</span>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
                    </form>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var wrapper = document.querySelector('.admin-wrapper');
            var toggleBtn = document.getElementById('sidebarToggle');
            var closeBtn = document.getElementById('sidebarCloseBtn');
            var backdrop = document.getElementById('sidebarBackdrop');

            if (!wrapper) {
                return;
            }

            function isMobileViewport() {
                return window.matchMedia('(max-width: 991px)').matches;
            }

            function openSidebar() {
                wrapper.classList.add('sidebar-collapsed');
            }

            function closeSidebar() {
                wrapper.classList.remove('sidebar-collapsed');
            }

            toggleBtn?.addEventListener('click', function () {
                wrapper.classList.toggle('sidebar-collapsed');
            });

            closeBtn?.addEventListener('click', function () {
                if (isMobileViewport()) {
                    closeSidebar();
                    return;
                }

                openSidebar();
            });

            backdrop?.addEventListener('click', function () {
                closeSidebar();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && isMobileViewport()) {
                    closeSidebar();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>