@page
@model VinhKhanhAudioGuide.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-danger">
            <h4><i class="fas fa-ban me-2"></i>Không có quyền truy cập</h4>
            <p class="mb-0">Tài khoản hiện tại không có quyền vào khu vực này.</p>
        </div>
        <a asp-page="/Index" class="btn-admin btn-admin-outline">Về cổng hệ thống</a>
    </div>
</div>
