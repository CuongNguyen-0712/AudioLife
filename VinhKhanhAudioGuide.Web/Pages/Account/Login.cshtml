@page
@model VinhKhanhAudioGuide.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Vĩnh Khánh Audio Guide</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-left">
            <span class="login-logo"><i class="fas fa-headphones"></i></span>
            <h1>Vĩnh Khánh Food Audio</h1>
            <p>Nền tảng quản lý nội dung âm thanh ẩm thực cho hệ thống AudioAdmin.</p>
        </div>
        <div class="login-right">
            <h2>Đăng nhập</h2>
            <p>Vui lòng nhập thông tin để truy cập hệ thống quản lý.</p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="form-group">
                    <label class="form-label">Email hoặc tên đăng nhập</label>
                    <input asp-for="Input.Username" class="form-control" placeholder="Nhập tên đăng nhập" />
                    <span asp-validation-for="Input.Username" class="text-danger validation-text"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Mật khẩu</label>
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Input.Password" class="text-danger validation-text"></span>
                </div>

                <button type="submit" class="btn-login">Đăng nhập</button>

                <div class="login-divider">
                    <span>hoặc</span>
                </div>

                <a href="/Account/Register/SelectPlan" class="btn-register-poi" id="btn-register-poi">
                    <i class="fas fa-store"></i> Đăng ký tài khoản POI
                </a>
            </form>

            <div class="demo-section">
                <div class="demo-title">Thông tin thử nghiệm</div>
                <div class="demo-item"><strong>Admin Hệ Thống:</strong> admin.system / Admin@123</div>
                <div class="demo-item"><strong>Admin POI:</strong> admin.poi.01 / Poi@123</div>
                <div class="demo-item"><strong>Admin POI:</strong> admin.poi.02 / Poi@123</div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
