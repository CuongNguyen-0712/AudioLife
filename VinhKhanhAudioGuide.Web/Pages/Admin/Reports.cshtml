@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Báo cáo hệ thống";
    ViewData["ActivePage"] = "AdminReports";

    var totalByCategory = Model.CategoryBreakdown.Sum(x => x.AudioCount);
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-chart-line"></i> Báo cáo tổng hợp</p>
        <h1 class="hero-title">Báo cáo hệ thống</h1>
        <p class="hero-subtitle">Theo dõi hiệu suất audio và phân bổ tài nguyên theo khu vực ẩm thực.</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-chart-pie"></i> Snapshot thời gian thực</span>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="stat-card stat-card-v2"><div class="stat-icon bg-info"><i class="fas fa-headphones-alt"></i></div><div><div class="stat-value">@Model.TotalAudios</div><div class="stat-label">Tổng audio</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card stat-card-v2"><div class="stat-icon bg-primary"><i class="fas fa-map-marker-alt"></i></div><div><div class="stat-value">@Model.TotalLocations</div><div class="stat-label">Địa điểm ẩm thực</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card stat-card-v2"><div class="stat-icon bg-warning"><i class="fas fa-route"></i></div><div><div class="stat-value">@Model.TotalTours</div><div class="stat-label">Tour ẩm thực</div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat-card stat-card-v2"><div class="stat-icon bg-success"><i class="fas fa-calculator"></i></div><div><div class="stat-value">@Model.AvgAudioPerLocation</div><div class="stat-label">Audio / địa điểm</div></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-chart-pie me-2"></i>Tỉ trọng audio theo danh mục</span></div>
            <div class="p-3 p-md-4">
                <div class="chart-wrap-sm"><canvas id="categoryPieChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-chart-column me-2"></i>Top POI theo audio</span></div>
            <div class="p-3 p-md-4">
                <div class="chart-wrap-sm"><canvas id="locationBarChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-layer-group me-2"></i>Chi tiết theo danh mục</span></div>
            <div class="table-responsive">
                <table class="admin-table table-v2">
                    <thead><tr><th>Danh mục</th><th class="text-end">Số audio</th><th class="text-end">Tỉ lệ</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.CategoryBreakdown)
                    {
                        var rate = totalByCategory == 0 ? 0 : Math.Round((double)item.AudioCount / totalByCategory * 100, 1);
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-end">@item.AudioCount</td>
                            <td class="text-end"><span class="badge-soft">@rate%</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-ranking-star me-2"></i>Top POI theo audio</span></div>
            <div class="table-responsive">
                <table class="admin-table table-v2">
                    <thead><tr><th>Địa điểm</th><th>Danh mục</th><th class="text-end">Audio</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.TopLocationsByAudio)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Category</td>
                            <td class="text-end"><span class="badge-admin badge-count">@item.AudioCount</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.Name)));
        const categoryValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.AudioCount)));
        const locationLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopLocationsByAudio.Select(x => x.Name)));
        const locationValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopLocationsByAudio.Select(x => x.AudioCount)));

        const pieCtx = document.getElementById('categoryPieChart');
        if (pieCtx) {
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryValues,
                        backgroundColor: ['#f97316', '#fb923c', '#fdba74', '#f59e0b', '#38bdf8', '#34d399'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        const barCtx = document.getElementById('locationBarChart');
        if (barCtx) {
            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: locationLabels,
                    datasets: [{
                        label: 'Audio',
                        data: locationValues,
                        borderRadius: 8,
                        backgroundColor: '#0ea5e9'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }
    </script>
}
