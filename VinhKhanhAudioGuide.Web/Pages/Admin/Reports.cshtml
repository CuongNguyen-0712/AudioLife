@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Báo cáo hệ thống";
    ViewData["ActivePage"] = "AdminReports";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-chart-line"></i> Báo cáo tổng hợp</p>
        <h1 class="hero-title">Báo cáo hệ thống</h1>
        <p class="hero-subtitle">Tổng hợp hiệu suất nội dung audio và phân bổ tài nguyên theo khu vực ẩm thực.</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-chart-pie"></i> Ảnh chụp thời gian thực</span>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-v2"><div class="stat-icon bg-info"><i class="fas fa-headphones-alt"></i></div><div><div class="stat-value">@Model.TotalAudios</div><div class="stat-label">Tổng audio</div></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-v2"><div class="stat-icon bg-primary"><i class="fas fa-map-marker-alt"></i></div><div><div class="stat-value">@Model.TotalLocations</div><div class="stat-label">Địa điểm ẩm thực</div></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-v2"><div class="stat-icon bg-warning"><i class="fas fa-route"></i></div><div><div class="stat-value">@Model.TotalTours</div><div class="stat-label">Tour ẩm thực</div></div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-v2"><div class="stat-icon bg-success"><i class="fas fa-calculator"></i></div><div><div class="stat-value">@Model.AvgAudioPerLocation</div><div class="stat-label">Audio / địa điểm</div></div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-layer-group me-2"></i>Phân bổ theo danh mục</span></div>
            <div class="table-responsive">
                <table class="admin-table table-v2">
                    <thead><tr><th>Danh mục</th><th>Số audio</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.CategoryBreakdown)
                    {
                        <tr><td>@item.Name</td><td><span class="badge text-bg-secondary">@item.AudioCount</span></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="admin-card h-100 card-v2">
            <div class="card-header"><span><i class="fas fa-ranking-star me-2"></i>Top địa điểm theo audio</span></div>
            <div class="table-responsive">
                <table class="admin-table table-v2">
                    <thead><tr><th>Địa điểm</th><th>Danh mục</th><th>Audio</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.TopLocationsByAudio)
                    {
                        <tr><td>@item.Name</td><td>@item.Category</td><td><span class="badge text-bg-primary">@item.AudioCount</span></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
