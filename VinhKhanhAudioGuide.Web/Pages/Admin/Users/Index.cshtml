@page "/Admin/EndUsers"
@model VinhKhanhAudioGuide.Web.Pages.Admin.EndUsersModel
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    ViewData["ActivePage"] = "AdminEndUsers";
}

<div class="container-fluid py-4">
    <div class="admin-page-hero mb-4">
        <div class="admin-page-hero-copy">
            <p class="hero-kicker"><i class="fa-solid fa-users-gear"></i> Admin hệ thống</p>
            <h1 class="admin-page-hero-title">Quản Lý Người Dùng</h1>
            <p class="admin-page-hero-subtitle">Theo dõi trạng thái, gói active, phiên đăng nhập và lịch sử nghe trong một giao diện gọn hơn, rõ hơn.</p>
            <div class="admin-page-hero-badges">
                <span class="hero-badge"><i class="fa-solid fa-circle-check"></i> <span id="hero-online-kpi">@Model.ActiveUserCount</span> online</span>
                <span class="hero-badge"><i class="fa-solid fa-power-off"></i> <span id="hero-offline-kpi">@(Math.Max(Model.TotalUserCount - Model.ActiveUserCount, 0))</span> offline</span>
                <span class="hero-badge"><i class="fa-solid fa-ban"></i> @Model.BlockedUserCount blocked</span>
                <span class="hero-badge"><i class="fa-solid fa-ticket"></i> @Model.UsersWithActiveSubscriptionCount có gói active</span>
            </div>
        </div>

        <div class="admin-page-hero-actions">
            <div class="admin-page-hero-kpis">
                <div class="admin-page-hero-kpi">
                    <span>Tổng</span>
                    <strong id="hero-total-kpi">@Model.TotalUserCount</strong>
                </div>
                <div class="admin-page-hero-kpi">
                    <span>Phiên active</span>
                    <strong>@Model.ActiveSessionCount</strong>
                </div>
                <div class="admin-page-hero-kpi">
                    <span>Lọc hiện tại</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Tất cả" : Model.SearchTerm)</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-primary"><i class="fa-solid fa-users"></i></div>
                <div><div class="stat-value" id="card-total-kpi">@Model.TotalUserCount</div><div class="stat-label">Người dùng</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-success"><i class="fa-solid fa-signal"></i></div>
                <div><div class="stat-value" id="card-online-kpi">@Model.ActiveUserCount</div><div class="stat-label">Đang hoạt động</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-danger"><i class="fa-solid fa-ban"></i></div>
                <div><div class="stat-value">@Model.BlockedUserCount</div><div class="stat-label">Đang chặn</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-info"><i class="fa-solid fa-ticket"></i></div>
                <div><div class="stat-value">@Model.UsersWithActiveSubscriptionCount</div><div class="stat-label">Có gói active</div></div>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tìm theo Device ID hoặc mã QR..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                        <option value="Blocked" selected="@(Model.StatusFilter == "Blocked")">Blocked</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-search"></i> Tìm kiếm
                    </button>
                </div>
                <div class="col-md-3 text-end">
                    <a href="@Url.Page("Index")" class="btn btn-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Users.Any())
    {
        <div class="admin-column-list">
            @foreach (var user in Model.Users)
            {
                var activeSubscription = user.Subscriptions?.FirstOrDefault(s => s.Status == "Active");
                var packageName = activeSubscription?.Package?.Name ?? "Không có gói";
                var activeSessions = user.AppSessions.Count(session => session.IsActive && session.RevokedAtUtc == null && session.ExpiresAtUtc > DateTime.UtcNow);
                var listeningCount = user.ListeningHistories.Count;
                var templateId = $"user-overlay-{user.Id:N}";

                var isOnline = user.LastSeenAtUtc >= DateTime.UtcNow.AddSeconds(-15);
                var deviceIdDisplay = user.AppSessions.FirstOrDefault()?.DeviceId ?? user.QrCodeValue;

                <article class="admin-column-card">
                    <header class="admin-column-card-head">
                        <div>
                            <h3 class="admin-column-card-title text-truncate" style="max-width: 200px;" title="@deviceIdDisplay">@deviceIdDisplay</h3>
                            <div class="admin-column-card-subtitle">Device ID / QR Token</div>
                        </div>
                        @if (isOnline)
                        {
                            <span id="status-badge-@user.Id" class="badge bg-success"><i class="fa-solid fa-wifi"></i> Online</span>
                        }
                        else if (user.Status == "Blocked")
                        {
                            <span id="status-badge-@user.Id" class="badge bg-danger">Blocked</span>
                        }
                        else
                        {
                            <span id="status-badge-@user.Id" class="badge bg-secondary">Offline</span>
                        }
                    </header>

                    <div class="admin-column-meta-grid">
                        <div><span>Trạng thái</span><strong>@user.Status</strong></div>
                        <div><span>Gói active</span><strong>@packageName</strong></div>
                        <div><span>Phiên active</span><strong>@activeSessions</strong></div>
                        <div><span>Lượt nghe</span><strong>@listeningCount</strong></div>
                        <div>
                            <span>Hoạt động hiện tại</span>
                            <strong id="current-activity-@user.Id">@(string.IsNullOrWhiteSpace(user.CurrentActivity) ? "---" : user.CurrentActivity)</strong>
                        </div>
                        <div>
                            <span>Cập nhật lúc</span>
                            <strong id="current-activity-at-@user.Id">@(user.CurrentActivityAtUtc?.ToString("dd/MM/yyyy HH:mm:ss") ?? "---")</strong>
                        </div>
                        <div>
                            <span>Lần cập nhật cuối</span>
                            <strong id="last-seen-@user.Id">@user.LastSeenAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                        </div>
                        <div><span>Tạo lúc</span><strong>@user.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    </div>

                    <div class="admin-column-actions">
                        <button type="button"
                                class="btn btn-sm btn-outline-dark js-open-entity-overlay"
                                data-template-id="@templateId"
                                data-overlay-title="Chi tiết người dùng">
                            <i class="fa fa-eye"></i> Xem
                        </button>

                        @if (user.Status == "Active")
                        {
                            <form method="post" asp-page-handler="Block" class="d-inline">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Chặn người dùng này?')">
                                    <i class="fa fa-ban"></i> Chặn
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Unblock" class="d-inline">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fa fa-check"></i> Bỏ chặn
                                </button>
                            </form>
                        }

                        <form method="post" asp-page-handler="Delete" class="d-inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xóa người dùng này? Tất cả dữ liệu liên quan sẽ bị xóa.')">
                                <i class="fa fa-trash"></i> Xóa
                            </button>
                        </form>
                    </div>
                </article>

                <template id="@templateId">
                    <div class="entity-overlay-body-grid">
                        <section class="entity-overlay-panel">
                            <h4>Thông tin cơ bản</h4>
                            <div class="d-flex align-items-start gap-4">
                                <dl class="mb-0 flex-grow-1">
                                    <dt>Mã người dùng</dt><dd>@user.Id</dd>
                                    <dt>Mã thiết bị / QR</dt><dd>@user.QrCodeValue</dd>
                                    <dt>Trạng thái</dt><dd>@user.Status</dd>
                                    <dt>Tạo lúc</dt><dd>@user.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>
                                </dl>
                                <div class="text-center">
                                    <div id="qr-container-@user.Id" data-qr-value="@user.QrCodeValue" class="bg-white p-2 border rounded shadow-sm"></div>
                                    <div class="small text-muted mt-1">Identity QR</div>
                                </div>
                            </div>
                            <dl class="mt-2">
                                <dt>Lần truy cập cuối</dt><dd>@user.LastSeenAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>
                                <dt>Hoạt động hiện tại</dt><dd>@(string.IsNullOrWhiteSpace(user.CurrentActivity) ? "---" : user.CurrentActivity)</dd>
                                <dt>Hoạt động lúc</dt><dd>@(user.CurrentActivityAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? "---")</dd>
                            </dl>
                        </section>

                        <section class="entity-overlay-panel">
                            <h4>Đăng ký gói</h4>
                            @if (user.Subscriptions!.Any())
                            {
                                <ul class="entity-overlay-list">
                                    @foreach (var sub in user.Subscriptions!.OrderByDescending(s => s.PurchasedAtUtc).Take(6))
                                    {
                                        <li>
                                            <strong>@(sub.Package?.Name ?? sub.PackageId)</strong>
                                            <span>@sub.Status • @sub.PurchasedAtUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted small">Chưa có đăng ký gói.</div>
                            }

                            <h4 class="mt-3">Phiên đăng nhập</h4>
                            @if (user.AppSessions!.Any())
                            {
                                <ul class="entity-overlay-list">
                                    @foreach (var session in user.AppSessions!.OrderByDescending(s => s.IssuedAtUtc).Take(6))
                                    {
                                        <li>
                                            <strong>@session.DeviceId</strong>
                                            <span>@(session.IsActive ? "Active" : "Inactive") • Hết hạn @session.ExpiresAtUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted small">Chưa có phiên nào.</div>
                            }
                        </section>

                        <section class="entity-overlay-panel entity-overlay-panel-full">
                            <h4>Lịch sử nghe gần đây</h4>
                            @if (user.ListeningHistories!.Any())
                            {
                                <ul class="entity-overlay-list">
                                    @foreach (var history in user.ListeningHistories!.OrderByDescending(h => h.LastListenedAtUtc).Take(8))
                                    {
                                        <li>
                                            <strong>@history.AudioTitle</strong>
                                            <span>@history.LastListenedAtUtc.ToString("dd/MM/yyyy HH:mm") • @history.Progress.ToString("P0")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted small">Chưa có lịch sử nghe.</div>
                            }
                        </section>
                    </div>
                </template>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center text-muted py-4">
                <i class="fa fa-inbox fa-2x mb-2 d-block"></i>
                Không tìm thấy người dùng
            </div>
        </div>
    }

    <div class="text-muted mt-3 small">
        Tổng: <strong>@Model.Users.Count</strong> người dùng
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (() => {
            const overlay = document.getElementById('entityOverlay');
            const titleNode = document.getElementById('entityOverlayTitle');
            const contentNode = document.getElementById('entityOverlayContent');
            const closeButtons = overlay ? overlay.querySelectorAll('[data-close-overlay]') : [];

            if (!overlay || !titleNode || !contentNode) return;

            const closeOverlay = () => {
                overlay.classList.add('d-none');
                document.body.classList.remove('translation-preview-open');
                contentNode.innerHTML = '';
            };

            closeButtons.forEach(btn => btn.addEventListener('click', closeOverlay));

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && !overlay.classList.contains('d-none')) {
                    closeOverlay();
                }
            });

            document.querySelectorAll('.js-open-entity-overlay').forEach(button => {
                button.addEventListener('click', () => {
                    const templateId = button.getAttribute('data-template-id');
                    const title = button.getAttribute('data-overlay-title') || 'Chi tiết';
                    const template = templateId ? document.getElementById(templateId) : null;
                    if (!template) return;

                    titleNode.textContent = title;
                    contentNode.innerHTML = template.innerHTML;
                    
                    const qrContainer = contentNode.querySelector('[id^="qr-container-"]');
                    if (qrContainer) {
                        const qrValue = qrContainer.getAttribute('data-qr-value');
                        qrContainer.innerHTML = '';
                        new QRCode(qrContainer, {
                            text: qrValue,
                            width: 128,
                            height: 128,
                            colorDark : "#000000",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.M
                        });
                    }

                    overlay.classList.remove('d-none');
                    document.body.classList.add('translation-preview-open');
                });
            });

            const formatUtcToLocal = (utcValue) => {
                if (!utcValue) return '---';
                const date = new Date(utcValue);
                if (Number.isNaN(date.getTime())) return '---';
                return date.toLocaleString('vi-VN', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            };

            // Live Status Polling
            setInterval(async () => {
                try {
                    const params = new URLSearchParams(window.location.search);
                    params.set('handler', 'Statuses');
                    const res = await fetch('?' + params.toString(), { cache: "no-store" });
                    if (!res.ok) return;
                    const data = await res.json();
                    
                    const heroOnlineKpi = document.getElementById('hero-online-kpi');
                    if (heroOnlineKpi) heroOnlineKpi.textContent = data.onlineCount;

                    const heroOfflineKpi = document.getElementById('hero-offline-kpi');
                    if (heroOfflineKpi) heroOfflineKpi.textContent = data.offlineCount;

                    const heroTotalKpi = document.getElementById('hero-total-kpi');
                    if (heroTotalKpi) heroTotalKpi.textContent = data.totalCount;
                    
                    const cardOnlineKpi = document.getElementById('card-online-kpi');
                    if (cardOnlineKpi) cardOnlineKpi.textContent = data.onlineCount;

                    const cardTotalKpi = document.getElementById('card-total-kpi');
                    if (cardTotalKpi) cardTotalKpi.textContent = data.totalCount;

                    const currentIds = new Set(
                        Array.from(document.querySelectorAll('[id^="status-badge-"]'))
                            .map(node => node.id.replace('status-badge-', ''))
                    );
                    const incomingIds = new Set((data.users || []).map(u => String(u.id)));

                    const hasMembershipChanged = incomingIds.size !== currentIds.size
                        || Array.from(incomingIds).some(id => !currentIds.has(id));

                    if (hasMembershipChanged) {
                        window.location.reload();
                        return;
                    }
                    
                    data.users.forEach(u => {
                        const badge = document.getElementById('status-badge-' + u.id);
                        const activityNode = document.getElementById('current-activity-' + u.id);
                        const activityAtNode = document.getElementById('current-activity-at-' + u.id);
                        const lastSeenNode = document.getElementById('last-seen-' + u.id);
                        if (!badge) return;
                        
                        if (u.isOnline) {
                            badge.className = 'badge bg-success';
                            badge.innerHTML = '<i class="fa-solid fa-wifi"></i> Online';
                        } else if (u.status === 'Blocked') {
                            badge.className = 'badge bg-danger';
                            badge.innerHTML = 'Blocked';
                        } else {
                            badge.className = 'badge bg-secondary';
                            badge.innerHTML = 'Offline';
                        }

                        if (activityNode) {
                            activityNode.textContent = u.currentActivity && u.currentActivity.trim().length > 0
                                ? u.currentActivity
                                : '---';
                        }

                        if (activityAtNode) {
                            activityAtNode.textContent = formatUtcToLocal(u.currentActivityAtUtc);
                        }

                        if (lastSeenNode) {
                            lastSeenNode.textContent = formatUtcToLocal(u.lastSeenAtUtc);
                        }
                    });
                } catch (e) {
                    // Ignore transient network errors
                }
            }, 5000);
        })();
    </script>
}

<div class="entity-overlay d-none" id="entityOverlay" aria-hidden="true">
    <div class="entity-overlay-backdrop" data-close-overlay="true"></div>
    <div class="entity-overlay-dialog" role="dialog" aria-modal="true" aria-labelledby="entityOverlayTitle">
        <div class="entity-overlay-header">
            <h3 id="entityOverlayTitle" class="mb-0">Chi tiết</h3>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-close-overlay="true">
                <i class="fa fa-xmark"></i>
            </button>
        </div>
        <div class="entity-overlay-content" id="entityOverlayContent"></div>
    </div>
</div>
