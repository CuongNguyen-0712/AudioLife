@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Bảng điều khiển Admin Hệ Thống";
    ViewData["ActivePage"] = "Dashboard";

    var assignmentRate = Model.LocationCount == 0
        ? 0
        : Math.Round(((double)(Model.LocationCount - Model.UnassignedLocationCount) / Model.LocationCount) * 100, 1);
}

<div class="dashboard-admin-v2">
    <div class="dashboard-hero mb-4">
        <div>
            <p class="hero-kicker"><i class="fa-solid fa-sparkles"></i> Điều hành hệ thống</p>
            <h1 class="hero-title">Dashboard Admin</h1>
            <p class="hero-subtitle">Tổng quan nội dung Audio Vĩnh Khánh theo thời gian thực.</p>
        </div>
        <div class="hero-actions">
            <span class="hero-badge"><i class="fa-solid fa-shield-halved"></i> Admin Hệ Thống</span>
            <a class="btn btn-outline-light btn-sm" asp-page="/Admin/Users/Index">
                <i class="fa-solid fa-users"></i> Người dùng app
            </a>
            <a class="btn btn-outline-light btn-sm" asp-page="/Admin/PaymentPackages/Index">
                <i class="fa-solid fa-credit-card"></i> Thanh toán
            </a>
            <button type="button" class="hero-close-btn" id="closeDashboardHero"><i class="fas fa-xmark"></i> Đóng</button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-primary"><i class="fa-solid fa-location-dot"></i></div>
                <div><div class="stat-value">@Model.LocationCount</div><div class="stat-label">POI</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-success"><i class="fa-solid fa-layer-group"></i></div>
                <div><div class="stat-value">@Model.CategoryCount</div><div class="stat-label">Danh mục</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-warning"><i class="fa-solid fa-route"></i></div>
                <div><div class="stat-value">@Model.TourCount</div><div class="stat-label">Tour</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-info"><i class="fa-solid fa-wave-square"></i></div>
                <div><div class="stat-value">@Model.AudioGuideCount</div><div class="stat-label">Audio</div></div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4 compact-row">
        <div class="col-12 col-xxl-7">
            <div class="admin-card h-100 card-v2 compact-card">
                <div class="card-header"><span><i class="fa-solid fa-chart-column me-2"></i>Phân bổ audio theo danh mục</span></div>
                <div class="p-3 p-md-4">
                    <div class="chart-wrap"><canvas id="categoryChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xxl-5">
            <div class="admin-card h-100 card-v2 compact-card">
                <div class="card-header"><span><i class="fa-solid fa-user-shield me-2"></i>Tổng quan vận hành</span></div>
                <div class="p-3 p-md-4">
                    <div class="summary-grid mb-3">
                        <div class="summary-item"><span>Admin POI</span><strong>@Model.PoiAdminCount</strong></div>
                        <div class="summary-item"><span>POI có audio</span><strong>@Model.LocationsWithAudioCount / @Model.LocationCount</strong></div>
                        <div class="summary-item"><span>Yêu cầu chờ duyệt</span><strong>@Model.PendingRequestCount</strong></div>
                        <div class="summary-item"><span>Yêu cầu đang review</span><strong>@Model.InReviewRequestCount</strong></div>
                        <div class="summary-item"><span>Gói Đang Active</span><strong>@Model.PackageStats.ActivePackages</strong></div>
                        <div class="summary-item"><span>Doanh thu POI</span><strong>@Model.PackageStats.TotalRevenue.ToString("N0")</strong></div>
                    </div>

                    <div class="metric-tile mb-3">
                        <div class="k">Tỷ lệ phân công POI</div>
                        <div class="v">@assignmentRate%</div>
                        <div class="progress mt-2" role="progressbar" aria-label="assignment">
                            <div class="progress-bar bg-success" style="width:@assignmentRate%"></div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <a asp-page="/Admin/PaymentPackages/Index" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-credit-card me-1"></i> Quản lý gói & doanh thu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card card-v2 compact-card mb-4">
        <div class="card-header"><span><i class="fa-solid fa-ranking-star me-2"></i>Top POI theo sản lượng audio</span></div>
        <div class="table-responsive">
            <table class="admin-table table-v2 mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Địa điểm</th>
                        <th>Mã</th>
                        <th>Danh mục</th>
                        <th class="text-end">Audio</th>
                        <th class="text-end">Thời lượng</th>
                        <th class="text-end">Tỉ trọng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopLocationsByAudio.Any())
                    {
                        var rank = 1;
                        foreach (var location in Model.TopLocationsByAudio)
                        {
                            var locationShare = Model.AudioGuideCount == 0
                                ? 0
                                : Math.Round(((double)location.AudioCount / Model.AudioGuideCount) * 100, 1);
                            <tr>
                                <td><span class="index-pill">@rank</span></td>
                                <td class="fw-semibold">@location.LocationName</td>
                                <td><span class="text-muted small">@location.LocationId</span></td>
                                <td>@location.CategoryName</td>
                                <td class="text-end">@location.AudioCount</td>
                                <td class="text-end">@location.Duration phút</td>
                                <td class="text-end"><span class="badge-soft">@locationShare%</span></td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu để thống kê.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card card-v2 compact-card mb-4">
        <div class="card-header"><span><i class="fa-solid fa-users-gear me-2"></i>Danh sách Admin POI</span></div>
        <div class="table-responsive">
            <table class="admin-table table-v2 mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Admin</th>
                        <th>Username</th>
                        <th>POI quản lý</th>
                        <th class="text-end">Số điểm</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PoiAdminSummaries.Any())
                    {
                        var adminIndex = 1;
                        foreach (var admin in Model.PoiAdminSummaries)
                        {
                            <tr>
                                <td><span class="index-pill">@adminIndex</span></td>
                                <td class="fw-semibold">@admin.DisplayName</td>
                                <td class="text-muted">@admin.Username</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var locationName in admin.LocationNames)
                                        {
                                            <span class="location-chip">@locationName</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-semibold">@admin.LocationNames.Count</td>
                            </tr>
                            adminIndex++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Chưa có Admin POI được cấu hình.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="admin-card card-v2 compact-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-inbox me-2"></i>Yêu cầu review mới nhất từ POI</span>
            <a asp-page="/Admin/ChangeRequests" class="btn btn-sm btn-outline-secondary">Mở màn duyệt</a>
        </div>
        <div class="table-responsive">
            <table class="admin-table table-v2 mb-0">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Người gửi</th>
                        <th>POI</th>
                        <th>Tiêu đề</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú review</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentRequests.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu request review.</td></tr>
                    }
                    else
                    {
                        @foreach (var request in Model.RecentRequests)
                        {
                            <tr>
                                <td>@request.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@request.SubmittedByName</td>
                                <td>@request.LocationName</td>
                                <td>
                                    <a asp-page="/Admin/ChangeRequests" asp-route-selectedId="@request.Id" class="link-primary text-decoration-none fw-semibold">
                                        @request.Title
                                    </a>
                                </td>
                                <td><span class="badge @IndexModel.GetStatusBadgeClass(request.Status)">@request.Status</span></td>
                                <td>@(string.IsNullOrWhiteSpace(request.ReviewNote) ? "-" : request.ReviewNote)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategorySummaries.Select(x => x.CategoryName)));
        const categoryValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategorySummaries.Select(x => x.AudioCount)));

        const categoryCtx = document.getElementById('categoryChart');
        if (categoryCtx) {
            new Chart(categoryCtx, {
                type: 'bar',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        label: 'Số audio',
                        data: categoryValues,
                        borderRadius: 8,
                        backgroundColor: [
                            '#f97316', '#fb923c', '#fdba74', '#fed7aa', '#fbbf24', '#a3e635', '#38bdf8'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        }

        const closeHeroButton = document.getElementById('closeDashboardHero');
        const dashboardHero = document.querySelector('.dashboard-admin-v2 .dashboard-hero');

        if (closeHeroButton && dashboardHero) {
            closeHeroButton.addEventListener('click', function () {
                dashboardHero.classList.add('is-closed');
            });
        }
    </script>
}
