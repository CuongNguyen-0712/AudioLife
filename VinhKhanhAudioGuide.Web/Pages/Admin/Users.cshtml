@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActivePage"] = "AdminUsers";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-users"></i> Quản lý tài khoản</p>
        <h1 class="hero-title">Quản lý người dùng</h1>
        <p class="hero-subtitle">Quản trị tài khoản, vai trò và phạm vi quản lý theo địa điểm POI.</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-shield-halved"></i> Admin Hệ Thống</span>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-admin mb-4">@successMessage</div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-admin mb-4">@errorMessage</div>
}

<div class="admin-card card-v2 mb-4">
    <div class="card-header">
        <span><i class="fas fa-shield-halved me-2"></i>Vai trò hệ thống</span>
    </div>
    <div class="p-3 d-flex gap-2 flex-wrap">
        <span class="badge text-bg-danger">Admin Hệ Thống</span>
        <span class="badge text-bg-primary">Admin POI</span>
        <span class="badge text-bg-secondary">Trạng thái: Hoạt động</span>
    </div>
</div>

<div class="admin-card card-v2 mb-4">
    <div class="card-header">
        <span><i class="fas fa-user-plus me-2"></i>Thêm tài khoản POI mới</span>
    </div>
    <div class="p-3">
        <form method="post" asp-page-handler="CreatePoiAdmin" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label" for="newPoiUsername">Tài khoản</label>
                <input id="newPoiUsername" name="NewPoiUsername" class="form-control" placeholder="poi.admin.03" required maxlength="100" />
            </div>
            <div class="col-lg-4">
                <label class="form-label" for="newPoiDisplayName">Tên hiển thị</label>
                <input id="newPoiDisplayName" name="NewPoiDisplayName" class="form-control" placeholder="Admin POI - Khu mới" required maxlength="150" />
            </div>
            <div class="col-lg-3">
                <label class="form-label" for="newPoiPassword">Mật khẩu</label>
                <input id="newPoiPassword" name="NewPoiPassword" type="text" class="form-control" placeholder="Poi@123" required maxlength="200" />
            </div>
            <div class="col-lg-1 d-grid">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i></button>
            </div>
        </form>
        <div class="small text-muted mt-2">Tài khoản POI mới sẽ đăng nhập được ngay sau khi tạo.</div>
    </div>
</div>

<div class="admin-card card-v2 mb-4">
    <div class="card-header">
        <span><i class="fas fa-user-gear me-2"></i>Danh sách tài khoản</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table table-v2">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên hiển thị</th>
                    <th>Tài khoản</th>
                    <th>Vai trò</th>
                    <th>Địa điểm quản lý</th>
                    <th>Số POI</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.No</td>
                    <td>@user.DisplayName</td>
                    <td><code>@user.Username</code></td>
                    <td><span class="badge @user.RoleBadgeClass">@user.RoleLabel</span></td>
                    <td>
                        @if (user.ManagedLocations.Any())
                        {
                            foreach (var location in user.ManagedLocations)
                            {
                                <span class="location-chip me-1 mb-1">@location</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Toàn hệ thống</span>
                        }
                    </td>
                    <td class="fw-semibold">@user.ManagedLocations.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="admin-card card-v2 mb-4">
    <div class="card-header">
        <span><i class="fas fa-pen-to-square me-2"></i>Cập nhật phạm vi POI theo tài khoản</span>
    </div>
    <div class="p-3">
        <div class="row g-3">
            @foreach (var user in Model.Users.Where(item => item.Role == "PoiAdmin"))
            {
                <div class="col-12 col-xxl-6">
                    <form method="post" asp-page-handler="UpdateAssignments" class="border rounded-3 p-3">
                        <input type="hidden" name="Username" value="@user.Username" />
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-semibold">@user.DisplayName</div>
                                <div class="small text-muted">@user.Username</div>
                            </div>
                            <span class="badge text-bg-primary">@user.ManagedLocationIds.Count POI</span>
                        </div>

                        <label class="form-label">POI quản lý</label>
                        <div class="poi-assignment-grid">
                            @foreach (var item in Model.LocationAssignments)
                            {
                                var selected = user.ManagedLocationIds.Contains(item.LocationId, StringComparer.OrdinalIgnoreCase);
                                var managedByOthers = item.PoiAdminUsernames.Any(username => !string.Equals(username, user.Username, StringComparison.OrdinalIgnoreCase));
                                var assigneeLabel = string.Join(", ", item.PoiAdminNames.Where(name => !string.IsNullOrWhiteSpace(name)));

                                <label class="poi-assignment-item @(selected ? "is-selected" : string.Empty) @(managedByOthers && !selected ? "is-occupied" : string.Empty)">
                                    <input type="checkbox"
                                           name="AssignedLocationIds"
                                           value="@item.LocationId"
                                           checked="@selected" />
                                    <span class="poi-assignment-body">
                                        <span class="poi-assignment-title">@item.LocationName</span>
                                        <span class="poi-assignment-meta">@item.LocationId</span>
                                        @if (managedByOthers && !selected)
                                        {
                                            <span class="poi-assignment-lock"><i class="fas fa-rotate me-1"></i>Đang do @assigneeLabel quản lý (chọn để chuyển giao)</span>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                        <div class="small text-muted mt-1">Bạn có thể tick để chuyển POI từ tài khoản khác sang tài khoản đang chỉnh sửa.</div>

                        <button type="submit" class="btn-admin btn-admin-primary mt-3">
                            <i class="fas fa-save"></i> Lưu phân quyền POI
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div class="admin-card card-v2">
    <div class="card-header">
        <span><i class="fas fa-diagram-project me-2"></i>Phân chia POI theo tài khoản</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table table-v2 mb-0">
            <thead>
                <tr>
                    <th>POI</th>
                    <th>Mã POI</th>
                    <th>Tài khoản phụ trách</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.LocationAssignments)
            {
                <tr>
                    <td class="fw-semibold">@item.LocationName</td>
                    <td><code>@item.LocationId</code></td>
                    <td>
                        @if (item.PoiAdminNames.Any())
                        {
                            foreach (var owner in item.PoiAdminNames)
                            {
                                <span class="location-chip me-1 mb-1">@owner</span>
                            }
                        }
                        else
                        {
                            <span class="text-danger">Chưa phân công</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
