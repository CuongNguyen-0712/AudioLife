@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.PaymentPackagesModel
@using VinhKhanhAudioGuide.Web.Services
@{
    ViewData["Title"] = "Quản Lý Gói POI Admin";
    ViewData["ActivePage"] = "AdminPaymentPackages";
}

<div class="container-fluid py-4">
    <!-- ── Hero ── -->
    <div class="admin-page-hero mb-4">
        <div class="admin-page-hero-copy">
            <p class="hero-kicker"><i class="fa-solid fa-box-open"></i> Admin hệ thống</p>
            <h1 class="admin-page-hero-title">Quản Lý Gói POI Admin</h1>
            <p class="admin-page-hero-subtitle">
                Thiết lập và theo dõi các gói đăng ký dành cho tài khoản POI Admin.
                Gói đang active sẽ hiển thị trong luồng đăng ký của người dùng mới.
            </p>
            <div class="admin-page-hero-badges">
                <span class="hero-badge"><i class="fa-solid fa-circle-check"></i> @Model.ActivePackageCount active</span>
                <span class="hero-badge"><i class="fa-solid fa-circle-minus"></i> @Model.InactivePackageCount ẩn</span>
                <span class="hero-badge"><i class="fa-solid fa-user-clock"></i> @Model.ActiveSubscriptionCount đang dùng</span>
                @if (Model.Stats.TotalRevenue > 0)
                {
                    <span class="hero-badge hero-badge-revenue">
                        <i class="fa-solid fa-coins"></i>
                        @Model.Stats.TotalRevenue.ToString("N0") VND doanh thu
                    </span>
                }
            </div>
        </div>
        <div class="admin-page-hero-actions">
            <div class="admin-page-hero-kpis">
                <div class="admin-page-hero-kpi">
                    <span>Tổng gói</span>
                    <strong>@Model.Packages.Count</strong>
                </div>
                <div class="admin-page-hero-kpi">
                    <span>Active subs</span>
                    <strong>@Model.ActiveSubscriptionCount</strong>
                </div>
                <div class="admin-page-hero-kpi">
                    <span>Phổ biến nhất</span>
                    <strong class="text-truncate" style="max-width:120px" title="@Model.Stats.MostPopularPackage?.Name">
                        @(Model.Stats.MostPopularPackage?.Name ?? "–")
                    </strong>
                </div>
                <div>
                    <a href="@Url.Page("Edit")" class="btn btn-primary btn-sm w-100 mt-1">
                        <i class="fa fa-plus"></i> Thêm gói mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-primary"><i class="fa-solid fa-box"></i></div>
                <div><div class="stat-value">@Model.Packages.Count</div><div class="stat-label">Tổng gói</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-success"><i class="fa-solid fa-circle-check"></i></div>
                <div><div class="stat-value">@Model.ActivePackageCount</div><div class="stat-label">Đang kích hoạt</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-info"><i class="fa-solid fa-users"></i></div>
                <div><div class="stat-value">@Model.ActiveSubscriptionCount</div><div class="stat-label">Đăng ký active</div></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-card-v2">
                <div class="stat-icon bg-warning"><i class="fa-solid fa-coins"></i></div>
                <div>
                    <div class="stat-value" style="font-size:1.1rem">@Model.Stats.TotalRevenue.ToString("N0")</div>
                    <div class="stat-label">Doanh thu (VND)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Filter ── -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Tìm tên, mô tả..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="typeFilter" class="form-select">
                        <option value="">-- Loại đối tượng --</option>
                        <option value="User" selected="@(Model.TypeFilter == "User")">Người dùng App</option>
                        <option value="Admin" selected="@(Model.TypeFilter == "Admin")">POI Admin</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fa fa-search"></i> Lọc</button>
                </div>
                <div class="col-md-2 text-end">
                    <a href="@Url.Page("Index")" class="btn btn-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Alerts ── -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ── Package Cards ── -->
    @if (Model.Packages.Any())
    {
        <div class="pkg-grid">
            @foreach (var pkg in Model.Packages)
            {
                var templateId = $"pkg-overlay-{pkg.Id}";
                var tierIcon = pkg.DurationDays <= 30 && pkg.Price < 200_000
                    ? "fa-seedling" : pkg.DurationDays <= 30
                    ? "fa-star" : pkg.DurationDays <= 180
                    ? "fa-rocket" : "fa-crown";
                var tierClass = pkg.DurationDays >= 365 ? "pkg-card-enterprise"
                    : pkg.DurationDays >= 90 ? "pkg-card-pro"
                    : pkg.Price >= 200_000 ? "pkg-card-standard"
                    : "pkg-card-starter";

                <article class="pkg-card @tierClass @(!pkg.IsActive ? "pkg-card-inactive" : "")">
                    <!-- Tier badge -->
                    <div class="pkg-tier-icon">
                        <i class="fas @tierIcon"></i>
                    </div>

                    <div class="pkg-card-top">
                        <div>
                            <h3 class="pkg-name">@pkg.Name</h3>
                            <div class="pkg-id-chip">@pkg.Id</div>
                        </div>
                        @if (pkg.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ẩn</span>
                        }
                        <span class="badge @(pkg.TargetType == "Admin" ? "bg-info" : "bg-dark")">
                            @(pkg.TargetType == "Admin" ? "POI Admin" : "App User")
                        </span>
                    </div>

                    <div class="pkg-price-row">
                        <span class="pkg-price">@pkg.Price.ToString("N0")</span>
                        <span class="pkg-currency">@pkg.Currency</span>
                        <span class="pkg-duration">/ @pkg.DurationDays ngày</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(pkg.Description))
                    {
                        <p class="pkg-desc">@pkg.Description</p>
                    }

                    <!-- Stats row -->
                    <div class="pkg-stats-row">
                        <div class="pkg-stat">
                            <span class="pkg-stat-val">@pkg.TotalSubscriptions</span>
                            <span class="pkg-stat-label">Tổng ĐK</span>
                        </div>
                        <div class="pkg-stat">
                            <span class="pkg-stat-val text-success">@pkg.ActiveSubscriptions</span>
                            <span class="pkg-stat-label">Active</span>
                        </div>
                        <div class="pkg-stat">
                            <span class="pkg-stat-val text-warning">@pkg.PendingSubscriptions</span>
                            <span class="pkg-stat-label">Pending</span>
                        </div>
                        <div class="pkg-stat">
                            <span class="pkg-stat-val">@pkg.Revenue.ToString("N0")</span>
                            <span class="pkg-stat-label">DT (đ)</span>
                        </div>
                    </div>

                    <div class="pkg-meta">
                        <i class="fas fa-calendar-alt"></i> Tạo: @pkg.CreatedAtUtc.ToString("dd/MM/yyyy")
                    </div>

                    <!-- Actions -->
                    <div class="pkg-actions">
                        <button type="button"
                                class="btn btn-sm btn-outline-dark js-open-entity-overlay"
                                data-template-id="@templateId"
                                data-overlay-title="Chi tiết gói: @pkg.Name">
                            <i class="fa fa-eye"></i> Xem
                        </button>
                        <a href="@Url.Page("Edit", new { id = pkg.Id })" class="btn btn-sm btn-primary">
                            <i class="fa fa-edit"></i> Sửa
                        </a>
                        <form method="post" asp-page-handler="Toggle" class="d-inline">
                            <input type="hidden" name="id" value="@pkg.Id" />
                            <button type="submit" class="btn btn-sm @(pkg.IsActive ? "btn-warning" : "btn-success")">
                                <i class="fa @(pkg.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                @(pkg.IsActive ? "Ẩn" : "Kích hoạt")
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Delete" class="d-inline">
                            <input type="hidden" name="id" value="@pkg.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Xóa gói \"@pkg.Name\"? Hành động này không thể hoàn tác.')">
                                <i class="fa fa-trash"></i> Xóa
                            </button>
                        </form>
                    </div>
                </article>

                <!-- Detail overlay template -->
                <template id="@templateId">
                    <div class="entity-overlay-body-grid">
                        <section class="entity-overlay-panel">
                            <h4>Thông tin gói</h4>
                            <dl>
                                <dt>Mã gói</dt><dd><code>@pkg.Id</code></dd>
                                <dt>Tên gói</dt><dd>@pkg.Name</dd>
                                <dt>Giá</dt><dd><strong>@pkg.Price.ToString("N0") @pkg.Currency</strong></dd>
                                <dt>Thời hạn</dt><dd>@pkg.DurationDays ngày</dd>
                                <dt>Trạng thái</dt>
                                <dd>
                                    @if (pkg.IsActive)
                                    {<span class="badge bg-success">Active</span>}
                                    else
                                    {<span class="badge bg-secondary">Ẩn</span>}
                                </dd>
                                <dt>Ngày tạo</dt><dd>@pkg.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </section>
                        <section class="entity-overlay-panel">
                            <h4>Mô tả</h4>
                            <p class="mb-3">@(string.IsNullOrWhiteSpace(pkg.Description) ? "(Không có mô tả)" : pkg.Description)</p>
                            <h4>Thống kê đăng ký</h4>
                            <dl>
                                <dt>Tổng đăng ký</dt><dd>@pkg.TotalSubscriptions</dd>
                                <dt>Đang active</dt><dd class="text-success fw-bold">@pkg.ActiveSubscriptions</dd>
                                <dt>Pending</dt><dd class="text-warning fw-bold">@pkg.PendingSubscriptions</dd>
                                <dt>Doanh thu</dt><dd class="fw-bold">@pkg.Revenue.ToString("N0") @pkg.Currency</dd>
                            </dl>
                        </section>
                    </div>
                </template>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="fa fa-box-open fa-2x mb-3 d-block opacity-25"></i>
                <p class="mb-3">Chưa có gói thanh toán nào.</p>
                <a href="@Url.Page("Edit")" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Tạo gói đầu tiên
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const overlay = document.getElementById('entityOverlay');
            const titleNode = document.getElementById('entityOverlayTitle');
            const contentNode = document.getElementById('entityOverlayContent');
            const closeButtons = overlay ? overlay.querySelectorAll('[data-close-overlay]') : [];

            if (!overlay || !titleNode || !contentNode) return;

            const closeOverlay = () => {
                overlay.classList.add('d-none');
                document.body.classList.remove('translation-preview-open');
                contentNode.innerHTML = '';
            };

            closeButtons.forEach(btn => btn.addEventListener('click', closeOverlay));

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && !overlay.classList.contains('d-none')) {
                    closeOverlay();
                }
            });

            document.querySelectorAll('.js-open-entity-overlay').forEach(button => {
                button.addEventListener('click', () => {
                    const templateId = button.getAttribute('data-template-id');
                    const title = button.getAttribute('data-overlay-title') || 'Chi tiết';
                    const template = templateId ? document.getElementById(templateId) : null;
                    if (!template) return;

                    titleNode.textContent = title;
                    contentNode.innerHTML = template.innerHTML;
                    overlay.classList.remove('d-none');
                    document.body.classList.add('translation-preview-open');
                });
            });
        })();
    </script>
}

<div class="entity-overlay d-none" id="entityOverlay" aria-hidden="true">
    <div class="entity-overlay-backdrop" data-close-overlay="true"></div>
    <div class="entity-overlay-dialog" role="dialog" aria-modal="true" aria-labelledby="entityOverlayTitle">
        <div class="entity-overlay-header">
            <h3 id="entityOverlayTitle" class="mb-0">Chi tiết</h3>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-close-overlay="true">
                <i class="fa fa-xmark"></i>
            </button>
        </div>
        <div class="entity-overlay-content" id="entityOverlayContent"></div>
    </div>
</div>
