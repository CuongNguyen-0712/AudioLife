@page
@model VinhKhanhAudioGuide.Web.Pages.Admin.ReviewsModel
@using VinhKhanhAudioGuide.Web.Models
@{
    ViewData["Title"] = "Quản lý đánh giá POI";
    ViewData["ActivePage"] = "AdminReviews";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-comments"></i> Phản hồi người dùng</p>
        <h1 class="hero-title">Kiểm duyệt đánh giá địa điểm</h1>
        <p class="hero-subtitle">Duyệt hoặc từ chối các đánh giá từ ứng dụng di động để đảm bảo nội dung chất lượng.</p>
    </div>
    <span class="hero-badge"><i class="fa-solid fa-user-shield"></i> System Admin</span>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-admin mb-4">@message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card stat-card-v2">
            <div class="stat-icon bg-warning"><i class="fa-solid fa-hourglass-start"></i></div>
            <div>
                <div class="stat-value">@Model.PendingCount</div>
                <div class="stat-label">Đang chờ duyệt</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-card-v2">
            <div class="stat-icon bg-success"><i class="fa-solid fa-check"></i></div>
            <div>
                <div class="stat-value">@Model.ApprovedCount</div>
                <div class="stat-label">Đã duyệt</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-card-v2">
            <div class="stat-icon bg-danger"><i class="fa-solid fa-xmark"></i></div>
            <div>
                <div class="stat-value">@Model.RejectedCount</div>
                <div class="stat-label">Đã từ chối</div>
            </div>
        </div>
    </div>
</div>

<div class="admin-card card-v2 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Trạng thái</label>
                <select asp-for="StatusFilter" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="@ReviewStatus.Pending">Chờ duyệt</option>
                    <option value="@ReviewStatus.Approved">Đã duyệt</option>
                    <option value="@ReviewStatus.Rejected">Đã từ chối</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Địa điểm (POI)</label>
                <select asp-for="LocationFilter" class="form-select">
                    <option value="">Tất cả địa điểm</option>
                    @foreach (var loc in Model.Locations)
                    {
                        <option value="@loc.Id">@loc.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn-admin btn-admin-primary w-100">Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card card-v2 overflow-hidden">
    <div class="table-responsive">
        <table class="admin-table table-v2 mb-0">
            <thead>
                <tr>
                    <th>Địa điểm</th>
                    <th>Người dùng</th>
                    <th>Đánh giá</th>
                    <th>Nội dung</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Reviews.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-comment-slash fa-2x mb-2 d-block"></i>
                            Không tìm thấy đánh giá nào.
                        </td>
                    </tr>
                }
                @foreach (var review in Model.Reviews)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@review.Location?.Name</div>
                            <div class="small text-muted">@review.LocationId</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-sm bg-light text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-user small"></i>
                                </div>
                                <span>@(review.UserId?.ToString().Substring(0, 8) ?? "Ẩn danh")</span>
                            </div>
                        </td>
                        <td>
                            <div class="text-warning">
                                @for (int i = 0; i < 5; i++)
                                {
                                    if (i < review.Rating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star"></i>
                                    }
                                }
                            </div>
                            <div class="small text-muted">@review.Rating / 5</div>
                        </td>
                        <td style="max-width: 300px;">
                            <div class="text-truncate-2" title="@review.Comment">@review.Comment</div>
                        </td>
                        <td>
                            <div class="small">@review.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            <div class="small text-muted">@review.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                        </td>
                        <td>
                            @{
                                var badgeClass = review.Status switch
                                {
                                    ReviewStatus.Approved => "bg-success",
                                    ReviewStatus.Rejected => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@review.Status</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                @if (review.Status != ReviewStatus.Approved)
                                {
                                    <form method="post" asp-page-handler="UpdateStatus">
                                        <input type="hidden" name="id" value="@review.Id" />
                                        <input type="hidden" name="status" value="@ReviewStatus.Approved" />
                                        <button type="submit" class="btn-admin btn-sm-admin btn-admin-success" title="Duyệt">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    </form>
                                }
                                @if (review.Status != ReviewStatus.Rejected)
                                {
                                    <form method="post" asp-page-handler="UpdateStatus">
                                        <input type="hidden" name="id" value="@review.Id" />
                                        <input type="hidden" name="status" value="@ReviewStatus.Rejected" />
                                        <button type="submit" class="btn-admin btn-sm-admin btn-admin-danger" title="Từ chối">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này?');">
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button type="submit" class="btn-admin btn-sm-admin btn-admin-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .btn-admin-outline-danger {
        color: var(--bs-danger);
        border: 1px solid var(--bs-danger);
        background: transparent;
    }
    .btn-admin-outline-danger:hover {
        background: var(--bs-danger);
        color: white;
    }
</style>
