@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Xóa tour";
    ViewData["ActivePage"] = "Tours";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-trash-can"></i> Xóa tour</p>
        <h1 class="hero-title">Xóa tour</h1>
        <p class="hero-subtitle">Xác nhận xóa tour trước khi áp dụng thay đổi vào hệ thống.</p>
    </div>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card card-v2">
    <div class="p-4" style="max-width:600px;">
        <div class="alert alert-danger alert-admin">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Bạn có chắc muốn xóa tour <strong>"@Model.Tour.Name"</strong>?
        </div>
        <form method="post">
            <input type="hidden" asp-for="Tour.Id" />
            <button type="submit" class="btn-admin btn-admin-danger"><i class="fas fa-trash"></i> Xác nhận xóa</button>
            <a asp-page="Index" class="btn-admin btn-admin-outline ms-2">Hủy</a>
        </form>
    </div>
</div>
