@page
@model VinhKhanhAudioGuide.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tour ẩm thực";
    ViewData["ActivePage"] = "Tours";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-route"></i> Quản lý tour</p>
        <h1 class="hero-title">Quản lý tour</h1>
        <p class="hero-subtitle">Thiết lập hành trình ẩm thực, giá bán và cấu trúc điểm dừng theo tour.</p>
    </div>
    <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm tour</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card card-v2 mb-4">
    <div class="p-3 p-md-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label for="keyword" class="form-label">Tìm tour</label>
                <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên tour hoặc mô tả..." />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input id="featuredOnly" name="featuredOnly" value="true" type="checkbox" class="form-check-input" checked="@Model.FeaturedOnly" />
                    <label class="form-check-label" for="featuredOnly">Chỉ tour nổi bật</label>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn-admin btn-admin-primary w-100" type="submit">Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card card-v2">
    <div class="p-3 small text-muted">Đang hiển thị @Model.Tours.Count tour.</div>
    <table class="admin-table table-v2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên tour</th>
                <th>Thời lượng</th>
                <th>Giá</th>
                <th>Nổi bật</th>
                <th>Địa điểm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tour in Model.Tours)
            {
                var hours = tour.Duration / 60;
                var mins = tour.Duration % 60;
                <tr>
                    <td><code>@tour.Id</code></td>
                    <td><strong>@tour.Name</strong></td>
                    <td>@(hours > 0 ? $"{hours}h" : "")@(mins > 0 ? $"{mins}p" : "")</td>
                    <td>@(tour.Price == 0 ? "Miễn phí" : $"{tour.Price:N0} VNĐ")</td>
                    <td>
                        @if (tour.IsFeatured)
                        {
                            <span class="badge-admin badge-featured"><i class="fas fa-star"></i> Nổi bật</span>
                        }
                    </td>
                    <td><span class="badge-admin badge-count">@tour.TourLocations.Count</span></td>
                    <td class="action-cell">
                        <div class="action-buttons">
                            <a asp-page="Edit" asp-route-id="@tour.Id" class="btn-admin btn-sm-admin btn-sm-icon btn-admin-warning" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                            <a asp-page="Delete" asp-route-id="@tour.Id" class="btn-admin btn-sm-admin btn-sm-icon btn-admin-danger" title="Xóa"><i class="fas fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Tours.Any())
    {
        <div class="empty-state"><i class="fas fa-route d-block"></i>Chưa có tour nào</div>
    }
</div>
