@page
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.IndexModel
@{
    ViewData["Title"] = "Hướng dẫn audio";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-headphones"></i> Thư viện audio</p>
        <h1 class="hero-title">Quản lý audio guide</h1>
        <p class="hero-subtitle">Theo dõi nội dung audio toàn hệ thống và phân bổ theo điểm đến.</p>
    </div>
    <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm audio guide</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card card-v2">
    <table class="admin-table table-v2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tiêu đề</th>
                <th>Địa điểm</th>
                <th>Ngôn ngữ</th>
                <th>Thời lượng</th>
                <th>Audio URL</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ag in Model.AudioGuides)
            {
                <tr>
                    <td><code>@ag.Id</code></td>
                    <td><strong>@ag.Title</strong><br/><small class="text-muted">@ag.Description</small></td>
                    <td><span class="badge-admin badge-category">@(ag.Location?.Name ?? "N/A")</span></td>
                    <td>
                        @ag.Language.ToUpper()
                        @if (ag.GeneratedFromTts)
                        {
                            <span class="badge bg-success ms-1" title="Tạo từ TTS"><i class="fas fa-robot"></i> TTS</span>
                        }
                    </td>
                    <td>@ag.Duration phút</td>
                    <td class="audio-preview-cell">
                        @{ var selectedAudioUrl = !string.IsNullOrWhiteSpace(ag.AudioUrl) ? ag.AudioUrl : ag.CloudinaryAudioUrl; }
                        @if (!string.IsNullOrEmpty(ag.CloudinaryAudioUrl) || !string.IsNullOrEmpty(ag.AudioUrl))
                        {
                            <div class="audio-preview-box">
                                <audio controls class="audio-preview-player">
                                    <source src="@selectedAudioUrl" type="audio/mpeg">
                                </audio>
                                <small class="audio-preview-url" title="@selectedAudioUrl">@selectedAudioUrl</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">Chưa có file audio</span>
                        }
                    </td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@ag.Id" class="btn-admin btn-sm-admin btn-admin-warning"><i class="fas fa-edit"></i></a>
                        <a asp-page="Delete" asp-route-id="@ag.Id" class="btn-admin btn-sm-admin btn-admin-danger"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.AudioGuides.Any())
    {
        <div class="empty-state"><i class="fas fa-headphones-alt d-block"></i>Chưa có audio guide nào</div>
    }
</div>
