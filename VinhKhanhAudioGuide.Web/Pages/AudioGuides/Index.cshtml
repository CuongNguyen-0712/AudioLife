@page
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.IndexModel
@{
    ViewData["Title"] = "Hướng dẫn audio";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-headphones"></i> Thư viện audio</p>
        <h1 class="hero-title">Quản lý audio guide</h1>
        <p class="hero-subtitle">Theo dõi nội dung audio toàn hệ thống và phân bổ theo điểm đến.</p>
    </div>
    <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm audio guide</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card card-v2">
    <div class="p-3 p-md-4">
        @if (!Model.AudioGuides.Any())
        {
            <div class="empty-state"><i class="fas fa-headphones-alt d-block"></i>Chưa có audio guide nào</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var ag in Model.AudioGuides)
                {
                    var selectedAudioUrl = !string.IsNullOrWhiteSpace(ag.AudioUrl) ? ag.AudioUrl : ag.CloudinaryAudioUrl;
                    <div class="col-12 col-xl-6 col-xxl-4">
                        <div class="audio-grid-card h-100">
                            <div class="audio-grid-head">
                                <div class="audio-grid-title">@ag.Title</div>
                                <code class="audio-grid-id">@ag.Id</code>
                            </div>
                            <div class="audio-grid-body">
                                <div class="audio-grid-meta"><span>Địa điểm</span><strong>@(ag.Location?.Name ?? "N/A")</strong></div>
                                <div class="audio-grid-meta"><span>Ngôn ngữ</span><strong>@ag.Language.ToUpper()</strong></div>
                                <div class="audio-grid-meta"><span>Thời lượng</span><strong>@ag.Duration phút</strong></div>
                                @if (ag.GeneratedFromTts)
                                {
                                    <div class="audio-grid-badge"><span class="badge bg-success"><i class="fas fa-robot me-1"></i>TTS</span></div>
                                }
                                <p class="audio-grid-desc">@ag.Description</p>
                                @if (!string.IsNullOrEmpty(selectedAudioUrl))
                                {
                                    <audio controls class="audio-preview-player">
                                        <source src="@selectedAudioUrl" type="audio/mpeg">
                                    </audio>
                                }
                                else
                                {
                                    <div class="text-muted small">Chưa có file audio</div>
                                }
                            </div>
                            <div class="audio-grid-actions">
                                <a asp-page="Edit" asp-route-id="@ag.Id" class="btn-admin btn-admin-warning"><i class="fas fa-edit"></i> Sửa</a>
                                <a asp-page="Delete" asp-route-id="@ag.Id" class="btn-admin btn-admin-danger"><i class="fas fa-trash"></i> Xóa</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
