@page
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.IndexModel
@{
    ViewData["Title"] = "Hướng dẫn audio";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-headphones"></i> Thư viện audio</p>
        <h1 class="hero-title">Theo dõi audio guide</h1>
        <p class="hero-subtitle">Khu này ở chế độ xem-only. Vui lòng dùng màn Audio & bản dịch để theo dõi dữ liệu tổng hợp.</p>
    </div>
    <a asp-page="/Admin/Translations" class="btn-admin btn-admin-outline"><i class="fas fa-language"></i> Mở Audio & bản dịch</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card card-v2 mb-4">
    <div class="p-3 p-md-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="keyword" class="form-label">Tìm audio</label>
                <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tiêu đề, mô tả, transcript..." />
            </div>
            <div class="col-md-3">
                <label for="locationId" class="form-label">POI</label>
                <select id="locationId" name="locationId" class="form-select">
                    <option value="">Tất cả POI</option>
                    @foreach (var location in Model.Locations)
                    {
                        <option value="@location.Id" selected="@(location.Id == Model.LocationId)">@location.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="language" class="form-label">Ngôn ngữ</label>
                <select id="language" name="language" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="vi" selected="@(Model.Language == "vi")">VI</option>
                    <option value="en" selected="@(Model.Language == "en")">EN</option>
                    <option value="fr" selected="@(Model.Language == "fr")">FR</option>
                    <option value="ja" selected="@(Model.Language == "ja")">JA</option>
                    <option value="ko" selected="@(Model.Language == "ko")">KO</option>
                    <option value="zh" selected="@(Model.Language == "zh")">ZH</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input id="ttsOnly" name="ttsOnly" value="true" type="checkbox" class="form-check-input" checked="@Model.TtsOnly" />
                    <label class="form-check-label" for="ttsOnly">Chỉ TTS</label>
                </div>
                <div class="form-check">
                    <input id="onlyIssues" name="onlyIssues" value="true" type="checkbox" class="form-check-input" checked="@Model.OnlyIssues" />
                    <label class="form-check-label" for="onlyIssues">Chỉ lỗi dữ liệu</label>
                </div>
            </div>
            <div class="col-md-1">
                <button class="btn-admin btn-admin-primary w-100" type="submit">Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card card-v2">
    <div class="p-3 p-md-4">
        <div class="small text-muted mb-3">Đang hiển thị @Model.AudioGuides.Count audio guide.</div>
        @if (!Model.AudioGuides.Any())
        {
            <div class="empty-state"><i class="fas fa-headphones-alt d-block"></i>Chưa có audio guide nào</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var ag in Model.AudioGuides)
                {
                    var selectedAudioUrl = !string.IsNullOrWhiteSpace(ag.AudioUrl) ? ag.AudioUrl : ag.CloudinaryAudioUrl;
                    <div class="col-12 col-xl-6 col-xxl-4">
                        <div class="audio-grid-card h-100">
                            <div class="audio-grid-head">
                                <div class="audio-grid-title">@ag.Title</div>
                                <code class="audio-grid-id">@ag.Id</code>
                            </div>
                            <div class="audio-grid-body">
                                <div class="audio-grid-meta"><span>Địa điểm</span><strong>@(ag.Location?.Name ?? "N/A")</strong></div>
                                <div class="audio-grid-meta"><span>Ngôn ngữ</span><strong>@ag.Language.ToUpper()</strong></div>
                                <div class="audio-grid-meta"><span>Thời lượng</span><strong>@ag.Duration phút</strong></div>
                                @if (ag.GeneratedFromTts)
                                {
                                    <div class="audio-grid-badge"><span class="badge bg-success"><i class="fas fa-robot me-1"></i>TTS</span></div>
                                }
                                @if (string.IsNullOrWhiteSpace(ag.TranscriptText) || (string.IsNullOrWhiteSpace(ag.AudioUrl) && string.IsNullOrWhiteSpace(ag.CloudinaryAudioUrl)))
                                {
                                    <div class="audio-grid-badge mt-2"><span class="badge bg-warning text-dark"><i class="fas fa-triangle-exclamation me-1"></i>Cần bổ sung dữ liệu</span></div>
                                }
                                <p class="audio-grid-desc">@ag.Description</p>
                                @if (!string.IsNullOrEmpty(selectedAudioUrl))
                                {
                                    <audio controls class="audio-preview-player">
                                        <source src="@selectedAudioUrl" type="audio/mpeg">
                                    </audio>
                                }
                                else
                                {
                                    <div class="text-muted small">Chưa có file audio</div>
                                }
                            </div>
                            <div class="audio-grid-actions">
                                <span class="badge text-bg-light border">Chế độ xem-only</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
