@page
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.IndexModel
@{
    ViewData["Title"] = "Audio Guides";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="page-header">
    <h1><i class="fas fa-headphones-alt me-2"></i>Quản lý Audio Guides</h1>
    <a asp-page="Create" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Thêm audio guide</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-admin">@TempData["Success"]</div>
}

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tiêu đề</th>
                <th>Địa điểm</th>
                <th>Ngôn ngữ</th>
                <th>Thời lượng</th>
                <th>Audio URL</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ag in Model.AudioGuides)
            {
                <tr>
                    <td><code>@ag.Id</code></td>
                    <td><strong>@ag.Title</strong><br/><small class="text-muted">@ag.Description</small></td>
                    <td><span class="badge-admin badge-category">@(ag.Location?.Name ?? "N/A")</span></td>
                    <td>@ag.Language.ToUpper()</td>
                    <td>@ag.Duration phút</td>
                    <td style="max-width:150px;word-break:break-all;"><small>@ag.AudioUrl</small></td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@ag.Id" class="btn-admin btn-sm-admin btn-admin-warning"><i class="fas fa-edit"></i></a>
                        <a asp-page="Delete" asp-route-id="@ag.Id" class="btn-admin btn-sm-admin btn-admin-danger"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.AudioGuides.Any())
    {
        <div class="empty-state"><i class="fas fa-headphones-alt d-block"></i>Chưa có audio guide nào</div>
    }
</div>
