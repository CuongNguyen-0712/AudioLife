@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.EditModel
@{
    ViewData["Title"] = "Sửa Audio Guide";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-pen"></i> Cập nhật audio</p>
        <h1 class="hero-title">Sửa Audio Guide</h1>
        <p class="hero-subtitle">Cập nhật nội dung audio và đồng bộ thông tin hiển thị trên ứng dụng.</p>
    </div>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card card-v2">
    <div class="p-4">
        <form method="post" enctype="multipart/form-data" class="admin-form form-shell-lg">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div asp-validation-summary="All" class="alert alert-danger alert-admin mb-3"></div>
            }
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AudioGuide.Id" class="form-label">Mã audio guide</label>
                    <input asp-for="AudioGuide.Id" class="form-control" readonly />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AudioGuide.LocationId" class="form-label">Địa điểm</label>
                    <select asp-for="AudioGuide.LocationId" asp-items="Model.LocationList" class="form-select">
                        <option value="">-- Chọn địa điểm --</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="AudioGuide.Title" class="form-label">Tiêu đề</label>
                <input asp-for="AudioGuide.Title" class="form-control" />
                <span asp-validation-for="AudioGuide.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AudioGuide.Description" class="form-label">Mô tả</label>
                <textarea asp-for="AudioGuide.Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AudioGuide.Duration" class="form-label">Thời lượng (phút)</label>
                    <input asp-for="AudioGuide.Duration" class="form-control" type="number" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="AudioGuide.Language" class="form-label">Ngôn ngữ</label>
                    <select asp-for="AudioGuide.Language" class="form-select" id="languageSelect">
                        <option value="vi">Tiếng Việt</option>
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                        <option value="ja">日本語</option>
                        <option value="ko">한국어</option>
                        <option value="zh">中文</option>
                    </select>
                </div>
            </div>

            <!-- Audio Mode Toggle -->
            <div class="mb-3">
                <label class="form-label fw-bold">Nguồn audio</label>
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="AudioMode" id="modeUpload" value="upload"
                           checked="@(Model.AudioMode == "upload" ? "checked" : null)" onchange="toggleAudioMode()">
                    <label class="btn btn-outline-primary" for="modeUpload">
                        <i class="fas fa-upload"></i> Upload file audio
                    </label>
                    <input type="radio" class="btn-check" name="AudioMode" id="modeTts" value="tts"
                              checked="@(Model.AudioMode == "tts" ? "checked" : null)" onchange="toggleAudioMode()">
                    <label class="btn btn-outline-success" for="modeTts">
                        <i class="fas fa-robot"></i> Tạo từ văn bản (TTS)
                    </label>
                </div>
            </div>

            <!-- Upload Mode -->
            <div id="uploadSection">
                <div class="mb-3">
                    <label asp-for="AudioGuide.AudioUrl" class="form-label">Audio URL</label>
                    <input asp-for="AudioGuide.AudioUrl" class="form-control" />
                    <small class="text-muted">Nếu upload file thì URL sẽ tự động được thay thế.</small>
                </div>
                <div class="mb-3">
                    <label asp-for="AudioFile" class="form-label">Upload file audio (Cloudinary)</label>
                    @if (!string.IsNullOrEmpty(Model.AudioGuide.CloudinaryAudioUrl) || !string.IsNullOrEmpty(Model.AudioGuide.AudioUrl))
                    {
                        var audioSrc = !string.IsNullOrEmpty(Model.AudioGuide.AudioUrl) ? Model.AudioGuide.AudioUrl : Model.AudioGuide.CloudinaryAudioUrl;
                        <div class="audio-preview-box mb-2">
                            <small class="text-muted d-block mb-1">Audio hiện tại:</small>
                            <audio controls class="audio-preview-player audio-preview-player-form">
                                <source src="@audioSrc" type="audio/mpeg">
                            </audio>
                            <small class="audio-preview-url" title="@audioSrc">@audioSrc</small>
                        </div>
                    }
                    <input asp-for="AudioFile" type="file" class="form-control" accept="audio/*" />
                    <span asp-validation-for="AudioFile" class="text-danger"></span>
                </div>
            </div>

            <!-- TTS Mode -->
            <div id="ttsSection" class="tts-section">
                <div class="alert alert-info py-2 mb-3">
                    <i class="fas fa-circle-info me-1"></i>
                    Chế độ TTS sử dụng trực tiếp nội dung từ trường <strong>Transcript</strong> bên dưới để tạo audio.
                </div>
                @if (Model.AudioGuide.GeneratedFromTts && (!string.IsNullOrEmpty(Model.AudioGuide.CloudinaryAudioUrl) || !string.IsNullOrEmpty(Model.AudioGuide.AudioUrl)))
                {
                    var audioSrc = !string.IsNullOrEmpty(Model.AudioGuide.AudioUrl) ? Model.AudioGuide.AudioUrl : Model.AudioGuide.CloudinaryAudioUrl;
                    <div class="audio-preview-box mb-3">
                        <small class="text-muted d-block mb-1">Audio TTS hiện tại:</small>
                        <audio controls class="audio-preview-player audio-preview-player-form">
                            <source src="@audioSrc" type="audio/mpeg">
                        </audio>
                        <small class="audio-preview-url" title="@audioSrc">@audioSrc</small>
                    </div>
                }
                <div class="alert alert-info py-2">
                    <i class="fas fa-magic"></i>
                    Audio sẽ được tạo lại khi bạn nhấn <strong>Cập nhật</strong>.
                    Giọng đọc sẽ phụ thuộc vào ngôn ngữ đã chọn ở trên.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="AudioGuide.TranscriptText" class="form-label">Transcript (nguồn cho TTS)</label>
                <textarea asp-for="AudioGuide.TranscriptText" class="form-control" rows="5"></textarea>
            </div>
            <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-save"></i> Cập nhật</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function toggleAudioMode() {
        const isUpload = document.getElementById('modeUpload').checked;
        document.getElementById('uploadSection').style.display = isUpload ? '' : 'none';
        document.getElementById('ttsSection').style.display = isUpload ? 'none' : '';
    }
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', toggleAudioMode);
</script>
}
