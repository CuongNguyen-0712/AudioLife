@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.AudioGuides.DeleteModel
@{
    ViewData["Title"] = "Xóa Audio Guide";
    ViewData["ActivePage"] = "AudioGuides";
}

<div class="page-header">
    <h1><i class="fas fa-trash me-2"></i>Xóa Audio Guide</h1>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card">
    <div class="p-4" style="max-width:600px;">
        <div class="alert alert-danger alert-admin">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Bạn có chắc muốn xóa audio guide <strong>"@Model.AudioGuide.Title"</strong>?
        </div>
        <form method="post">
            <input type="hidden" asp-for="AudioGuide.Id" />
            <button type="submit" class="btn-admin btn-admin-danger"><i class="fas fa-trash"></i> Xác nhận xóa</button>
            <a asp-page="Index" class="btn-admin btn-admin-outline ms-2">Hủy</a>
        </form>
    </div>
</div>
