@page
@model IndexModel
@{
    ViewData["Title"] = "Cổng Quản Trị";
}

<div class="page-header">
    <h1><i class="fas fa-network-wired me-2"></i>Cổng quản trị hệ thống</h1>
    <div class="d-flex gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="text-muted align-self-center"><i class="fas fa-user me-1"></i>@User.Identity.Name</span>
            <form method="post" asp-page="/Account/Logout" class="d-inline">
                <button type="submit" class="btn-admin btn-admin-outline"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login" class="btn-admin btn-admin-outline"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="card-header">
                <span><i class="fas fa-user-shield me-2"></i>Khu Admin Hệ Thống</span>
            </div>
            <div class="p-4">
                <p class="text-muted mb-4">Quản trị toàn bộ nội dung: danh mục, địa điểm, tour và audio guide trên toàn hệ thống.</p>
                <a asp-page="/Admin/Index" class="btn-admin btn-admin-primary">
                    <i class="fas fa-arrow-right me-1"></i> Vào khu Admin Hệ Thống
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="card-header">
                <span><i class="fas fa-store me-2"></i>Khu Admin POI</span>
            </div>
            <div class="p-4">
                <p class="text-muted mb-4">Mỗi Admin POI quản trị các điểm ẩm thực được phân quyền: cập nhật thông tin địa điểm và quản lý audio liên quan.</p>
                <a asp-page="/Shop/Index" class="btn-admin btn-admin-success">
                    <i class="fas fa-arrow-right me-1"></i> Vào khu Admin POI
                </a>
            </div>
        </div>
    </div>
</div>
