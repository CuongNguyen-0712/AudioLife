@page
@model IndexModel
@{
    ViewData["Title"] = "Cổng Quản Trị";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-compass"></i> Control Center</p>
        <h1 class="hero-title">Cổng quản trị hệ thống</h1>
        <p class="hero-subtitle">Chọn không gian làm việc phù hợp: quản trị hệ thống hoặc quản trị POI.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="role-pill role-pill-admin"><i class="fas fa-user"></i>@User.Identity.Name</span>
            <form method="post" asp-page="/Account/Logout" class="d-inline">
                <button type="submit" class="btn-admin btn-admin-outline"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login" class="btn-admin btn-admin-outline"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="card-header">
                <span><i class="fas fa-user-shield me-2"></i>Khu Admin Hệ Thống</span>
            </div>
            <div class="p-4">
                <p class="text-muted mb-4">Quản trị danh mục, địa điểm, tour, audio và xử lý yêu cầu thay đổi từ Admin POI.</p>
                <a asp-page="/Admin/Index" class="btn-admin btn-admin-primary">
                    <i class="fas fa-arrow-right me-1"></i> Vào khu System Admin
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="card-header">
                <span><i class="fas fa-store me-2"></i>Khu Admin POI</span>
            </div>
            <div class="p-4">
                <p class="text-muted mb-4">Quản trị nội dung audio theo các POI được phân quyền và gửi đề xuất thay đổi lên hệ thống.</p>
                <a asp-page="/Shop/Index" class="btn-admin btn-admin-success">
                    <i class="fas fa-arrow-right me-1"></i> Vào khu POI Admin
                </a>
            </div>
        </div>
    </div>
</div>
