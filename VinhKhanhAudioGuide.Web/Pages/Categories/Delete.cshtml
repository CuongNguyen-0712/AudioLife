@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Xóa danh mục";
    ViewData["ActivePage"] = "Categories";
}

<div class="page-header">
    <h1><i class="fas fa-trash me-2"></i>Xóa danh mục</h1>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card">
    <div class="p-4" style="max-width:600px;">
        <div class="alert alert-danger alert-admin">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Bạn có chắc muốn xóa danh mục <strong>"@Model.Category.Name"</strong>?
            @if (Model.LocationCount > 0)
            {
                <br/><small>Danh mục này hiện có <strong>@Model.LocationCount</strong> địa điểm. Không thể xóa khi còn địa điểm liên kết.</small>
            }
        </div>
        <form method="post">
            <input type="hidden" asp-for="Category.Id" />
            <button type="submit" class="btn-admin btn-admin-danger" @(Model.LocationCount > 0 ? "disabled" : "")>
                <i class="fas fa-trash"></i> Xác nhận xóa
            </button>
            <a asp-page="Index" class="btn-admin btn-admin-outline ms-2">Hủy</a>
        </form>
    </div>
</div>
