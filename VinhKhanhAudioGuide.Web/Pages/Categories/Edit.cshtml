@page "{id}"
@model VinhKhanhAudioGuide.Web.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Sửa danh mục";
    ViewData["ActivePage"] = "Categories";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="hero-kicker"><i class="fa-solid fa-pen"></i> Cập nhật danh mục</p>
        <h1 class="hero-title">Sửa danh mục</h1>
        <p class="hero-subtitle">Điều chỉnh tên, icon và mô tả để đồng bộ taxonomy nội dung.</p>
    </div>
    <a asp-page="Index" class="btn-admin btn-admin-outline"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="admin-card card-v2">
    <div class="p-4">
        <form method="post" class="admin-form form-shell-md">
            <div class="mb-3">
                <label asp-for="Category.Id" class="form-label">Mã danh mục</label>
                <input asp-for="Category.Id" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Category.Name" class="form-label">Tên danh mục</label>
                <input asp-for="Category.Name" class="form-control" />
                <span asp-validation-for="Category.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Category.Icon" class="form-label">Icon (Font Awesome class)</label>
                <input asp-for="Category.Icon" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Category.Description" class="form-label">Mô tả</label>
                <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-save"></i> Cập nhật</button>
        </form>
    </div>
</div>
