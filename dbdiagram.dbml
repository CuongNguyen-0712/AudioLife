Table Category {
  Id String [pk]
  Name String
  Icon String
  Description String
}

Table Location {
  Id String [pk]
  Name String
  Description String
  ImageUrl String
  Address String
  Latitude Float
  Longitude Float
  Duration Int
  CategoryId String
}

Table AudioGuide {
  Id String [pk]
  Title String
  Description String
  AudioUrl String
  TranscriptText String
  Duration Int
  LocationId String
  Language String
  GeneratedFromTts Boolean
  TtsSourceText String
}

Table AudioScriptSegment {
  Id Int [pk]
  AudioGuideId String
  StartTimeSeconds Int
  EndTimeSeconds Int
  ScriptText String
}

Table Tour {
  Id String [pk]
  Name String
  Description String
  ImageUrl String
  Duration Int
  Price Decimal
  IsFeatured Boolean
}

Table TourLocation {
  TourId String
  LocationId String
  SortOrder Int

  indexes {
    (TourId, LocationId) [pk]
  }
}

Table AuthUserAccount {
  Id Int [pk, increment]
  Username String
  Password String
  DisplayName String
  Role String // SystemAdmin | PoiAdmin
  IsActive Boolean
  CreatedAtUtc DateTime

  indexes {
    (Username) [unique]
    (Role, IsActive)
  }
}

Table PoiAdminLocationAssignment {
  Id Int [pk, increment]
  Username String
  LocationId String

  indexes {
    (Username)
    (LocationId)
    (Username, LocationId) [unique]
  }
}

Table PoiChangeRequest {
  Id Guid [pk]
  SubmittedByUsername String
  SubmittedByName String
  LocationId String
  LocationName String
  Topic String
  Title String
  Details String
  TargetType String // Location | AudioGuide
  TargetEntityId String
  ChangeSetJson String
  Status String // Pending | InReview | Approved | Rejected
  SubmittedAtUtc DateTime
  UpdatedAtUtc DateTime
  UpdatedBy String
  ReviewNote String

  indexes {
    (Status)
    (SubmittedByUsername)
    (LocationId)
    (SubmittedAtUtc)
  }
}

Table ListeningHistory {
  Id String [pk]
  AudioGuideId String
  LocationId String
  AudioTitle String
  LocationName String
  LocationImageUrl String
  AudioDuration Int
  Progress Decimal
  ListenedSeconds Int
  IsCompleted Boolean
  LastListenedAtUtc DateTime

  indexes {
    (AudioGuideId)
    (LocationId)
    (LastListenedAtUtc)
    (LocationId, LastListenedAtUtc)
  }
}

// Relationships
Ref: Location.CategoryId > Category.Id
Ref: AudioGuide.LocationId > Location.Id
Ref: AudioScriptSegment.AudioGuideId > AudioGuide.Id
Ref: TourLocation.TourId > Tour.Id
Ref: TourLocation.LocationId > Location.Id
Ref: PoiAdminLocationAssignment.LocationId > Location.Id
Ref: PoiAdminLocationAssignment.Username > AuthUserAccount.Username
Ref: PoiChangeRequest.LocationId > Location.Id
Ref: ListeningHistory.AudioGuideId > AudioGuide.Id
Ref: ListeningHistory.LocationId > Location.Id