<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.PaymentPlanSelectionPage"
             Title="Chọn gói sử dụng"
             BackgroundColor="{StaticResource Surface}"
             NavigationPage.HasNavigationBar="True">

    <NavigationPage.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Image Source="tour.svg" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
            <Label Text="Chọn gói sử dụng"
                   FontFamily="RobotoCondensed-SemiBold"
                   FontSize="20"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </NavigationPage.TitleView>

    <Grid>
        <Ellipse Fill="{StaticResource PrimaryContainer}"
                 Opacity="0.12"
                 WidthRequest="320"
                 HeightRequest="320"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 TranslationX="-110"
                 TranslationY="-100"
                 InputTransparent="True" />

        <Ellipse Fill="{StaticResource TertiaryContainer}"
                 Opacity="0.10"
                 WidthRequest="360"
                 HeightRequest="360"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 TranslationX="120"
                 TranslationY="120"
                 InputTransparent="True" />

        <Grid Padding="20,24,20,20"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16">
            <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="2,4,2,0">
                <Label Text="Chọn gói phù hợp nhất"
                       FontFamily="RobotoCondensed-SemiBold"
                       FontSize="24"
                       TextColor="{StaticResource OnSurface}" />
                <Label Text="Mỗi gói được thiết kế để bạn bắt đầu nhanh và dễ theo dõi chi phí."
                       FontFamily="RobotoCondensed-Regular"
                       FontSize="14"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <Border x:Name="DailyPlanCard"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceContainerLowest}"
                        Padding="16"
                        Shadow="{x:Null}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDailyPlanTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border x:Name="DailyPlanIndicator"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="22"
                                WidthRequest="22"
                                VerticalOptions="Start"
                                Margin="0,2,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <Label x:Name="DailyPlanIndicatorLabel"
                                   Text="✓"
                                   FontFamily="RobotoCondensed-SemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource OnPrimary}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="DailyPlanTitleLabel"
                                       Text="10.000đ/ngày"
                                       FontFamily="RobotoCondensed-SemiBold"
                                       FontSize="18"
                                       TextColor="{StaticResource OnSurface}" />
                                <Border StrokeThickness="0"
                                        BackgroundColor="{StaticResource SecondaryContainer}"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Label Text="Linh hoạt"
                                           FontFamily="RobotoCondensed-SemiBold"
                                           FontSize="10"
                                           TextColor="{StaticResource OnSecondaryContainer}"
                                           VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label x:Name="DailyPlanPriceLabel"
                                   Text="Một ngày sử dụng"
                                   FontFamily="RobotoCondensed-Medium"
                                   FontSize="16"
                                   TextColor="{StaticResource Primary}" />

                            <Label x:Name="DailyPlanDescriptionLabel"
                                   Text="Phù hợp khi bạn muốn trải nghiệm nhanh trong một ngày, tối ưu cho khách ghé ngắn."
                                   FontFamily="RobotoCondensed-Regular"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border x:Name="FullTourPlanCard"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceContainerLowest}"
                        Padding="16"
                        Shadow="{x:Null}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFullTourPlanTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border x:Name="FullTourPlanIndicator"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                HeightRequest="22"
                                WidthRequest="22"
                                VerticalOptions="Start"
                                Margin="0,2,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <Label x:Name="FullTourPlanIndicatorLabel"
                                   Text=""
                                   FontFamily="RobotoCondensed-SemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource OnPrimary}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="FullTourPlanTitleLabel"
                                       Text="29.000đ/full tour"
                                       FontFamily="RobotoCondensed-SemiBold"
                                       FontSize="18"
                                       TextColor="{StaticResource OnSurface}" />
                                <Border StrokeThickness="0"
                                        BackgroundColor="{StaticResource TertiaryContainer}"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Label Text="Phổ biến"
                                           FontFamily="RobotoCondensed-SemiBold"
                                           FontSize="10"
                                           TextColor="{StaticResource OnTertiaryFixed}" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label x:Name="FullTourPlanPriceLabel"
                                   Text="Một lần thanh toán"
                                   FontFamily="RobotoCondensed-Medium"
                                   FontSize="16"
                                   TextColor="{StaticResource Primary}" />

                            <Label x:Name="FullTourPlanDescriptionLabel"
                                   Text="Mở khóa toàn bộ tour, phù hợp khi bạn muốn nghe trọn vẹn nội dung đã quét."
                                   FontFamily="RobotoCondensed-Regular"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="2"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                    Padding="14,10"
                    Margin="0,2,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <Image Source="tour.svg"
                           WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center" />
                    <Label x:Name="SelectionSummaryLabel"
                           Text="Đang chọn: 10.000đ/ngày"
                           FontFamily="RobotoCondensed-Medium"
                           FontSize="13"
                           TextColor="{StaticResource OnSurface}" />
                </HorizontalStackLayout>
            </Border>

                <Button x:Name="ContinueButton"
                    Grid.Row="3"
                    Text="Tiếp tục"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnContinueClicked"
                    Margin="0,2,0,0" />
        </Grid>
    </Grid>
</ContentPage>
