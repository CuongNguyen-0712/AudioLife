<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.LanguageSection"
             BackgroundColor="{StaticResource PrimaryContainer}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="language_bg.svg"
               Aspect="AspectFill"
               />

        <Grid Padding="24,40,24,36" RowDefinitions="Auto,*,Auto,Auto">

            <!-- <Grid Grid.Row="1">
                <Image Source="intro_bg.jpg"
                       WidthRequest="311"
                       HeightRequest="311"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid> -->

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 WidthRequest="279">
                  <Label x:Name="TitleLabel"
                      Text="Ngôn ngữ của bạn"
                       FontFamily="RobotoCondensed-SemiBold"
                       FontSize="24"
                       Margin="0,0,0,8"
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <Border BackgroundColor="{StaticResource SecondaryContainer}"
                        Opacity="0.5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="47">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVietnameseTapped" />
                    </Border.GestureRecognizers>
                          <Label x:Name="VietnameseOptionLabel"
                              Text="Tiếng Việt"
                           TextColor="{StaticResource OnSecondaryContainer}"
                           FontFamily="RobotoCondensed-Medium"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Border>

                <Border BackgroundColor="{StaticResource SecondaryContainer}"
                        Opacity="0.5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="47">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEnglishTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="EnglishOptionLabel"
                           Text="English"
                           TextColor="{StaticResource OnSecondaryContainer}"
                           FontFamily="RobotoCondensed-Medium"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Border>

                <Border BackgroundColor="{StaticResource SecondaryContainer}"
                        Opacity="0.5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="47">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChineseSimplifiedTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="ChineseSimplifiedOptionLabel"
                           Text="简体中文"
                           TextColor="{StaticResource OnSecondaryContainer}"
                           FontFamily="RobotoCondensed-Medium"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="LoadingOverlay"
              IsVisible="False"
              InputTransparent="False"
              BackgroundColor="#66000000"
              RowDefinitions="Auto,Auto"
              RowSpacing="10"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               Color="White"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
            <Label x:Name="LoadingTextLabel"
                   Grid.Row="1"
                   Text="Loading..."
                   FontFamily="RobotoCondensed-Medium"
                   FontSize="14"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Margin="0,48,0,0" />
        </Grid>
    </Grid>

</ContentPage>