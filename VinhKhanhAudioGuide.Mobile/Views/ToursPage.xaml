<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.ToursPage"
             x:DataType="viewmodels:ToursViewModel"
             Title="Tours">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="15"
                                 Spacing="15">

                <!-- Header -->
                <Label Text="Lộ trình tham quan"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <Label Text="Khám phá Vĩnh Khánh theo lộ trình của bạn"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"/>

                <!-- Featured Tours -->
                <Label Text="Lộ trình nổi bật"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding FeaturedTours}"
                                HeightRequest="240"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">

                            <Frame Padding="0" Margin="5" CornerRadius="15" WidthRequest="260" HeightRequest="220" HasShadow="True">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid>
                                    <!-- full image background -->
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />

                                    <!-- subtle dark overlay for contrast -->
                                    <BoxView BackgroundColor="#33000000" />

                                    <!-- top-left featured badge -->
                                    <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="10" Padding="8,4" Margin="10" HorizontalOptions="Start" VerticalOptions="Start">
                                        <Label Text="NỔI BẬT" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                    </Frame>


                                    <!-- bottom overlay content -->
                                    <VerticalStackLayout Padding="12" Spacing="6" VerticalOptions="End">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Description}" FontSize="11" TextColor="#DDFFFFFF" MaxLines="2" />

                                        <HorizontalStackLayout Spacing="10">
                                            <Frame BackgroundColor="#AAFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                <Label Text="{Binding DurationText}" FontSize="11" TextColor="{StaticResource PrimaryDark}" />
                                            </Frame>

                                            <Frame BackgroundColor="#AAFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}" FontSize="11" TextColor="{StaticResource PrimaryDark}" />
                                            </Frame>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- All Tours -->
                <Label Text="Tất cả lộ trình"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding AllTours}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">
                            <Frame Padding="0"
                                   Margin="0,5"
                                   CornerRadius="12"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="100,*">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="100"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="15"
                                                         VerticalOptions="Center"
                                                         Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <HorizontalStackLayout Spacing="15">
                                            <Label Text="{Binding DurationText}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"/>
                                            <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"/>
                                        
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
