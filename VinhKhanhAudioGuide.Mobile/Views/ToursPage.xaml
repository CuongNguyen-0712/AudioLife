<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.ToursPage"
             x:DataType="viewmodels:ToursViewModel"
             Title="{ext:Translate Tours_PageTitle}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="15"
                                 Spacing="15">

                <!-- Header -->
                <Label Text="{ext:Translate Tours_HeaderTitle}"
                        TextColor="{StaticResource OnPrimaryContainer}"
                        FontSize="24"
                        FontAttributes="Bold"
                        LineHeight="1.2"/>
                <Label Text="{ext:Translate Tours_HeaderSubtitle}"
                        FontSize="16"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        Opacity="0.7"/>

                <!-- Featured Tours -->
                <Label Text="{ext:Translate Tours_FeaturedTitle}"
                        TextColor="{StaticResource OnPrimaryContainer}"
                        FontSize="22"
                        FontAttributes="Bold"
                        LineHeight="1.2"
                        Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding FeaturedTours}"
                                HeightRequest="220"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">

                            <Frame Padding="0" Margin="0" CornerRadius="15" HeightRequest="220" WidthRequest="285" HasShadow="True">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid>
                                    <!-- full image background -->
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="285" HeightRequest="220" />

                                    <!-- subtle dark overlay for contrast -->
                                    <BoxView BackgroundColor="#33000000" />

                                    <!-- top-left fire icon -->
                                    <Frame BackgroundColor="{StaticResource SecondaryContainer}"
                                           HeightRequest="34"
                                           WidthRequest="34"
                                           Padding="7"
                                           CornerRadius="17"
                                           Margin="10"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Image Source="fire.svg"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>


                                    <!-- bottom overlay content -->
                                        <VerticalStackLayout Padding="12" Spacing="6" VerticalOptions="End">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="#DDFFFFFF" MaxLines="2" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Frame BackgroundColor="#7EFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Image Source="time.svg" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                                        <Label Text="{Binding DurationText}" FontSize="14" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Frame>

                                                <Frame BackgroundColor="#7EFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Image Source="near_me.svg" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                                        <Label Text="{Binding LocationCount, StringFormat={ext:Translate TourDetail_LocationsFormat}}" FontSize="14" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Frame>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- All Tours -->
                <Label Text="{ext:Translate Tours_AllTitle}"
                        TextColor="{StaticResource OnPrimaryContainer}"
                        FontSize="22"
                        FontAttributes="Bold"
                        LineHeight="1.2"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding AllTours}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">
                            <Frame Padding="0"
                            Margin="0,5"
                            CornerRadius="16"
                                   HasShadow="True">
                            <Grid ColumnDefinitions="100,*,Auto"
                               ColumnSpacing="12"
                               Padding="12">
                                 <Frame Style="{StaticResource SurfaceHighlightFrame}"
                                     WidthRequest="100"
                                     HeightRequest="100"
                                     Padding="0"
                                     Margin="0"
                                     BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                     IsClippedToBounds="True">
                                     <Image Source="{Binding ImageUrl}"
                                         Aspect="AspectFill" />
                                 </Frame>
                                    <VerticalStackLayout Grid.Column="1"
                                         Padding="0"
                                                         VerticalOptions="Center"
                                                         Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                     <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                      <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                          <Image Source="time.svg"
                                              WidthRequest="18"
                                              HeightRequest="18"
                                              VerticalOptions="Center" />
                                          <Label Text="{Binding DurationText}"
                                              FontSize="14"
                                              TextColor="{StaticResource OnSurfaceVariant}"
                                              Opacity="0.7"
                                              VerticalOptions="Center" />
                                      </HorizontalStackLayout>

                                      <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                          <Image Source="near_me.svg"
                                              WidthRequest="18"
                                              HeightRequest="18"
                                              VerticalOptions="Center" />
                                          <Label Text="{Binding LocationCount, StringFormat={ext:Translate TourDetail_LocationsFormat}}"
                                              FontSize="14"
                                              TextColor="{StaticResource OnSurfaceVariant}"
                                              Opacity="0.7"
                                              VerticalOptions="Center" />
                                      </HorizontalStackLayout>
                                     </HorizontalStackLayout>
                                    </VerticalStackLayout>
                             <Frame Grid.Column="2"
                                 Style="{StaticResource CardFrameSmall}"
                                 BackgroundColor="{StaticResource SecondaryContainer}"
                                 VerticalOptions="Center"
                                 Padding="8">
                                 <Image Source="chevron_right.svg"
                                     WidthRequest="16"
                                     HeightRequest="16"
                                     Aspect="AspectFit"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                             </Frame>
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>

