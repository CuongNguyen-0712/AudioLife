<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.ToursPage"
             x:DataType="viewmodels:ToursViewModel"
             Title="Tours">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="15"
                                 Spacing="15">

                <!-- Header -->
                <Label Text="Lộ trình tham quan"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <Label Text="Khám phá Hà Nội theo các lộ trình được thiết kế sẵn"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"/>

                <!-- Featured Tours -->
                <Label Text="Lộ trình nổi bật"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding FeaturedTours}"
                                HeightRequest="250"
                                ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">
                            <Frame Padding="0"
                                   Margin="5"
                                   CornerRadius="15"
                                   WidthRequest="280"
                                   HasShadow="True">
                                <Grid RowDefinitions="150,*">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"/>

                                    <!-- Featured Badge -->
                                    <Frame BackgroundColor="{StaticResource Primary}"
                                           CornerRadius="10"
                                           Padding="8,4"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="10">
                                        <Label Text="NỔI BẬT"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                    <!-- Price Badge -->
                                    <Frame Style="{StaticResource PriceBadge}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="10">
                                        <Label Text="{Binding PriceText}"
                                                Style="{StaticResource PriceBadgeText}"/>
                                    </Frame>

                                    <VerticalStackLayout Grid.Row="1"
                                                         Padding="15"
                                                         Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <HorizontalStackLayout Spacing="15">
                                            <HorizontalStackLayout Spacing="5">
                                                <Image Source="time_icon"
                                                       HeightRequest="14"
                                                       WidthRequest="14"/>
                                                <Label Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="5">
                                                <Image Source="location_icon"
                                                       HeightRequest="14"
                                                       WidthRequest="14"/>
                                                <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- All Tours -->
                <Label Text="Tất cả lộ trình"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding AllTours}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TourDisplayModel">
                            <Frame Padding="0"
                                   Margin="0,5"
                                   CornerRadius="12"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="100,*">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="100"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="15"
                                                         VerticalOptions="Center"
                                                         Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <HorizontalStackLayout Spacing="15">
                                            <Label Text="{Binding DurationText}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"/>
                                            <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"/>
                                            <Frame BackgroundColor="{StaticResource AccentLight}"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    HasShadow="False">
                                                <Label Text="{Binding PriceText}"
                                                        FontSize="10"
                                                        TextColor="{StaticResource Accent}"
                                                        FontAttributes="Bold"/>
                                            </Frame>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
