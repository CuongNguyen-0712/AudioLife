<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
    xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
    x:Class="VinhKhanhAudioGuide.Mobile.Views.MainPage"
    x:DataType="viewmodels:MainViewModel"
    x:Name="PageRoot"
    Title="Vinh Khanh Audio Guide">

    <RefreshView
        IsRefreshing="{Binding IsRefreshing}"
        Command="{Binding RefreshCommand}">

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- HERO -->
                <Grid BackgroundColor="{StaticResource Primary}">

                    <Image
                        Source="background.svg"
                        Aspect="AspectFill"
                        ZIndex="0" />

                    <BoxView
                        BackgroundColor="#33000000"
                        ZIndex="1" />

                    <VerticalStackLayout
                        Padding="20,30,20,20"
                        Spacing="10"
                        ZIndex="2">

                        <Label
                            Text="Khám phá ẩm thực Vĩnh Khánh"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            CharacterSpacing="-0.5"
                            FontFamily="NotoSansSemiBold" />

                        <Label
                            Text="Mỗi bước chân, một câu chuyện"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Italic"
                            CharacterSpacing="-0.5"
                            Opacity="0.9" />

                    </VerticalStackLayout>
                </Grid>

                <!-- CONTENT -->
                <VerticalStackLayout Padding="20,15" Spacing="10">

                    <!-- FEATURED -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Nghe nổi bật" Style="{StaticResource SectionHeader}" />

                        <Label
                            Grid.Column="1"
                            Text="Xem tất cả >"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            FontAttributes="Bold"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewAllLocationsCommand}" />
                            </Label.GestureRecognizers>

                        </Label>
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding FeaturedLocations}"
                        HeightRequest="220"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Grid Padding="8">
                                    <Frame CornerRadius="14" HasShadow="True" Padding="0" IsClippedToBounds="True" BackgroundColor="Transparent">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LocationSelectedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <!-- Full image as background -->
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="300" HeightRequest="200"/>

                                            <!-- Overlay gradient to improve text contrast (reduced) -->
                                            <BoxView Opacity="0.18" BackgroundColor="Black" />

                                            <!-- Top-right favorite circular badge only (no border) -->
                                            <Frame BackgroundColor="#CCFFFFFF"
                                                   CornerRadius="18"
                                                   Padding="0"
                                                   WidthRequest="36"
                                                   HeightRequest="36"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Start"
                                                   Margin="0,8,8,0"
                                                   BorderColor="Transparent">
                                                <Button Text="{Binding IsFavorite, Converter={StaticResource BoolToHeartGlyphConverter}}"
                                                        BackgroundColor="Transparent"
                                                        FontSize="14"
                                                        TextColor="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Padding="0"
                                                        HeightRequest="36"
                                                        WidthRequest="36"/>
                                            </Frame>

                                            <!-- Bottom content overlayed on image -->
                                            <VerticalStackLayout VerticalOptions="End" Padding="12" Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="White"/>

                                                <HorizontalStackLayout Spacing="10">
                                                    <Frame BackgroundColor="#AAFFFFFF" CornerRadius="6" Padding="8,4" HasShadow="False" BorderColor="Transparent">
                                                        <Label Text="{Binding Duration, StringFormat='⏱ {0} phút'}" FontSize="12" TextColor="{StaticResource PrimaryDark}"/>
                                                    </Frame>
                                                    <Frame BackgroundColor="#AAFFFFFF" CornerRadius="6" Padding="8,4" HasShadow="False" BorderColor="Transparent">
                                                        <Label Text="{Binding AudioGuideCount, StringFormat='🎧 {0}'}" FontSize="12" TextColor="{StaticResource PrimaryDark}"/>
                                                    </Frame>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    

                    <!-- Near By -->
                    <Label Text="Gần bạn có gì ngon" Style="{StaticResource SectionHeader}" />

                    <CollectionView
                        ItemsSource="{Binding FavoriteLocationsPreview}"
                        SelectionMode="None"
                        HeightRequest="450">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="5" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame
                                    Padding="0"
                                    Margin="6"
                                    CornerRadius="12"
                                    IsClippedToBounds="True"
                                    HasShadow="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=LocationSelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                        <!--item-->
                                    <VerticalStackLayout>
                                        <Image
                                            Source="{Binding ImageUrl}"
                                            Aspect="AspectFill"
                                            HeightRequest="140" />

                                        <VerticalStackLayout Padding="10" Spacing="4">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                           
                                                MaxLines="1" />

                                            <HorizontalStackLayout Spacing="8">
                                                <Label
                                                    Text="{Binding Duration, StringFormat='⏱ {0} phút'}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Gray400}" />

                                                <Label
                                                    Text="{Binding AudioGuideCount, StringFormat='🎧 {0}'}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Gray400}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


             

                    <!-- TOURS -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">

                        <Label Text="Food tour gợi ý" Style="{StaticResource SectionHeader}" />

                        <Label
                            Grid.Column="1"
                            Text="Xem tất cả >"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            FontAttributes="Bold"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewAllToursCommand}" />
                            </Label.GestureRecognizers>

                        </Label>
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding FeaturedTours}"
                        HeightRequest="220"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FeaturedTourItem">

                                <Frame Padding="0" Margin="5,0" CornerRadius="12"  HeightRequest="220" HasShadow="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=TourSelectedCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <Grid>
                                        <!-- full image background -->
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="300" HeightRequest="200"/>

                                        <!-- subtle dark overlay for contrast -->
                                        <BoxView BackgroundColor="#33000000" />

                                      
                                        <!-- bottom overlay content -->
                                        <VerticalStackLayout Padding="12" Spacing="6" VerticalOptions="End">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="{Binding Description}" FontSize="11" TextColor="#DDFFFFFF" MaxLines="2" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Frame BackgroundColor="#AAFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                    <Label Text="{Binding DurationText}" FontSize="11" TextColor="{StaticResource PrimaryDark}" />
                                                </Frame>

                                                <Frame BackgroundColor="#AAFFFFFF" CornerRadius="20" Padding="10,6" HasShadow="False" BorderColor="Transparent">
                                                    <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}" FontSize="11" TextColor="{StaticResource PrimaryDark}" />
                                                </Frame>
                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>