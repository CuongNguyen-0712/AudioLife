<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
    xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
    xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
    xmlns:converters="clr-namespace:VinhKhanhAudioGuide.Mobile.Converters"
    x:Class="VinhKhanhAudioGuide.Mobile.Views.MainPage"
    x:DataType="viewmodels:MainViewModel"
    x:Name="PageRoot"
    Title="{ext:Translate App_Name}">

    <ContentPage.Resources>
        <converters:BoolToChipBackgroundConverter x:Key="BoolToChipBackgroundConverter" />
        <converters:BoolToChipTextColorConverter x:Key="BoolToChipTextColorConverter" />
        <converters:DurationMinutesConverter x:Key="DurationMinutesConverter" />
        <converters:AudioCountConverter x:Key="AudioCountConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Frame
            Grid.Row="0"
            Margin="12,10,12,6"
            Padding="12,10"
            CornerRadius="18"
            HasShadow="True"
            BackgroundColor="{StaticResource SurfaceContainerLowest}"
            BorderColor="{StaticResource OutlineVariant}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Frame
                        WidthRequest="30"
                        HeightRequest="30"
                        Padding="6"
                        CornerRadius="15"
                        HasShadow="False"
                        BackgroundColor="{StaticResource SecondaryContainer}">
                        <Image Source="audio.svg" Aspect="AspectFit" />
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label
                                Text="{Binding FooterStatusText}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource OnSurface}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <BoxView
                                    x:Name="AutoPulseDot"
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    CornerRadius="4"
                                    Color="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding FooterModeText}"
                                    FontSize="10"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <Label
                            Text="{Binding FooterHintText}"
                            FontSize="11"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Button
                        Grid.Column="0"
                        Text="{Binding FooterActionText}"
                        Command="{Binding OpenAutoAudioPlayerCommand}"
                        IsEnabled="{Binding IsFooterActionEnabled}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,6"
                        HeightRequest="34"
                        FontSize="13" />

                    <ImageButton
                        Grid.Column="1"
                        Source="{Binding FooterPlaybackIcon}"
                        Command="{Binding ToggleFooterPlaybackCommand}"
                        IsEnabled="{Binding IsFooterPlaybackEnabled}"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="17"
                        Padding="8"
                        WidthRequest="34"
                        HeightRequest="34"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

        <ScrollView>
            <VerticalStackLayout
                Padding="{StaticResource Space5}"
                Spacing="{StaticResource Space8}">

                <!-- Hero feature -->
                <Frame
                    Style="{StaticResource CardFrameLarge}"
                    IsClippedToBounds="True"
                    Padding="0">

                    <Grid RowDefinitions="320,Auto">
                        <!-- Hero image placeholder -->
                        <Frame
                            Grid.Row="0"
                            Style="{StaticResource SurfaceHighlightFrame}"
                            MinimumHeightRequest="320"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            Padding="0"
                            Margin="0"
                            IsClippedToBounds="True">
                            <Grid>
                                <Image
                                    Source="{Binding HeroImageUrl}"
                                    Aspect="AspectFill" />
                                <BoxView
                                    Color="#8A000000"
                                    InputTransparent="True" />
                            </Grid>
                        </Frame>

                        <!-- Hero content overlay -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Padding="{StaticResource Space4}"
                            VerticalOptions="End"
                            Spacing="{StaticResource Space3}">

                            <Frame
                                Style="{StaticResource ChipSelected}"
                                HorizontalOptions="Start">
                                <Label Text="{ext:Translate Main_FeaturedDish}" Style="{StaticResource ChipTextSelected}" FontSize="12" FontAttributes="Bold" />
                            </Frame>

                            <Label
                                Text="{ext:Translate Main_ExploreTitle}"
                                FontSize="32"
                                FontAttributes="Bold"
                                LineHeight="1.2"
                                TextColor="#FFFFFF" />

                            <Label
                                Text="{ext:Translate Main_ExploreSubtitle}"
                                FontSize="16"
                                LineHeight="1.4"
                                TextColor="#FFFFFF" />

                            <Label
                                Text="{Binding LocationCount, StringFormat={ext:Translate Main_LocationCountFormat}}"
                                FontSize="14"
                                TextColor="#F2F7F7" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
 
                <!-- Search row -->
                <Grid ColumnDefinitions="*">
                    <Frame
                        Style="{StaticResource SurfaceHighlightFrame}"
                        Padding="{StaticResource Space2}">
                        <SearchBar
                            Text="{Binding SearchText}"
                            SearchCommand="{Binding SearchCommand}"
                            Placeholder="{ext:Translate Main_SearchPlaceholder}"
                            BackgroundColor="Transparent"
                            CancelButtonColor="{StaticResource SecondaryContainer}"
                            Style="{StaticResource RoundedSearchBar}" />
                    </Frame>
                </Grid>

                <!-- Category chips -->
                <ScrollView
                    Margin="0,-10,0,0"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout
                        Spacing="{StaticResource Space2}"
                        Padding="{StaticResource ChipRowPadding}"
                        BindableLayout.ItemsSource="{Binding Categories}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Frame
                                    Style="{StaticResource Chip}"
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToChipBackgroundConverter}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CategorySelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout  VerticalOptions="Center">
                                        <Image
                                            Source="{Binding Icon}"
                                            WidthRequest="20"
                                            HeightRequest="20"
                                            VerticalOptions="Center">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding Icon}" Value="">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Label
                                            Text="{Binding Name}"
                                            Style="{StaticResource ChipText}"
                                            TextColor="{Binding IsSelected, Converter={StaticResource BoolToChipTextColorConverter}}" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Must Try section -->
                <VerticalStackLayout Spacing="{StaticResource Space4}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                            <Label 
                                Text="{ext:Translate Main_MustTryTitle}" 
                                TextColor="{StaticResource OnPrimaryContainer}"
                                FontSize="22"
                                FontAttributes="Bold"
                                LineHeight="1.2"
                                Margin="0" />
                            <Label 
                                Text="{ext:Translate Main_MustTrySubtitle}" 
                                FontSize="16"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                Opacity="0.7" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="{ext:Translate Main_ViewAll}"
                            Style="{StaticResource LinkText}"
                            FontSize="14"
                            FontAttributes="Bold"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllLocationsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding FeaturedLocations}"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None"
                        HeightRequest="280">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame
                                    Style="{StaticResource CardFrameLarge}"
                                    WidthRequest="280"
                                    Margin="0,0,12,0"
                                    Padding="{StaticResource Space3}">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.LocationSelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                                        <!-- Item image placeholder -->
                                        <Grid>
                                            <Frame
                                                Style="{StaticResource SurfaceHighlightFrame}"
                                                HeightRequest="180"
                                                Padding="0"
                                                Margin="0"
                                                BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                                IsClippedToBounds="True">
                                                <Image
                                                    Source="{Binding ImageUrl}"
                                                    HeightRequest="180"
                                                    Aspect="AspectFill" />
                                            </Frame>

                                            <ImageButton
                                                Source="heart_no_fill.svg"
                                                BackgroundColor="{StaticResource SecondaryContainer}"
                                                HeightRequest="34"
                                                WidthRequest="34"
                                                Padding="7"
                                                CornerRadius="17"
                                                Margin="10"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding .}">
                                                <ImageButton.Triggers>
                                                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Source" Value="heart_filled.svg" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsFavorite}" Value="False">
                                                        <Setter Property="Source" Value="heart_no_fill.svg" />
                                                    </DataTrigger>
                                                </ImageButton.Triggers>
                                            </ImageButton>
                                        </Grid>

                                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                LineHeight="1.2"
                                                MaxLines="2"
                                                Margin="0" />
                                            <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                                <Image Source="time.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding Duration, Converter={StaticResource DurationMinutesConverter}}"
                                                    FontSize="13"
                                                    TextColor="{StaticResource OnSurfaceVariant}"
                                                    Opacity="0.7" />
                                                
                                                <Image Source="audio.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding AudioGuideCount, Converter={StaticResource AudioCountConverter}}"
                                                    FontSize="13"
                                                    TextColor="{StaticResource OnSurfaceVariant}"
                                                    Opacity="0.7" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Popular Eateries section -->
                <VerticalStackLayout Spacing="{StaticResource Space4}">
                    <VerticalStackLayout Spacing="{StaticResource Space2}">
                        <Label 
                            Text="{ext:Translate Main_PopularTitle}" 
                            TextColor="{StaticResource OnPrimaryContainer}"
                            FontSize="22"
                            FontAttributes="Bold"
                            LineHeight="1.2"
                            Margin="0" />
                        <Label 
                            Text="{ext:Translate Main_PopularSubtitle}" 
                            FontSize="16"
                            TextColor="{StaticResource OnSurfaceVariant}"
                            Opacity="0.7" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="{StaticResource Space4}"
                        BindableLayout.ItemsSource="{Binding FavoriteLocationsPreview}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame Style="{StaticResource CardFrame}" Padding="{StaticResource Space3}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.LocationSelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                                        <!-- Row image placeholder -->
                                        <Frame
                                            Style="{StaticResource SurfaceHighlightFrame}"
                                            WidthRequest="80"
                                            HeightRequest="80"
                                            Padding="0"
                                            Margin="0"
                                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                            IsClippedToBounds="True">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                Aspect="AspectFill" />
                                        </Frame>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="{StaticResource Space2}"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                LineHeight="1.2"
                                                MaxLines="2"
                                                Margin="0" />

                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Image Source="time.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding Duration, Converter={StaticResource DurationMinutesConverter}}"
                                                    FontSize="13"
                                                    TextColor="{StaticResource OnSurfaceVariant}"
                                                    Opacity="0.7"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Image Source="audio.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding AudioGuideCount, Converter={StaticResource AudioCountConverter}}"
                                                    FontSize="13"
                                                    TextColor="{StaticResource OnSurfaceVariant}"
                                                    Opacity="0.7"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Action placeholder (no icon) -->
                                        <Frame
                                            Grid.Column="2"
                                            Style="{StaticResource CardFrameSmall}"
                                            BackgroundColor="{StaticResource SecondaryContainer}"
                                            VerticalOptions="Center"
                                            Padding="8">
                                            <Image
                                                Source="chevron_right.svg"
                                                WidthRequest="16"
                                                HeightRequest="16"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Floating action placeholder -->
                <!-- <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <Frame
                        Grid.Column="1"
                        Style="{StaticResource CardFrameLarge}"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="28"
                        HeightRequest="56"
                        WidthRequest="56"
                        Padding="0">
                        <Label Text="" Style="{StaticResource CaptionText}" TextColor="{StaticResource OnPrimary}" />
                    </Frame>
                </Grid> -->
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    </Grid>
</ContentPage>

