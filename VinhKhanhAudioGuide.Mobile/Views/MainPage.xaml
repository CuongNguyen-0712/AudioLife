<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Vinh Khanh Audio Guide">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="0"
                                 Spacing="0">

                <!-- Hero Section (matching web hero-section) -->
                <Grid BackgroundColor="{StaticResource Primary}"
                      Padding="20,30,20,20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Khám phá Hà Nội"
                               TextColor="White"
                               FontSize="28"
                               FontAttributes="Bold"/>
                        <Label Text="qua từng câu chuyện"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               Opacity="0.9"/>
                        <Label Text="Audio guide du lịch thông minh — Lắng nghe lịch sử, văn hóa và những câu chuyện thú vị"
                               TextColor="White"
                               FontSize="13"
                               Opacity="0.8"
                               Margin="0,5,0,10"/>

                        <!-- Hero Stats (matching web) -->
                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="8">
                            <Frame Grid.Column="0"
                                   Style="{StaticResource StatCard}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding LocationCount}"
                                           Style="{StaticResource StatNumber}"/>
                                    <Label Text="Địa điểm"
                                           Style="{StaticResource StatLabel}"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1"
                                   Style="{StaticResource StatCard}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding AudioGuideCount}"
                                           Style="{StaticResource StatNumber}"/>
                                    <Label Text="Audio Guide"
                                           Style="{StaticResource StatLabel}"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="2"
                                   Style="{StaticResource StatCard}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding TourCount}"
                                           Style="{StaticResource StatNumber}"/>
                                    <Label Text="Tours"
                                           Style="{StaticResource StatLabel}"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="3"
                                   Style="{StaticResource StatCard}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding CategoryCount}"
                                           Style="{StaticResource StatNumber}"/>
                                    <Label Text="Danh mục"
                                           Style="{StaticResource StatLabel}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Padding="20,15"
                                     Spacing="15">

                    <!-- Search Bar -->
                    <SearchBar Placeholder="Tìm kiếm địa điểm, tour du lịch..."
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}"/>

                    <!-- Categories -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Danh mục"
                               FontSize="20"
                               FontAttributes="Bold"/>
                        <Label Grid.Column="1"
                               Text="Xem tất cả >"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllLocationsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding Categories}"
                                    HeightRequest="110"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Frame Padding="12"
                                       Margin="5,0"
                                       CornerRadius="12"
                                       WidthRequest="100"
                                       BackgroundColor="{StaticResource Secondary}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=CategorySelectedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Spacing="4">
                                        <Image Source="{Binding Icon}"
                                               HeightRequest="36"
                                               WidthRequest="36"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding Name}"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>
                                        <Label Text="{Binding LocationCount, StringFormat='{0} địa điểm'}"
                                               HorizontalOptions="Center"
                                               FontSize="10"
                                               TextColor="{StaticResource Gray500}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Featured Locations -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Địa điểm nổi bật"
                               FontSize="20"
                               FontAttributes="Bold"/>
                        <Label Grid.Column="1"
                               Text="Xem tất cả >"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllLocationsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding FeaturedLocations}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame Padding="0"
                                       Margin="0,5"
                                       CornerRadius="12"
                                       HasShadow="True"
                                       IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=LocationSelectedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="90,*">
                                        <!-- Gradient placeholder (matches web) -->
                                        <BoxView BackgroundColor="{StaticResource Primary}"
                                                 Opacity="0.8"/>
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="90"
                                               WidthRequest="90"/>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Padding="12,8"
                                                             VerticalOptions="Center"
                                                             Spacing="3">
                                            <Label Text="{Binding CategoryName}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextColor="Gray"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"/>
                                            <HorizontalStackLayout Spacing="12">
                                                <Label Text="{Binding Duration, StringFormat='⏱ {0} phút'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Primary}"/>
                                                <Label Text="{Binding AudioGuideCount, StringFormat='🎧 {0} audio'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Featured Tours (NEW - matching web) -->
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,10,0,0">
                        <Label Text="Tours nổi bật"
                               FontSize="20"
                               FontAttributes="Bold"/>
                        <Label Grid.Column="1"
                               Text="Xem tất cả >"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllToursCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding FeaturedTours}"
                                    HeightRequest="220"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FeaturedTourItem">
                                <Frame Padding="0"
                                       Margin="5,0"
                                       CornerRadius="12"
                                       WidthRequest="260"
                                       HasShadow="True"
                                       IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=TourSelectedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Grid RowDefinitions="110,*">
                                        <!-- Tour gradient header -->
                                        <BoxView BackgroundColor="{StaticResource Primary}"
                                                 Opacity="0.7"/>
                                        <Label Text="⭐"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="White"/>
                                        <!-- Featured badge -->
                                        <Frame BackgroundColor="{StaticResource Accent}"
                                               CornerRadius="10"
                                               Padding="8,4"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Start"
                                               Margin="10"
                                               HasShadow="False">
                                            <Label Text="NỔI BẬT"
                                                   TextColor="White"
                                                   FontSize="9"
                                                   FontAttributes="Bold"/>
                                        </Frame>

                                        <VerticalStackLayout Grid.Row="1"
                                                             Padding="12,8"
                                                             Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"/>
                                            <HorizontalStackLayout Spacing="12">
                                                <Label Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                                <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding PriceText}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Accent}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Nearby / More Locations -->
                    <Label Text="Khám phá thêm"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"/>

                    <CollectionView ItemsSource="{Binding MoreLocations}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame Padding="0"
                                       Margin="5,0"
                                       CornerRadius="12"
                                       WidthRequest="160"
                                       HasShadow="True"
                                       IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=LocationSelectedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <BoxView BackgroundColor="{StaticResource Tertiary}"
                                                 HeightRequest="120"
                                                 Opacity="0.6"/>
                                        <VerticalStackLayout Padding="10"
                                                             Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Duration, StringFormat='⏱ {0} phút'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Primary}"/>
                                                <Label Text="{Binding AudioGuideCount, StringFormat='🎧 {0}'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
