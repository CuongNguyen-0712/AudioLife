<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.StartupLoadingPage"
             BackgroundColor="#13696D"
             Shell.NavBarIsVisible="False">

    <Grid Padding="32">
        <VerticalStackLayout Spacing="20"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Image Source="splash.svg"
                   WidthRequest="220"
                   HeightRequest="220"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="True"
                               Color="White"
                               WidthRequest="36"
                               HeightRequest="36"
                               HorizontalOptions="Center" />

            <Label Text="{ext:Translate Common_Loading}"
                   FontFamily="RobotoCondensed-Medium"
                   FontSize="16"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
