<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.AboutPage"
             x:DataType="viewmodels:AboutViewModel"
             Title="{ext:Translate About_PageTitle}">

        <Grid>
                <ScrollView IsVisible="{Binding HasData}">
                        <VerticalStackLayout Spacing="0"> 
              

            <!-- Hero gradient header -->
            <Grid HeightRequest="200">
                <BoxView BackgroundColor="{StaticResource Secondary}"/>
                <VerticalStackLayout HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="5">
                        <Image Source="tour_color.svg" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center"/>
                    <!-- <Label Text="🎧"
                            FontSize="40"
                            HorizontalOptions="Center"/> -->
                    <Label Text="Vinh Khanh Audio Guide"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                      <Label Text="{Binding AppVersion, StringFormat={ext:Translate About_VersionFormat}}"
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.85"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="20"
                    Spacing="20">

                <!-- Stats Row -->
                <Grid ColumnDefinitions="*,*,*"
                        ColumnSpacing="10">
                    <Frame Grid.Column="0"
                            Style="{StaticResource StatCard}"
                            BackgroundColor="{StaticResource SecondaryContainer}">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="2">
                            <Label Text="{Binding LocationCount, StringFormat='{0}'}"
                                    Style="{StaticResource StatNumber}"/>
                            <Label Text="{ext:Translate About_StatLocations}"
                                    Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1"
                            Style="{StaticResource StatCard}"
                            BackgroundColor="{StaticResource SecondaryContainer}">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="2">
                            <Label Text="{Binding AudioCount, StringFormat='{0}'}"
                                    Style="{StaticResource StatNumber}"/>
                            <Label Text="{ext:Translate About_StatAudio}"
                                    Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2"
                            Style="{StaticResource StatCard}"
                            BackgroundColor="{StaticResource SecondaryContainer}">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="2">
                            <Label Text="{Binding TourCount, StringFormat='{0}'}"
                                    Style="{StaticResource StatNumber}"/>
                            <Label Text="{ext:Translate About_StatTours}"
                                    Style="{StaticResource StatLabel}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Description -->
                  <Label Text="{ext:Translate About_Description}"
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center"/>

                <Grid Style="{StaticResource LayerDivider}"/>

                <!-- How It Works Steps -->
                  <Label Text="{ext:Translate About_HowToUse}"
                       FontSize="18"
                       FontAttributes="Bold"/>

                <VerticalStackLayout Spacing="0">
                    <!-- Step 1 -->
                    <Grid ColumnDefinitions="44,*"
                            Padding="0,0,0,0">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="0">
                            <Frame Style="{StaticResource TimelineNumber}">
                                <Label Text="1"
                                        TextColor="White"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Frame>
                            <BoxView Style="{StaticResource TimelineLine}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                Padding="10,0,0,15"
                                Spacing="2">
                            <Label Text="{ext:Translate About_Step1Title}"
                                    FontSize="14"
                                    FontAttributes="Bold"/>
                            <Label Text="{ext:Translate About_Step1Description}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"/>
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Step 2 -->
                    <Grid ColumnDefinitions="44,*"
                            Padding="0,0,0,0">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="0">
                            <Frame Style="{StaticResource TimelineNumber}">
                                <Label Text="2"
                                        TextColor="White"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Frame>
                            <BoxView Style="{StaticResource TimelineLine}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                Padding="10,0,0,15"
                                Spacing="2">
                            <Label Text="{ext:Translate About_Step2Title}"
                                    FontSize="14"
                                    FontAttributes="Bold"/>
                            <Label Text="{ext:Translate About_Step2Description}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"/>
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Step 3 -->
                    <Grid ColumnDefinitions="44,*"
                            Padding="0,0,0,0">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="0">
                            <Frame Style="{StaticResource TimelineNumber}">
                                <Label Text="3"
                                        TextColor="White"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                Padding="10,0,0,15"
                                Spacing="2">
                            <Label Text="{ext:Translate About_Step3Title}"
                                    FontSize="14"
                                    FontAttributes="Bold"/>
                            <Label Text="{ext:Translate About_Step3Description}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Grid Style="{StaticResource LayerDivider}"/>

                <!-- Feature Grid -->
                  <Label Text="{ext:Translate About_FeaturesTitle}"
                       FontSize="18"
                       FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="10">
                    <Frame Grid.Row="0"
                            Grid.Column="0"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="📍"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureLocations}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="0"
                            Grid.Column="1"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="🎧"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureAudioHd}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1"
                            Grid.Column="0"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="🌐"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureMultilingual}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1"
                            Grid.Column="1"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="📥"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureOffline}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="2"
                            Grid.Column="0"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="🗺"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureMap}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="2"
                            Grid.Column="1"
                            CornerRadius="12"
                            Padding="15"
                            BackgroundColor="{StaticResource SecondaryContainer}"
                            HasShadow="False">
                        <VerticalStackLayout HorizontalOptions="Center"
                                Spacing="5">
                            <Label Text="🛤"
                                    FontSize="24"
                                    HorizontalOptions="Center"/>
                            <Label Text="{ext:Translate About_FeatureRoutes}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Links -->
                <VerticalStackLayout Spacing="10"
                        Margin="0,10,0,0">
                    <Button Text="{ext:Translate About_RateApp}"
                            Command="{Binding RateAppCommand}"
                            Style="{StaticResource PrimaryButton}"/>

                    <Button Text="{ext:Translate About_ShareApp}"
                            Command="{Binding ShareAppCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </VerticalStackLayout>

                <!-- Legal -->
                <VerticalStackLayout Spacing="10"
                        HorizontalOptions="Center">
                      <Label Text="{ext:Translate About_Terms}"
                           Style="{StaticResource LinkText}"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTermsCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                      <Label Text="{ext:Translate About_Privacy}"
                           Style="{StaticResource LinkText}"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                  <Label Text="{ext:Translate About_Copyright}"
                       FontSize="11"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       Margin="0,10,0,20"/>

            </VerticalStackLayout>
                        </VerticalStackLayout>
                </ScrollView>

                <Grid IsVisible="{Binding IsLoading}"
                          BackgroundColor="{StaticResource Background}"
                          Opacity="0.96">
                        <VerticalStackLayout VerticalOptions="Center"
                                                                 HorizontalOptions="Center"
                                                                 Spacing="12">
                                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
                                <Label Text="{ext:Translate About_Loading}"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsError}"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Padding="30"
                                                         Spacing="10">
                        <Label Text="{ext:Translate About_LoadError}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
        </Grid>

</ContentPage>

