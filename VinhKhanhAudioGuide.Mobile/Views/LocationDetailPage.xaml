                            <!-- Start Button -->
                            <Button Text="{ext:Translate LocationDetail_StartListeningButton}"
                                   TextColor="{StaticResource Primary}"
                                   BackgroundColor="{StaticResource PrimaryContainer}"
                                    Command="{Binding StartListeningCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,20,0,0"/>

                     </VerticalStackLayout>
              </VerticalStackLayout>
       </ScrollView>

</ContentPage>

