<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.LocationDetailPage"
             x:DataType="viewmodels:LocationDetailViewModel"
             Title="{Binding Title}">

       <ScrollView>
              <VerticalStackLayout Spacing="0">

                     <!-- Location Image / Hero -->
                     <Grid HeightRequest="250">
                            <BoxView BackgroundColor="{StaticResource Primary}"
                                          Opacity="0.7"/>
                            <Image Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="250"/>
                            <!-- Overlay text -->
                            <VerticalStackLayout VerticalOptions="End"
                                          Padding="20,0,20,15">
                                   <Label Text="{Binding LocationName}"
                                          TextColor="White"
                                          FontSize="26"
                                          FontAttributes="Bold"/>
                                   <Label Text="{Binding Address}"
                                          TextColor="White"
                                          FontSize="12"
                                          Opacity="0.9"/>
                            </VerticalStackLayout>
                     </Grid>

                     <VerticalStackLayout Padding="20"
                                   Spacing="15">

                            <!-- Info Bar (matching web detail-info-bar) -->
                            <Grid ColumnDefinitions="*,*,*,*"
                                          ColumnSpacing="8">
                                   <Frame Grid.Column="0"
                                                 Style="{StaticResource InfoBarFrame}">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                        Spacing="2">
                                                 <Image Source="time.svg"
                                                        HeightRequest="18"
                                                        WidthRequest="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="{ext:Translate LocationDetail_DurationLabel}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource OnSecondaryContainer}"
                                                               HorizontalOptions="Center"/>
                                                 <Label Text="{Binding Duration, StringFormat={ext:Translate Common_MinutesFormat}}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>
                                   <Frame Grid.Column="1"
                                                 Style="{StaticResource InfoBarFrame}">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                        Spacing="2">
                                                 <Image Source="audio.svg"
                                                        HeightRequest="18"
                                                        WidthRequest="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="{ext:Translate LocationDetail_AudioLabel}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource OnSecondaryContainer}"
                                                               HorizontalOptions="Center"/>
                                                 <Label Text="{Binding AudioGuideCountText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>
                                   <Frame Grid.Column="2"
                                                 Style="{StaticResource InfoBarFrame}">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                        Spacing="2">
                                                 <Image Source="tags.svg"
                                                        HeightRequest="18"
                                                        WidthRequest="18"
                                                        HorizontalOptions="Center"/>
                                                 <Label Text="{ext:Translate LocationDetail_CategoryLabel}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource OnSecondaryContainer}"
                                                               HorizontalOptions="Center"/>
                                                 <Label Text="{Binding CategoryName}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"
                                                               LineBreakMode="TailTruncation"/>
                                          </VerticalStackLayout>
                                   </Frame>
                                   <Frame Grid.Column="3"
                                                 Style="{StaticResource InfoBarFrame}">
                                          <VerticalStackLayout HorizontalOptions="Center"
                                                        Spacing="2">
                                                 <Image Source="language_icon.svg"
                                                        HeightRequest="18"
                                                        WidthRequest="18"
                                                        HorizontalOptions="Center"/>  
                                                 <Label Text="{ext:Translate LocationDetail_LanguageLabel}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource OnSecondaryContainer}"
                                                               HorizontalOptions="Center"/>
                                                 <Label Text="{ext:Translate Language_Option_Vietnamese}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center"/>
                                          </VerticalStackLayout>
                                   </Frame>
                            </Grid>

                            <Grid Style="{StaticResource LayerDivider}"/>

                            <!-- Description -->
                            <Label Text="{ext:Translate LocationDetail_OverviewTitle}"
                                   FontSize="22"
                                   TextColor="{StaticResource OnPrimaryContainer}"
                                   FontAttributes="Bold"/>

                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="{StaticResource OnSurfaceVariant}"/>

                            <!-- Audio Guides -->
                            <Label Text="{ext:Translate LocationDetail_AudioGuideTitle}"
                                   FontSize="22"
                                   TextColor="{StaticResource OnPrimaryContainer}"
                                   FontAttributes="Bold"
                                   Margin="0,10,0,0"/>
                            <Label Text="{ext:Translate LocationDetail_AudioGuideSubtitle}"
                                   FontSize="14"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   Margin="0,0,0,5"/>

                            <CollectionView ItemsSource="{Binding AudioGuides}">
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate x:DataType="models:AudioGuide">
                                                 <Frame Padding="12"
                                                        Margin="0,4"
                                                        CornerRadius="10"
                                                        BorderColor="{StaticResource PrimaryContainer}">
                                                        <Frame.GestureRecognizers>
                                                               <TapGestureRecognizer
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LocationDetailViewModel}}, Path=PlayAudioCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                        </Frame.GestureRecognizers>
                                                        <Grid ColumnDefinitions="44,*,Auto">
                                                               <Frame BackgroundColor="{StaticResource PrimaryContainer}"
                                                                      CornerRadius="22"
                                                                      Padding="0"
                                                                      HeightRequest="44"
                                                                      WidthRequest="44"
                                                                      HasShadow="False">
                                                                      <Label Text="▶"
                                                                             TextColor="{StaticResource Primary}"
                                                                             FontSize="16"
                                                                             HorizontalOptions="Center"
                                                                             VerticalOptions="Center"/>
                                                               </Frame>
                                                               <VerticalStackLayout Grid.Column="1"
                                                                                    Padding="12,0"
                                                                                    VerticalOptions="Center"
                                                                             Spacing="2">
                                                                      <Label Text="{Binding Title}"
                                                                             FontSize="16"
                                                                             FontAttributes="Bold"/>
                                                                      <Label Text="{Binding Description}"
                                                                             FontSize="14"
                                                                             TextColor="{StaticResource OnSurfaceVariant}"
                                                                             LineBreakMode="TailTruncation"/>
                                                               </VerticalStackLayout>
                                                               <HorizontalStackLayout Grid.Column="2"
                                                                                      Spacing="4"
                                                                                      VerticalOptions="Center">
                                                                      <Image Source="time.svg"
                                                                             HeightRequest="14"
                                                                             WidthRequest="14"
                                                                             VerticalOptions="Center"/>
                                                                      <Label Text="{Binding Duration, StringFormat={ext:Translate Common_MinutesFormat}}"
                                                                             FontSize="14"
                                                                             TextColor="{StaticResource OnSecondaryContainer}"
                                                                             VerticalOptions="Center"/>
                                                               </HorizontalStackLayout>
                                                        </Grid>
                                                 </Frame>
                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>


                     <!-- ĐỪNG XÓA CODE NHÉ, CÒN PHẦN MAP VÀ TOUR LIÊN QUAN NỮA, ĐỂ TÔI XEM CÓ THỂ LÀM GÌ KHÔNG! -->


                            <!-- Map Embed (matching web sidebar map) -->
