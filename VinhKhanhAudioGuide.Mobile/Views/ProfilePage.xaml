<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             BackgroundColor="{StaticResource Surface}"
             Title="Tài khoản">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Margin="20,40,20,40">
            
            <!-- Account & Settings Header -->
            <Grid Margin="-4,10,0,0">
                <BoxView WidthRequest="4" BackgroundColor="{StaticResource Primary}" HorizontalOptions="Start" CornerRadius="2" />
            </Grid>

            <VerticalStackLayout Spacing="16">
                
                <!-- Profile Edit Card -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerLowest}" 
                       CornerRadius="24" 
                       Padding="20" 
                       HasShadow="True">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                        
                        <!-- Avatar placeholder with primary tint -->
                        <Grid WidthRequest="64" HeightRequest="64" Grid.Column="0">
                            <Frame CornerRadius="16" BackgroundColor="{StaticResource PrimaryContainer}" Opacity="0.2" Padding="0" HasShadow="False" />
                            <!-- Fallback Emoji if Avatar is missing -->
                            <Label Text="👤" FontSize="36" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Frame CornerRadius="16" Padding="0" HasShadow="False" BackgroundColor="Transparent" IsClippedToBounds="True">
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                            </Frame>
                        </Grid>

                        <!-- Details -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="{Binding UserName}" FontFamily="RobotoCondensed-SemiBold" FontSize="16" TextColor="{StaticResource OnSurface}" />
                            <Label Text="{Binding Email}" FontSize="12" FontFamily="RobotoCondensed-Regular" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <!-- Edit Button -->
                        <Grid Grid.Column="2" WidthRequest="32" HeightRequest="32">
                            <ImageButton Source="edit_square.png" Command="{Binding EditProfileCommand}" BackgroundColor="Transparent" />
                            <!-- Fallback icon character -->
                            <Label Text="✎" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" Margin="0,-4,0,0" />
                        </Grid>
                    </Grid>
                </Frame>

                <!-- Toggle Controls (Language & Dark Mode) -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" 
                       CornerRadius="32" 
                       Padding="8" 
                       HasShadow="False">
                    <VerticalStackLayout Spacing="0">
                        <!-- Language Selection -->
                        <Grid ColumnDefinitions="*, Auto" Padding="16,16">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="A/文" FontSize="18" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                                <Label Text="Ngôn ngữ" FontFamily="RobotoCondensed-Medium" FontSize="14" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            
                            <!-- Toggle indicator -->
                            <Frame Grid.Column="1" BackgroundColor="{StaticResource SurfaceContainerHighest}" CornerRadius="20" Padding="4" HasShadow="False" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="EN" FontFamily="RobotoCondensed-SemiBold" FontSize="10" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" Margin="8,0" />
                                    <!-- Selected state -->
                                    <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="16" Padding="12,4" HasShadow="False">
                                        <Label Text="VN" FontFamily="RobotoCondensed-SemiBold" FontSize="10" TextColor="{StaticResource OnPrimary}" />
                                    </Frame>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                        
                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainerHighest}" Margin="16,0" />

                        <!-- Appearance -->
                        <Grid ColumnDefinitions="*, Auto" Padding="16,16">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Image Source="nightmode.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                <Label Text="Chế độ tối" FontFamily="RobotoCondensed-Medium" FontSize="14" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <!-- Fake switch indicator imitating the design -->
                            <Frame Grid.Column="1" WidthRequest="48" HeightRequest="24" CornerRadius="12" Padding="2" BackgroundColor="{StaticResource SurfaceContainerHighest}" HasShadow="False" VerticalOptions="Center">
                                <BoxView WidthRequest="20" HeightRequest="20" CornerRadius="10" Color="White" HorizontalOptions="Start">
                                    <BoxView.Shadow>
                                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="4" />
                                    </BoxView.Shadow>
                                </BoxView>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
                
                <!-- About & Info Grid -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,10,0,0">
                    <!-- About Guide -->
                    <Frame Grid.Column="0" CornerRadius="24" Padding="24" HasShadow="False" BorderColor="Transparent">
                        <Frame.Background>
                            <SolidColorBrush Color="{StaticResource SecondaryContainer}" />
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAboutCommand}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="16">
                            <Image Source="info_more.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start" />
                            <Label Text="Về ứng dụng" FontFamily="RobotoCondensed-SemiBold" FontSize="16" TextColor="{StaticResource OnSecondaryContainer}" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Help Center -->
                    <Frame Grid.Column="1" CornerRadius="24" Padding="24" HasShadow="False" BorderColor="Transparent">
                        <Frame.Background>
                            <SolidColorBrush Color="{StaticResource PrimaryContainer}" />
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToHelpCommand}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="16">
                            <Image Source="help.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start" />
                            <Label Text="Trợ giúp" FontFamily="RobotoCondensed-SemiBold" FontSize="16" TextColor="{StaticResource OnSecondaryContainer}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
                
                <!-- Logout Button -->
                <Button Text="Đăng xuất"
                        Style="{StaticResource OutlineButton}"
                        TextColor="{StaticResource Error}"
                        BorderColor="{StaticResource Error}"
                        BorderWidth="1"
                        Margin="0,30,0,0"
                        Command="{Binding LogoutCommand}"/>
                        
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
