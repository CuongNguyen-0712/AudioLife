<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             Title="Tài khoản">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- Profile Header -->
            <Frame BackgroundColor="{StaticResource Primary}"
                   Padding="20"
                   CornerRadius="20"
                   HasShadow="True">
                <Grid ColumnDefinitions="80,*" ColumnSpacing="15">
                    <!-- Avatar -->
                    <Frame CornerRadius="40"
                           Padding="0"
                           HeightRequest="80"
                           WidthRequest="80"
                           IsClippedToBounds="True">
                        <Image Source="{Binding AvatarUrl}" 
                               Aspect="AspectFill"/>
                    </Frame>
                    
                    <VerticalStackLayout Grid.Column="1" 
                                         VerticalOptions="Center"
                                         Spacing="5">
                        <Label Text="{Binding UserName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="{Binding Email}"
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.8"/>
                        <Button Text="Chỉnh sửa"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32"
                                FontSize="12"
                                Padding="15,5"
                                HorizontalOptions="Start"
                                Command="{Binding EditProfileCommand}"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Statistics -->
            <Frame CornerRadius="15" Padding="15" HasShadow="True">
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding VisitedCount}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Đã tham quan"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="{Binding FavoritesCount}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Yêu thích"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="{Binding DownloadedCount}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Đã tải"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Menu Items -->
            <Frame CornerRadius="15" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <!-- Favorites -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="heart_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Địa điểm yêu thích"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToFavoritesCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Downloads -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="download_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Audio đã tải"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToDownloadsCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- History -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="history_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Lịch sử nghe"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToHistoryCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Settings -->
            <Frame CornerRadius="15" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <!-- Settings -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="settings_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Cài đặt"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Help -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="help_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Trợ giúp"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToHelpCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- About -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Frame BackgroundColor="{StaticResource Secondary}"
                                   CornerRadius="10"
                                   Padding="8"
                                   HeightRequest="40"
                                   WidthRequest="40">
                                <Image Source="info_icon" HeightRequest="20" WidthRequest="20"/>
                            </Frame>
                            <Label Grid.Column="1" 
                                   Text="Về ứng dụng"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>
                            <Image Grid.Column="2" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAboutCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Logout Button -->
            <Button Text="Đăng xuất"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{StaticResource Gray600}"
                    Command="{Binding LogoutCommand}"
                    Margin="0,10"/>

            <!-- Version -->
            <Label Text="Phiên bản 1.0.0"
                   FontSize="12"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
