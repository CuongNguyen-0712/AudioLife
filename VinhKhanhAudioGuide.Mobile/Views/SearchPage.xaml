<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.SearchPage"
             x:DataType="viewmodels:SearchViewModel"
             x:Name="SearchRoot"
             Title="Kết quả"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>
        <Grid>
            <VerticalStackLayout Spacing="0">
                <Frame IsVisible="{Binding ShowResultContextTitle}"
                       Margin="14,12,14,0"
                       Padding="12,8"
                       CornerRadius="12"
                       HasShadow="False"
                       BackgroundColor="{StaticResource SurfaceContainerLowest}">
                    <Label Text="{Binding ResultContextTitle}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                </Frame>

                <CollectionView IsVisible="{Binding ShowResults}"
                                ItemsSource="{Binding SearchResults}"
                                SelectionMode="None"
                                Margin="10,10,10,8">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:SearchResultItem">
                            <Frame Style="{StaticResource CardFrame}"
                                   Padding="{StaticResource Space3}"
                                   Margin="0,6">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.LocationSelectedCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                                    <Frame Style="{StaticResource SurfaceHighlightFrame}"
                                           WidthRequest="80"
                                           HeightRequest="80"
                                           Padding="0"
                                           Margin="0"
                                           BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                           IsClippedToBounds="True">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="{StaticResource Space2}"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineHeight="1.2"
                                               MaxLines="2"
                                               Margin="0" />

                                        <Label Text="{Binding CategoryName}"
                                               FontSize="13"
                                               TextColor="{StaticResource Primary}" />

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="time.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                            <Label Text="{Binding DurationDisplay}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   Opacity="0.7"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="audio.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                            <Label Text="{Binding CountDisplay}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   Opacity="0.7"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Frame Grid.Column="2"
                                           Style="{StaticResource CardFrameSmall}"
                                           BackgroundColor="{StaticResource SecondaryContainer}"
                                           VerticalOptions="Center"
                                           Padding="8">
                                        <Image Source="chevron_right.svg"
                                               WidthRequest="16"
                                               HeightRequest="16"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowNoResults}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="32"
                                 Spacing="6">
                <Label Text="Không có kết quả phù hợp"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Hãy thử từ khóa khác hoặc thay đổi bộ lọc."
                       FontSize="13"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
