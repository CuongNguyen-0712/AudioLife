<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	      xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
	      xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
	      x:Class="VinhKhanhAudioGuide.Mobile.Views.QrScannerPage"
	      Title="{ext:Translate Qr_PageTitle}"
	      BackgroundColor="{StaticResource Primary}"
	      NavigationPage.HasNavigationBar="True">

    <NavigationPage.TitleView>
		<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
			<ImageButton Source="back_arrow.svg"
					 WidthRequest="24"
					 HeightRequest="24"
					 Padding="2"
					 BackgroundColor="Transparent"
					 Clicked="OnBackToIntroClicked" />
			<Image Source="qr.svg" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
			<Label Text="{ext:Translate Qr_PageTitle}"
				   FontFamily="RobotoCondensed-SemiBold"
				   FontSize="20"
				   TextColor="{StaticResource Primary}"
				   VerticalOptions="Center" />
		</HorizontalStackLayout>
	</NavigationPage.TitleView>

    <Grid>
	 <zxing:CameraBarcodeReaderView x:Name="ScannerView"
					    IsDetecting="False"
					    IsEnabled="True"
					    BarcodesDetected="OnBarcodesDetected" />

	 <Grid Padding="24,48,24,28"
		RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
		RowSpacing="10">
	     <Grid Grid.Row="0" ColumnDefinitions="*">
		  <Border
			  StrokeThickness="0"
			  BackgroundColor="#1AFFFFFF"
			  Padding="12,10"
			  HorizontalOptions="Fill">
			  <Border.StrokeShape>
				  <RoundRectangle CornerRadius="18" />
			  </Border.StrokeShape>

			  <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
				  <Border StrokeThickness="0"
					  BackgroundColor="{StaticResource PrimaryContainer}"
					  Padding="7"
					  VerticalOptions="Center">
					  <Border.StrokeShape>
						  <RoundRectangle CornerRadius="12" />
					  </Border.StrokeShape>
					  <Image Source="qr.svg"
						 HeightRequest="18"
						 WidthRequest="18"
						 VerticalOptions="Center"
						 HorizontalOptions="Center" />
				  </Border>

				  <VerticalStackLayout Spacing="2" VerticalOptions="Center">
					  <Label Text="{ext:Translate Qr_HeaderTitle}"
						 FontFamily="RobotoCondensed-SemiBold"
						 FontSize="18"
						 TextColor="White"
						 LineBreakMode="TailTruncation" />
					  <Label Text="{ext:Translate Qr_PageTitle}"
						 FontFamily="RobotoCondensed-Regular"
						 FontSize="12"
						 TextColor="#D9FFFFFF" />
				  </VerticalStackLayout>
			  </HorizontalStackLayout>
		  </Border>
	     </Grid>

	     <Border Grid.Row="1"
		      Stroke="White"
		      StrokeThickness="2"
		      StrokeShape="RoundRectangle 18"
		      HeightRequest="260"
		      WidthRequest="260"
		      HorizontalOptions="Center"
		      VerticalOptions="Center"
		      BackgroundColor="#1AFFFFFF" />

	     <Label Grid.Row="2"
		     x:Name="StatusLabel"
		     Text="{ext:Translate Qr_StatusPrompt}"
		     FontFamily="RobotoCondensedRegular"
		     FontSize="15"
		     TextColor="#E5FFFFFF"
		     HorizontalTextAlignment="Center" />

	     <Frame Grid.Row="3"
		     x:Name="PickedQrFrame"
		     IsVisible="False"
		     BackgroundColor="#1AFFFFFF"
		     CornerRadius="14"
		     HasShadow="False"
		     Padding="12,10">
		  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
		      <Image x:Name="PickedQrImage"
			      HeightRequest="84"
			      WidthRequest="84"
			      Aspect="AspectFill" />

		      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
			   <Label Text="{ext:Translate Qr_PickedTitle}"
				   TextColor="White"
				   FontFamily="RobotoCondensedSemiBold"
				   FontSize="14" />
			   <Label Text="{ext:Translate Qr_PickedSubtitle}"
				   TextColor="#D9FFFFFF"
				   FontFamily="RobotoCondensedRegular"
				   FontSize="12"
				   LineBreakMode="WordWrap" />
		      </VerticalStackLayout>
		  </Grid>
	     </Frame>

	     <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10">
		  <Button Grid.Column="0"
			  Margin="0,4,0,0"
			  Text="{ext:Translate Qr_PickImageButton}"
			  Style="{StaticResource SecondaryButton}"
			  Clicked="OnPickQrImageClicked" />

		  <Button Grid.Column="1"
			  Margin="0,4,0,0"
			  Text="{ext:Translate Qr_RescanButton}"
			  Style="{StaticResource SecondaryButton}"
			  Clicked="OnRescanClicked" />
	     </Grid>

	     <Button Grid.Row="5"
		      Margin="0,4,0,0"
		      Text="{ext:Translate Qr_UseSeedButton}"
		      Style="{StaticResource PrimaryButton}"
		      Clicked="OnUseSampleQrCodeClicked" />
	 </Grid>
    </Grid>

</ContentPage>
