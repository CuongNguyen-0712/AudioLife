<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.MapPage"
             x:DataType="viewmodels:MapViewModel"
             Title="Vĩnh Khánh Bản đồ"
             BackgroundColor="Transparent">

    <Grid Padding="0">
        <!-- Map Section (full background) -->
        <Frame BackgroundColor="Transparent"
               Padding="0"
               HasShadow="False"
               Margin="0">
            <WebView x:Name="MapWebView"
                            Source="{Binding MapHtmlSource}"
                            Navigating="MapWebView_OnNavigating" />
        </Frame>

        <!-- GPS button (bottom-right) -->
        <Border
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,16,370"
            ZIndex="20"
            Background="{StaticResource SecondaryContainer}"
            StrokeThickness="0"
            Padding="0"
            StrokeShape="RoundRectangle 12">
            <ImageButton
                Source="gps.svg"
                BackgroundColor="Transparent"
                HeightRequest="40"
                WidthRequest="40"
                Padding="8"
                Command="{Binding MoveToCurrentLocationCommand}" />
        </Border>
 
         <!-- Current POI View (single card from bound data) -->
         <Border VerticalOptions="End"
              Margin="14,0,14,250"
              Stroke="Transparent"
              StrokeThickness="1"
              Padding="14,12"
              Background="{StaticResource SurfaceContainerLowest}"
              StrokeShape="RoundRectangle 26">
             <Border.GestureRecognizers>
              <TapGestureRecognizer
                  Command="{Binding LocationTappedCommand}"
                  CommandParameter="{Binding CurrentPoiLocation}" />
             </Border.GestureRecognizers>

             <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                 <Frame Grid.Column="0"
                        Padding="0"
                        Margin="0"
                        HasShadow="False"
                        CornerRadius="12"
                        HeightRequest="72"
                        WidthRequest="72"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        BorderColor="Transparent"
                        IsClippedToBounds="True">
                     <Image
                         Source="{Binding CurrentPoiLocation.ImageUrl}"
                         Aspect="AspectFill" />
                 </Frame>

                 <VerticalStackLayout Grid.Column="1"
                                      Spacing="4"
                                      VerticalOptions="Center">
                    <Label Text="{Binding CurrentPoiLocation.Name}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource OnSurface}"
                            MaxLines="2"
                            LineBreakMode="TailTruncation" />
                 <HorizontalStackLayout Grid.Row="2" Spacing="4" VerticalOptions="Center">
                    <Image
                            Source="near_me.svg"
                            WidthRequest="18"
                            HeightRequest="18"
                            VerticalOptions="Center" />
                    <Label Text="{Binding CurrentPoiLocation.Distance, StringFormat='Cách bạn {0:F1} km'}"
                            FontSize="12"
                            TextColor="{StaticResource OnSurfaceVariant}" />
                    </HorizontalStackLayout>
                 <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Image
                        Source="audio.svg"
                        WidthRequest="18"
                        HeightRequest="18"
                        VerticalOptions="Center" />
                    <Label Text="{Binding CurrentPoiLocation.AudioCount, StringFormat='{0} audio'}"
                        FontSize="12"
                        TextColor="{StaticResource OnSurfaceVariant}" />
                    </HorizontalStackLayout>
                 </VerticalStackLayout>

                 <Border Grid.Column="2"
                         Background="{StaticResource SecondaryContainer}"
                         StrokeThickness="0"
                         Padding="0"
                         VerticalOptions="Center"
                         StrokeShape="RoundRectangle 17"
                         HeightRequest="34"
                         WidthRequest="34">
                     <ImageButton
                         Source="show_more.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="34"
                         WidthRequest="34"
                         Padding="8"
                         Command="{Binding LocationTappedCommand}"
                         CommandParameter="{Binding CurrentPoiLocation}" />
                 </Border>
             </Grid>
         </Border>

        <!-- Nearby Locations Section (overlay on map) -->
        <Border VerticalOptions="End"
                    StrokeThickness="0"
                    Background="Transparent"
                    Padding="0"
                    StrokeShape="RoundRectangle 28,28,0,0">
                <Grid RowDefinitions="Auto,Auto,*" Padding="0" RowSpacing="12">
                    <BoxView Grid.RowSpan="3"
                             Color="{StaticResource SurfaceContainerLowest}"
                             Opacity="0.55" />
                

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="14,0">
                        <Label Grid.Column="0"
                               Text="ĐIA ĐIỂM GẦN ĐÂY"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               VerticalOptions="End" />
                        <Label Grid.Column="1"
                               Text="Theo khoảng cách"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="End" />
                    </Grid>

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding NearbyLocations}"
                                    SelectionMode="Single"
                                    ItemsLayout="HorizontalList"
                                    BackgroundColor="Transparent"
                                    HeightRequest="170"
                                    Margin="14,12">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:NearbyLocation">
                                <Border Stroke="{StaticResource OutlineVariant}"
                                        StrokeThickness="1"
                                        Margin="0,0,20,0"
                                        Padding="14,12"
                                        WidthRequest="200"
                                        Background="#CCFFFFFF"
                                        StrokeShape="RoundRectangle 26">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsNearest}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
                                            <Setter Property="Stroke" Value="{StaticResource Secondary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MapViewModel}}, Path=LocationTappedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                         <Frame Grid.Row="0"
                                             Padding="0"
                                             Margin="0"
                                             HasShadow="False"
                                             CornerRadius="12"
                                             HeightRequest="85"
                                             BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                             BorderColor="Transparent"
                                             IsClippedToBounds="True">
                                             <Image
                                                 Source="{Binding ImageUrl}"
                                                 Aspect="AspectFill" />
                                         </Frame>

                                         <Label Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                                 TextColor="{StaticResource OnSurface}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />

                                             <Label Grid.Row="1"
                                                 Text="Gần nhất"
                                                 FontSize="10"
                                                 FontAttributes="Bold"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Start"
                                                 Margin="0,0,0,0"
                                                     TextColor="{StaticResource OnSecondaryContainer}"
                                                 IsVisible="{Binding IsNearest}" />

                                         <HorizontalStackLayout Grid.Row="2" Spacing="4" VerticalOptions="Center">
                                             <Image
                                                 Source="near_me.svg"
                                                 WidthRequest="18"
                                                 HeightRequest="18"
                                                 VerticalOptions="Center" />
                                             <Label
                                                 Text="{Binding Distance, StringFormat='Cách bạn {0:F1} km'}"
                                                 FontSize="12"
                                                 TextColor="{StaticResource OnSurfaceVariant}"
                                                 VerticalOptions="Center" />
                                         </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
        </Border>
    </Grid>

</ContentPage>
