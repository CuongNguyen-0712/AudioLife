<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
                 Title="{ext:Translate History_PageTitle}"
                 Padding="12,10,12,20"
                 BackgroundColor="{StaticResource Surface}">

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}">
        <CollectionView ItemsSource="{Binding HistoryGroups}"
                        Margin="0"
                        IsGrouped="True">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                          <Label Text="{ext:Translate History_HeaderTitle}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                          <Label Text="{ext:Translate History_HeaderSubtitle}"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            
            <CollectionView.EmptyView>
          <Frame Padding="20"
              Margin="0,40,0,0"
              CornerRadius="18"
              HasShadow="False"
              BackgroundColor="{StaticResource SurfaceContainerLow}">
              <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
               <Image Source="history.svg" HeightRequest="36" Opacity="0.45"/>
               <Label Text="{ext:Translate History_Empty}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource OnSurfaceVariant}"/>
              </VerticalStackLayout>
          </Frame>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="viewmodels:HistoryGroup">
                    <Label Text="{Binding DateLabel}"
                            FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                  Margin="2,14,2,8"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ListeningHistory">
                    <Frame Style="{StaticResource CardFrame}" Padding="12" Margin="0,0,0,12">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=HistoryItemTappedCommand}"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Row image -->
                            <Frame Grid.Column="0"
                                   Style="{StaticResource SurfaceHighlightFrame}"
                                   WidthRequest="80"
                                   HeightRequest="80"
                                   Padding="0"
                                   Margin="0"
                                   BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                   IsClippedToBounds="True"
                                   VerticalOptions="Center">
                                <Image Source="{Binding LocationImageUrl}"
                                       Aspect="AspectFill" />
                            </Frame>

                            <!-- Content -->
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding AudioTitle}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       Margin="0"
                                       TextColor="{StaticResource OnSurface}"/>

                                <Label Text="{Binding LocationName}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       TextColor="{StaticResource OnSurfaceVariant}"
                                       Opacity="0.7"/>

                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Image Source="time.svg"
                                               HeightRequest="16"
                                               WidthRequest="16"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding ListeningTimeDisplay}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               Opacity="0.7"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <Frame Padding="8,4"
                                           CornerRadius="10"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource SecondaryContainer}">
                                             <Label Text="{Binding LanguageDisplay, StringFormat={ext:Translate History_LanguageFormat}}"
                                               FontSize="11"
                                               TextColor="{StaticResource Primary}"/>
                                    </Frame>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding ProgressPercent, StringFormat='{0}%'}"
                                           FontSize="12"
                                           FontFamily="RobotoCondensed-SemiBold"
                                           TextColor="{StaticResource OnSurface}"
                                           VerticalOptions="Center" />
                                    <ProgressBar Grid.Column="1"
                                                 Progress="{Binding NormalizedProgress}"
                                                 ProgressColor="{StaticResource Primary}"
                                                 BackgroundColor="{StaticResource SecondaryContainer}"
                                                 HeightRequest="6"
                                                 VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>

