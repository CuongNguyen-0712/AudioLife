<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             xmlns:models="clr-namespace:VinhKhanhAudioGuide.Mobile.Models"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
             Title="Lịch sử nghe">

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}">
        <CollectionView ItemsSource="{Binding HistoryGroups}"
                        Margin="15"
                        IsGrouped="True">
            
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                    <Image Source="history_icon.png" HeightRequest="60" Opacity="0.3"/>
                    <Label Text="Chưa có lịch sử nghe" HorizontalOptions="Center" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="viewmodels:HistoryGroup">
                    <Label Text="{Binding DateLabel}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,15,0,5"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ListeningHistory">
                    <Frame Padding="15" 
                           Margin="0,5"
                           CornerRadius="12">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=HistoryItemTappedCommand}"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="60,*,Auto">
                            <Image Source="{Binding LocationImageUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="60"
                                   WidthRequest="60"/>
                            
                            <VerticalStackLayout Grid.Column="1" 
                                                 Padding="15,0"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding AudioTitle}"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding LocationName}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding AudioDuration, StringFormat='{0} phút'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"/>
                                    <Label Text="{Binding Progress, StringFormat='• Đã nghe {0:P0}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            
                            <ImageButton Grid.Column="2"
                                         Source="play_icon.png"
                                         HeightRequest="40"
                                         WidthRequest="40"
                                         VerticalOptions="Center"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=HistoryItemTappedCommand}"
                                         CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
