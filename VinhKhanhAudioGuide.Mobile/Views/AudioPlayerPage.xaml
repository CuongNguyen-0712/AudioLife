<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             xmlns:local="clr-namespace:VinhKhanhAudioGuide.Mobile.Views"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.AudioPlayerPage"
             x:DataType="viewmodels:AudioPlayerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource Gray100}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:IsCurrentAudioConverter x:Key="IsCurrentAudioConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero -->
         <Frame Grid.Row="0"
             Margin="16,16,16,0"
             Padding="0"
             CornerRadius="28"
             HasShadow="True"
             IsClippedToBounds="True">
            <Grid HeightRequest="265">
                <Image Source="{Binding ImageUrl}"
                       Aspect="AspectFill" />
                <BoxView BackgroundColor="#6A000000" />

                                <Grid Padding="18,20,18,18"
                                            RowDefinitions="Auto,*,Auto"
                                            RowSpacing="0">
                                        <HorizontalStackLayout Grid.Row="0"
                                                                                     HorizontalOptions="Fill"
                                                                                     Spacing="8">
                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="{StaticResource SecondaryContainer}"
                               BorderColor="Transparent">
                            <Label Text="{Binding LocationName}"
                                   FontFamily="RobotoCondensedMedium"
                                   FontSize="11"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Frame>

                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="{StaticResource Outline}"
                               BorderColor="Transparent">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Image Source="audio.svg"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    VerticalOptions="Center" />
                                <Label Text="{Binding DurationText}"
                                    FontFamily="RobotoCondensedMedium"
                                    FontSize="11"
                                    TextColor="{StaticResource White}" />
                            </HorizontalStackLayout>
                        </Frame>
                    </HorizontalStackLayout>
                    <!-- Title and Description -->
                    <VerticalStackLayout Grid.Row="2"
                                         VerticalOptions="End"
                                         Spacing="6">
                        <Label Text="{Binding Title}"
                               TextColor="{StaticResource White}"
                               FontFamily="RobotoCondensedSemiBold"
                               FontSize="30"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Description}"
                               TextColor="{StaticResource Gray200}"
                               FontFamily="RobotoCondensedRegular"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               MaxLines="3" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Frame>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="0">
            <VerticalStackLayout Spacing="0">
                <!-- Location Description -->
                <VerticalStackLayout Padding="20" Spacing="10">
                    <Label Text="{Binding LocationName}"
                           FontSize="22"
                           TextColor="{StaticResource OnPrimaryContainer}"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           Opacity="0.7"
                           LineHeight="1.2"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Grid Style="{StaticResource LayerDivider}" Margin="0,0"/>
                
                <!-- Audio Guides List with Current Playing Highlight -->
                <VerticalStackLayout Padding="20,15" Spacing="10">
                    <Label Text="Audio Guide"
                           FontSize="20"
                           TextColor="{StaticResource OnPrimaryContainer}"
                           FontAttributes="Bold"/>

                    <CollectionView ItemsSource="{Binding AudioGuides}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       Margin="0,4"
                                       CornerRadius="10"
                                       BorderColor="{StaticResource PrimaryContainer}"
                                       HasShadow="False"
                                       BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AudioPlayerViewModel}}, Path=CurrentPlayingAudioGuideId, Converter={StaticResource IsCurrentAudioConverter}, ConverterParameter={Binding Id}}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AudioPlayerViewModel}}, Path=PlayAudioGuideCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="44,*,Auto">
                                        <Frame BackgroundColor="{StaticResource PrimaryContainer}"
                                               CornerRadius="22"
                                               Padding="0"
                                               HeightRequest="44"
                                               WidthRequest="44"
                                               HasShadow="False">
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AudioPlayerViewModel}}, Path=CurrentPlayingAudioGuideId, Converter={StaticResource IsCurrentAudioConverter}, ConverterParameter={Binding Id}}"
                                                   TextColor="{StaticResource Primary}"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Frame>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Padding="12,0"
                                                             VerticalOptions="Center"
                                                             Spacing="2">
                                            <Label Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="4"
                                                               VerticalOptions="Center">
                                            <Image Source="time.svg"
                                                   HeightRequest="14"
                                                   WidthRequest="14"
                                                   VerticalOptions="Center"/>
                                            <Label Text="{Binding Duration, StringFormat='{0} phút'}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource OnSecondaryContainer}"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Player Controls -->
        <Frame Grid.Row="2"
               Margin="16,4,16,16"
                Padding="16"
                CornerRadius="24"
               HasShadow="True"
               BackgroundColor="{StaticResource White}">
            <VerticalStackLayout Spacing="12">
                <Slider Minimum="0"
                        Maximum="{Binding Duration}"
                        Value="{Binding CurrentPosition}"
                        Style="{StaticResource AudioSlider}">
                    <Slider.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="DragStarted"
                                                        Command="{Binding BeginSeekCommand}" />
                        <toolkit:EventToCommandBehavior EventName="DragCompleted"
                                                        Command="{Binding CompleteSeekCommand}" />
                    </Slider.Behaviors>
                </Slider>
                <!-- Position and Duration Labels -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Label Text="{Binding CurrentPositionText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Label Grid.Column="2"
                           Text="{Binding DurationText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="End" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto"
                      HorizontalOptions="Fill"
                      VerticalOptions="Center"
                      ColumnSpacing="8">
                    <!-- Back Audio Guide (SVG) -->
                    <Button Grid.Column="0"
                            Command="{Binding PlayBackCommand}"
                            IsEnabled="{Binding CanPlayBack}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            TextColor="{StaticResource OnSecondaryContainer}"
                            Padding="0"
                            HeightRequest="48"
                            WidthRequest="48"
                            ImageSource="back.svg">
                    </Button>

                    <!-- Rewind Button -->
                    <Button Grid.Column="1"
                            Text="{Binding RewindGlyph}"
                            Command="{Binding RewindCommand}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            TextColor="{StaticResource OnSecondaryContainer}"
                            FontSize="18"
                            Padding="0"
                            HeightRequest="56"
                            HorizontalOptions="End" />
                    <!-- Play/Pause Button -->
                    <Button Grid.Column="2"
                            Text=""
                            ImageSource="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="22"
                            Padding="0"
                            HeightRequest="64"
                            WidthRequest="64" />
                    <!-- Forward Button -->
                    <Button Grid.Column="3"
                        Text="{Binding ForwardGlyph}"
                        Command="{Binding ForwardCommand}"
                            Style="{StaticResource SecondaryButton}"
                        BackgroundColor="{StaticResource SurfaceContainerHighest}"
                        TextColor="{StaticResource OnSecondaryContainer}"
                        FontSize="18"
                            Padding="0"
                            HeightRequest="56"
                            HorizontalOptions="Start" />

                    <!-- Next Audio Guide (SVG) -->
                    <Button Grid.Column="4"
                            Command="{Binding PlayNextCommand}"
                            IsEnabled="{Binding CanPlayNext}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            TextColor="{StaticResource OnSecondaryContainer}"
                            Padding="0"
                            HeightRequest="48"
                            WidthRequest="48"
                            ImageSource="next.svg">
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
