<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.AudioPlayerPage"
             x:DataType="viewmodels:AudioPlayerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero -->
         <Frame Grid.Row="0"
             Margin="16,16,16,0"
             Padding="0"
             CornerRadius="28"
             HasShadow="True"
             IsClippedToBounds="True">
            <Grid HeightRequest="265">
                <Image Source="{Binding ImageUrl}"
                       Aspect="AspectFill" />
                <BoxView BackgroundColor="#6A000000" />

                <VerticalStackLayout Padding="18,20,18,18"
                                     VerticalOptions="Fill"
                                     Spacing="12">
                    <HorizontalStackLayout HorizontalOptions="Fill" Spacing="8">
                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="#D9FFFFFF"
                               BorderColor="Transparent">
                            <Label Text="{Binding LocationName}"
                                   FontFamily="RobotoCondensedMedium"
                                   FontSize="11"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Frame>

                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="#33FFFFFF"
                               BorderColor="Transparent">
                            <Label Text="{Binding DurationText}"
                                   FontFamily="RobotoCondensedMedium"
                                   FontSize="11"
                                   TextColor="White" />
                        </Frame>
                    </HorizontalStackLayout>

                    <VerticalStackLayout VerticalOptions="EndAndExpand" Spacing="6">
                        <Label Text="{Binding Title}"
                               TextColor="White"
                               FontFamily="RobotoCondensedSemiBold"
                               FontSize="30"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Description}"
                               TextColor="#E8FFFFFF"
                               FontFamily="RobotoCondensedRegular"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               MaxLines="3" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding LocationName}"
                       FontSize="28"
                       FontAttributes="Bold"/>
                
                <Label Text="{Binding Description}"
                       FontSize="14"
                       TextColor="Gray"/>
                
                <Grid Style="{StaticResource LayerDivider}" Margin="0,10"/>
                
                <Label Text="Nội dung audio"
                       FontSize="18"
                       FontAttributes="Bold"/>
                
                <Label Text="{Binding CurrentScriptText}"
                       FontSize="14"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Player Controls -->
        <Frame Grid.Row="2"
               Margin="16,4,16,16"
             Padding="16"
             CornerRadius="24"
               HasShadow="True"
               BackgroundColor="{StaticResource White}">
            <VerticalStackLayout Spacing="12">
                <Slider Minimum="0"
                        Maximum="{Binding Duration}"
                        Value="{Binding CurrentPosition}"
                        Style="{StaticResource AudioSlider}">
                    <Slider.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="DragStarted"
                                                        Command="{Binding BeginSeekCommand}" />
                        <toolkit:EventToCommandBehavior EventName="DragCompleted"
                                                        Command="{Binding CompleteSeekCommand}" />
                    </Slider.Behaviors>
                </Slider>

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Label Text="{Binding CurrentPositionText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                    <Label Grid.Column="2"
                           Text="{Binding DurationText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="End" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*"
                      HorizontalOptions="Fill"
                      VerticalOptions="Center"
                      ColumnSpacing="14">
                    <Button Grid.Column="0"
                            Text="{Binding RewindGlyph}"
                            Command="{Binding RewindCommand}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="#F1F4F4"
                            TextColor="{StaticResource PrimaryDark}"
                            FontSize="18"
                            Padding="0"
                            HeightRequest="56"
                            WidthRequest="72" />

                    <Button Grid.Column="1"
                            Text="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="22"
                            Padding="0"
                            HeightRequest="68"
                            WidthRequest="68" />

                    <Button Grid.Column="2"
                        Text="{Binding ForwardGlyph}"
                        Command="{Binding ForwardCommand}"
                            Style="{StaticResource SecondaryButton}"
                        BackgroundColor="#F1F4F4"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="18"
                            Padding="0"
                            HeightRequest="56"
                            WidthRequest="72" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
