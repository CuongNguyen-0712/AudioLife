<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:VinhKhanhAudioGuide.Mobile.Converters"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.AudioPlayerPage"
             x:Name="AudioPage"
             x:DataType="viewmodels:AudioPlayerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource Gray100}">

    <ContentPage.Resources>
        <converters:DurationMinutesConverter x:Key="DurationMinutesConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Frame Grid.Row="0"
               Margin="16,16,16,0"
               Padding="0"
               CornerRadius="28"
               HasShadow="True"
               IsClippedToBounds="True">
            <Grid HeightRequest="265">
                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                <BoxView BackgroundColor="#6A000000" />

                <Grid Padding="18,20,18,18" RowDefinitions="Auto,*,Auto" RowSpacing="0">
                    <HorizontalStackLayout Grid.Row="0" Spacing="8">
                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="{StaticResource SecondaryContainer}">
                            <Label Text="{Binding LocationName}"
                                   FontFamily="RobotoCondensedMedium"
                                   FontSize="11"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Frame>

                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="{StaticResource Outline}">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Image Source="audio.svg" WidthRequest="16" HeightRequest="16" />
                                <Label Text="{Binding DurationText}"
                                       FontFamily="RobotoCondensedMedium"
                                       FontSize="11"
                                       TextColor="{StaticResource White}" />
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame Padding="10,5"
                               CornerRadius="16"
                               HasShadow="False"
                               BorderColor="Transparent"
                               BackgroundColor="{StaticResource SurfaceContainerHighest}">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsAutoPlaybackSource}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Frame.Triggers>

                            <Label Text="{Binding PlaybackSourceText}"
                                   FontFamily="RobotoCondensedMedium"
                                   FontSize="10"
                                   TextColor="{StaticResource OnSurfaceVariant}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsAutoPlaybackSource}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Frame>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Row="2" VerticalOptions="End" Spacing="6">
                        <Label Text="{Binding Title}"
                               TextColor="{StaticResource White}"
                               FontFamily="RobotoCondensedSemiBold"
                               FontSize="30"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Description}"
                               TextColor="{StaticResource Gray200}"
                               FontFamily="RobotoCondensedRegular"
                               FontSize="14"
                               MaxLines="3"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1" Padding="0">
            <VerticalStackLayout Spacing="12" Padding="16,12,16,8">
                <Frame CornerRadius="14"
                       Padding="14,12"
                       HasShadow="False"
                       BackgroundColor="{StaticResource PrimaryContainer}">
                    <VerticalStackLayout Spacing="6">
                       <Label Text="{ext:Translate Audio_NowPlayingContent}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding CurrentScriptText}"
                               FontSize="14"
                               TextColor="{StaticResource OnPrimaryContainer}"
                               LineBreakMode="WordWrap"
                               MaxLines="4" />
                    </VerticalStackLayout>
                </Frame>

                  <Label Text="{ext:Translate Audio_ListTitle}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnPrimaryContainer}" />

                <CollectionView ItemsSource="{Binding AudioGuides}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AudioGuideItemViewModel">
                            <Frame Padding="12"
                                   Margin="0,4"
                                   CornerRadius="14"
                                   BorderColor="{StaticResource SurfaceContainerHighest}"
                                   HasShadow="False"
                                   BackgroundColor="{StaticResource SurfaceContainerLowest}">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding IsCurrentPlaying}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                        <Setter Property="HasShadow" Value="True" />
                                    </DataTrigger>
                                </Frame.Triggers>

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference AudioPage}, Path=BindingContext.PlayAudioGuideCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Frame WidthRequest="38"
                                           HeightRequest="38"
                                           Padding="7"
                                           CornerRadius="19"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                        <Image Source="play_icon.svg" Aspect="AspectFit">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding IsCurrentPlaying}" Value="True">
                                                    <Setter Property="Source" Value="pause.svg" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnSurface}" />
                                              <Label Text="{ext:Translate Audio_NowPlayingBadge}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   IsVisible="{Binding IsCurrentPlaying}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Image Source="time.svg" WidthRequest="14" HeightRequest="14" />
                                        <Label Text="{Binding Duration, Converter={StaticResource DurationMinutesConverter}}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Frame Grid.Row="2"
               Margin="16,4,16,16"
               Padding="16"
               CornerRadius="24"
               HasShadow="True"
               BackgroundColor="{StaticResource White}">
            <VerticalStackLayout Spacing="12">
                <Slider Minimum="0"
                        Maximum="{Binding Duration}"
                        Value="{Binding CurrentPosition}"
                        Style="{StaticResource AudioSlider}">
                    <Slider.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="DragStarted" Command="{Binding BeginSeekCommand}" />
                        <toolkit:EventToCommandBehavior EventName="DragCompleted" Command="{Binding CompleteSeekCommand}" />
                    </Slider.Behaviors>
                </Slider>

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Text="{Binding CurrentPositionText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Label Grid.Column="2"
                           Text="{Binding DurationText}"
                           FontFamily="RobotoCondensedMedium"
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="End" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Command="{Binding PlayBackCommand}"
                            IsEnabled="{Binding CanPlayBack}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            Padding="8"
                            HeightRequest="40"
                            WidthRequest="40"
                            ImageSource="back.svg" />

                    <Button Grid.Column="1"
                            Text="{Binding RewindGlyph}"
                            Command="{Binding RewindCommand}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            TextColor="{StaticResource OnSecondaryContainer}"
                            FontSize="18"
                            Padding="8"
                            HeightRequest="50"
                            HorizontalOptions="End" />

                    <Button Grid.Column="2"
                            Text=""
                            ImageSource="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="22"
                            Padding="0"
                            HeightRequest="64"
                            WidthRequest="64" />

                    <Button Grid.Column="3"
                            Text="{Binding ForwardGlyph}"
                            Command="{Binding ForwardCommand}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            TextColor="{StaticResource OnSecondaryContainer}"
                            FontSize="18"
                            Padding="8"
                            HeightRequest="50"
                            HorizontalOptions="Start" />

                    <Button Grid.Column="4"
                            Command="{Binding PlayNextCommand}"
                            IsEnabled="{Binding CanPlayNext}"
                            Style="{StaticResource SecondaryButton}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            Padding="8"
                            HeightRequest="40"
                            WidthRequest="40"
                            ImageSource="next.svg" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
