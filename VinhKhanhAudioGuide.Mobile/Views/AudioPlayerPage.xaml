<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.AudioPlayerPage"
             x:DataType="viewmodels:AudioPlayerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        
        <!-- Header Image -->
        <Image Grid.Row="0"
               Source="{Binding ImageUrl}"
               Aspect="AspectFill"
               HeightRequest="250"/>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding LocationName}"
                       FontSize="28"
                       FontAttributes="Bold"/>
                
                <Label Text="{Binding Description}"
                       FontSize="14"
                       TextColor="Gray"/>
                
                <Grid Style="{StaticResource LayerDivider}" Margin="0,10"/>
                
                <Label Text="Nội dung audio"
                       FontSize="18"
                       FontAttributes="Bold"/>
                
                <Label Text="{Binding TranscriptText}"
                       FontSize="14"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Progress Bar -->
        <VerticalStackLayout Grid.Row="2" Padding="20,10">
            <Slider Minimum="0"
                    Maximum="{Binding Duration}"
                    Value="{Binding CurrentPosition}"
                    MinimumTrackColor="{StaticResource Primary}"
                    MaximumTrackColor="LightGray"/>
            <Grid>
                <Label Text="{Binding CurrentPositionText}" 
                       HorizontalOptions="Start"/>
                <Label Text="{Binding DurationText}" 
                       HorizontalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Player Controls -->
        <HorizontalStackLayout Grid.Row="3" 
                               HorizontalOptions="Center"
                               Spacing="30"
                               Padding="20">
            
            <ImageButton Source="rewind_icon.png"
                         Command="{Binding RewindCommand}"
                         HeightRequest="50"
                         WidthRequest="50"/>
            
            <ImageButton Source="{Binding PlayPauseIcon}"
                         Command="{Binding PlayPauseCommand}"
                         HeightRequest="70"
                         WidthRequest="70"
                         BackgroundColor="{StaticResource Primary}"
                         CornerRadius="35"/>
            
            <ImageButton Source="forward_icon.png"
                         Command="{Binding ForwardCommand}"
                         HeightRequest="50"
                         WidthRequest="50"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
