<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.TourDetailPage"
             x:DataType="viewmodels:TourDetailViewModel"
             Title="{Binding TourName}"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space4}" Padding="{StaticResource Space4}">

            <Frame Style="{StaticResource CardFrameLarge}"
                   Padding="0"
                   IsClippedToBounds="True"
                   Margin="0,4,0,0">
                <Grid HeightRequest="280">
                    <Image Source="{Binding ImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="280" />

                    <BoxView BackgroundColor="#7A000000" />

                    <Frame Style="{StaticResource PriceBadge}"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Margin="12">
                        <Label Text="{Binding PriceText}" Style="{StaticResource PriceBadgeText}" />
                    </Frame>

                    <VerticalStackLayout VerticalOptions="End"
                                         Spacing="8"
                                         Padding="16,0,16,16">
                        <Label Text="{Binding TourName}"
                               TextColor="White"
                               FontFamily="RobotoCondensed-SemiBold"
                               FontSize="30"
                               LineHeight="1.1"
                               MaxLines="2" />

                        <HorizontalStackLayout Spacing="8">
                            <Frame BackgroundColor="#66FFFFFF"
                                   CornerRadius="999"
                                   HasShadow="False"
                                   Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="time.svg" WidthRequest="14" HeightRequest="14" />
                                    <Label Text="{Binding DurationText}"
                                           FontSize="12"
                                           FontFamily="RobotoCondensed-Medium"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </HorizontalStackLayout>
                            </Frame>

                            <Frame BackgroundColor="#66FFFFFF"
                                   CornerRadius="999"
                                   HasShadow="False"
                                   Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="near_me.svg" WidthRequest="14" HeightRequest="14" />
                                    <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}"
                                           FontSize="12"
                                           FontFamily="RobotoCondensed-Medium"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </HorizontalStackLayout>
                            </Frame>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Frame Grid.Column="0" Style="{StaticResource InfoBarFrame}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label Text="Thời gian" Style="{StaticResource SmallText}" HorizontalOptions="Center" />
                        <Label Text="{Binding DurationText}" FontSize="13" FontFamily="RobotoCondensed-SemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Style="{StaticResource InfoBarFrame}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label Text="Điểm đến" Style="{StaticResource SmallText}" HorizontalOptions="Center" />
                        <Label Text="{Binding LocationCount, StringFormat='{0} điểm'}" FontSize="13" FontFamily="RobotoCondensed-SemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="2" Style="{StaticResource InfoBarFrame}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label Text="Giá" Style="{StaticResource SmallText}" HorizontalOptions="Center" />
                        <Label Text="{Binding PriceText}" FontSize="13" FontFamily="RobotoCondensed-SemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Frame Style="{StaticResource SurfaceSectionFrame}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Giới thiệu lộ trình" Style="{StaticResource SubSectionHeader}" Margin="0" />
                    <Label Text="{Binding Description}" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Lộ trình chi tiết" Style="{StaticResource SectionHeader}" Margin="0,2,0,0" />

            <CollectionView ItemsSource="{Binding TourLocations}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TourLocationItem">
                        <Grid ColumnDefinitions="42,*"
                              Padding="0"
                              Margin="0,0,0,2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TourDetailViewModel}}, Path=LocationTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="0"
                                                 Margin="0,4,0,0">
                                <Frame Style="{StaticResource TimelineNumber}">
                                    <Label Text="{Binding Order}"
                                           TextColor="White"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                                <BoxView Style="{StaticResource TimelineLine}"
                                         IsVisible="{Binding IsNotLast}" />
                            </VerticalStackLayout>

                            <Frame Grid.Column="1"
                                   Style="{StaticResource CardFrame}"
                                   Padding="12"
                                   Margin="8,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="15"
                                           FontFamily="RobotoCondensed-SemiBold"
                                           MaxLines="2" />

                                    <HorizontalStackLayout Spacing="12">
                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="time.svg" WidthRequest="14" HeightRequest="14" />
                                            <Label Text="{Binding Duration, StringFormat='{0} phút'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource OnSurfaceVariant}" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="audio.svg" WidthRequest="14" HeightRequest="14" />
                                            <Label Text="{Binding AudioCount, StringFormat='{0} audio'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource OnSurfaceVariant}" />
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>

                                    <Frame BackgroundColor="{StaticResource SecondaryContainer}"
                                           CornerRadius="999"
                                           Padding="10,4"
                                           HasShadow="False"
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding CategoryName}"
                                               FontSize="11"
                                               FontFamily="RobotoCondensed-Medium"
                                               TextColor="{StaticResource OnSecondaryContainer}" />
                                    </Frame>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Bản đồ lộ trình" Style="{StaticResource SectionHeader}" Margin="0,2,0,0" />

            <Frame Style="{StaticResource CardFrameLarge}"
                   Padding="0"
                   HeightRequest="240"
                   IsClippedToBounds="True"
                   HasShadow="False">
                <WebView Source="{Binding MapHtmlSource}" />
            </Frame>

            <Button Text="Bắt đầu lộ trình"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding StartTourCommand}"
                    Margin="0,8,0,20" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
