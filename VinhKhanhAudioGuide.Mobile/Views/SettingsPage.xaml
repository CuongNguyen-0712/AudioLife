<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Cài đặt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Language Settings -->
            <Label Text="Ngôn ngữ"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"/>
            
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Ngôn ngữ Audio"
                                       FontSize="16"/>
                                <Label Text="{Binding SelectedLanguage}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectLanguageCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Playback Settings -->
            <Label Text="Phát lại"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"
                   Margin="0,10,0,0"/>
            
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <!-- Auto Play -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Tự động phát tiếp"
                                       FontSize="16"/>
                                <Label Text="Tự động phát audio tiếp theo"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding AutoPlayNext}"
                                    OnColor="{StaticResource Primary}"/>
                        </Grid>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Playback Speed -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Tốc độ phát"
                                       FontSize="16"/>
                                <Label Text="{Binding PlaybackSpeed, StringFormat='{0}x'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPlaybackSpeedCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Skip Interval -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Khoảng tua"
                                       FontSize="16"/>
                                <Label Text="{Binding SkipInterval, StringFormat='{0} giây'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSkipIntervalCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Download Settings -->
            <Label Text="Tải xuống"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"
                   Margin="0,10,0,0"/>
            
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <!-- Download over WiFi only -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Chỉ tải qua WiFi"
                                       FontSize="16"/>
                                <Label Text="Tiết kiệm dữ liệu di động"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding DownloadOnWifiOnly}"
                                    OnColor="{StaticResource Primary}"/>
                        </Grid>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Audio Quality -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Chất lượng Audio"
                                       FontSize="16"/>
                                <Label Text="{Binding AudioQuality}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" 
                                   Source="chevron_right"
                                   HeightRequest="16"/>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAudioQualityCommand}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <!-- Storage Used -->
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Dung lượng đã dùng"
                                       FontSize="16"/>
                                <Label Text="{Binding StorageUsed}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Button Text="Xóa"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="32"
                                    FontSize="12"
                                    Padding="15,5"
                                    Command="{Binding ClearDownloadsCommand}"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Notifications -->
            <Label Text="Thông báo"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"
                   Margin="0,10,0,0"/>
            
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Thông báo Push"
                                       FontSize="16"/>
                                <Label Text="Nhận thông báo về nội dung mới"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding EnableNotifications}"
                                    OnColor="{StaticResource Primary}"/>
                        </Grid>
                    </Frame>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="15,0"/>
                    
                    <Frame Padding="15" BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Thông báo vị trí"
                                       FontSize="16"/>
                                <Label Text="Nhận thông báo khi đến gần địa điểm"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    IsToggled="{Binding EnableLocationNotifications}"
                                    OnColor="{StaticResource Primary}"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Theme -->
            <Label Text="Giao diện"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"
                   Margin="0,10,0,0"/>
            
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <Frame Padding="15" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Chế độ tối"
                                   FontSize="16"/>
                            <Label Text="{Binding ThemeMode}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"/>
                        </VerticalStackLayout>
                        <Image Grid.Column="1" 
                               Source="chevron_right"
                               HeightRequest="16"/>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectThemeCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
