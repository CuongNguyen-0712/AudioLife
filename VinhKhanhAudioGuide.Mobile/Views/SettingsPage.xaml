<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:VinhKhanhAudioGuide.Mobile.Extensions"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{ext:Translate Settings_PageTitle}"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="{ext:Translate Settings_Favorites}" FontSize="12" Command="{Binding GoToFavoritesCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="1" Text="{ext:Translate Settings_Downloads}" FontSize="12" Command="{Binding GoToDownloadsCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="2" Text="{ext:Translate Settings_History}" FontSize="12" Command="{Binding GoToHistoryCommand}" Style="{StaticResource OutlineButton}" />
            </Grid>

            <Label Text="{ext:Translate Settings_AutoPlayByLocationSection}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource OnSurfaceVariant}" Margin="2,6,2,0" />
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Grid Padding="14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{ext:Translate Settings_AutoNearestTitle}" FontSize="15" />
                            <Label Text="{ext:Translate Settings_AutoNearestDescription}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoNearestPoiPlayback}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Translate Settings_LocationScanCycle}" FontSize="15" />
                        <Label Grid.Column="1" Text="{Binding LocationScanInterval}" FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{ext:Translate Settings_PlaybackSection}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource OnSurfaceVariant}" Margin="2,6,2,0" />
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Grid Padding="14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{ext:Translate Settings_AutoPlayNextTitle}" FontSize="15" />
                            <Label Text="{ext:Translate Settings_AutoPlayNextDescription}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoPlayNext}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_PlaybackSpeed}" FontSize="15" />
                            <Label Text="{Binding PlaybackSpeed, StringFormat='{0}x'}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPlaybackSpeedCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_SkipInterval}" FontSize="15" />
                            <Label Text="{Binding SkipInterval, StringFormat='{0} giây'}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSkipIntervalCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{ext:Translate Settings_AppSection}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource OnSurfaceVariant}" Margin="2,6,2,0" />
            <Frame CornerRadius="12" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_Language}" FontSize="15" />
                            <Label Text="{Binding SelectedLanguage}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_Theme}" FontSize="15" />
                            <Label Text="{Binding ThemeMode}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectThemeCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_Help}" FontSize="15" />
                            <Label Text="{ext:Translate Settings_HelpSubtitle}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToHelpCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid Style="{StaticResource LayerDivider}" Margin="14,0" />
                    <Grid Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{ext:Translate Settings_About}" FontSize="15" />
                            <Label Text="{ext:Translate Settings_AboutSubtitle}" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="chevron_right.svg" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAboutCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
