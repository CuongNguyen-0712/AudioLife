<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VinhKhanhAudioGuide.Mobile.ViewModels"
             x:Class="VinhKhanhAudioGuide.Mobile.Views.DownloadsPage"
             x:DataType="viewmodels:DownloadsViewModel"
             Title="Audio đã tải">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Storage Info -->
        <Frame Grid.Row="0" 
               Margin="15"
               Padding="15"
               CornerRadius="12"
               BackgroundColor="{StaticResource Secondary}">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="Dung lượng đã sử dụng"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"/>
                    <Label Text="{Binding TotalSizeText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Xóa tất cả"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding DeleteAllCommand}"
                        VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Downloads List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Downloads}"
                        Margin="15,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                    <Image Source="download_icon.png" HeightRequest="60" Opacity="0.3"/>
                    <Label Text="Chưa có audio nào được tải" HorizontalOptions="Center" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DownloadItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Xóa"
                                           BackgroundColor="{StaticResource AudioGuideRed}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DownloadsViewModel}}, Path=DeleteDownloadCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Frame Padding="15" 
                               Margin="0,5"
                               CornerRadius="12">
                            <Grid ColumnDefinitions="50,*,Auto">
                                <Frame BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="25"
                                       Padding="0"
                                       HeightRequest="50"
                                       WidthRequest="50">
                                    <Image Source="audio_icon.png"
                                           HeightRequest="24"
                                           WidthRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                
                                <VerticalStackLayout Grid.Column="1" 
                                                     Padding="15,0"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="14"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding LocationName}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"/>
                                    <Label Text="{Binding FileSize}"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"/>
                                </VerticalStackLayout>
                                
                                <ImageButton Grid.Column="2"
                                             Source="play_icon.png"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             VerticalOptions="Center"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DownloadsViewModel}}, Path=PlayDownloadCommand}"
                                             CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
