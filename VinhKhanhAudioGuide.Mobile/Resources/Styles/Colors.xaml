<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Editorial palette from design.md -->
    <Color x:Key="Primary">#13696D</Color>
    <Color x:Key="PrimaryContainer">#70B9BE</Color>
    <Color x:Key="PrimaryFixed">#A5EFF4</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryContainer">#00494D</Color>

    <Color x:Key="Secondary">#456466</Color>
    <Color x:Key="SecondaryContainer">#C5E6E8</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="OnSecondaryContainer">#49686A</Color>

    <Color x:Key="Tertiary">#8A4F30</Color>
    <Color x:Key="TertiaryContainer">#E69C77</Color>
    <Color x:Key="TertiaryFixed">#FFDBCB</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="OnTertiaryFixed">#341100</Color>

    <!-- Surface layering (no-line rule) -->
    <Color x:Key="Surface">#F8FAF8</Color>
    <Color x:Key="SurfaceDim">#D8DAD9</Color>
    <Color x:Key="SurfaceBright">#F8FAF8</Color>
    <Color x:Key="SurfaceVariant">#E1E3E1</Color>
    <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLow">#F2F4F2</Color>
    <Color x:Key="SurfaceContainer">#ECEEEC</Color>
    <Color x:Key="SurfaceContainerHigh">#E6E9E7</Color>
    <Color x:Key="SurfaceContainerHighest">#E1E3E1</Color>

    <!-- Text and supporting colors -->
    <Color x:Key="OnSurface">#191C1B</Color>
    <Color x:Key="OnSurfaceVariant">#3F4949</Color>
    <Color x:Key="Outline">#6F7979</Color>
    <Color x:Key="OutlineVariant">#BEC8C9</Color>

    <!-- Legacy aliases for compatibility -->
    <Color x:Key="PrimaryDark">#00494D</Color>
    <Color x:Key="PrimaryDarkText">#191C1B</Color>
    <Color x:Key="Accent">#E69C77</Color>
    <Color x:Key="AccentLight">#F2F4F2</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#191C1B</Color>

    <Color x:Key="Gray100">#F2F4F2</Color>
    <Color x:Key="Gray200">#ECEEEC</Color>
    <Color x:Key="Gray300">#E6E9E7</Color>
    <Color x:Key="Gray400">#BEC8C9</Color>
    <Color x:Key="Gray500">#6F7979</Color>
    <Color x:Key="Gray600">#3F4949</Color>
    <Color x:Key="Gray900">#191C1B</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="AudioGuideBlue">#13696D</Color>
    <Color x:Key="AudioGuideGreen">#4E7668</Color>
    <Color x:Key="AudioGuideOrange">#E69C77</Color>
    <Color x:Key="AudioGuideRed">#BA1A1A</Color>
    <Color x:Key="Error">#BA1A1A</Color>

    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>

</ResourceDictionary>
