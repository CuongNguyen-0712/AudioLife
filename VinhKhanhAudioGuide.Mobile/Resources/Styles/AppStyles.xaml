<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:VinhKhanhAudioGuide.Mobile.Converters">

    <!-- Converters -->
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    <converters:BoolToTextColorConverter x:Key="BoolToTextColorConverter"/>
    <converters:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColorConverter"/>
    <converters:BoolToHeartGlyphConverter x:Key="BoolToHeartGlyphConverter"/>
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    <converters:MinutesToHoursConverter x:Key="MinutesToHoursConverter"/>
    <converters:BoolToRotationConverter x:Key="BoolToRotationConverter"/>
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>

    <!-- Card Styles -->
    <Style x:Key="CardFrame"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"/>
        <Setter Property="CornerRadius"
                Value="12"/>
        <Setter Property="Padding"
                Value="0"/>
        <Setter Property="HasShadow"
                Value="True"/>
        <Setter Property="BorderColor"
                Value="Transparent"/>
    </Style>

    <Style x:Key="CardFrameSmall"
            TargetType="Frame"
            BasedOn="{StaticResource CardFrame}">
        <Setter Property="CornerRadius"
                Value="8"/>
    </Style>

    <Style x:Key="CardFrameLarge"
            TargetType="Frame"
            BasedOn="{StaticResource CardFrame}">
        <Setter Property="CornerRadius"
                Value="16"/>
    </Style>


    <!-- Header Styles -->
    <Style x:Key="PageHeader"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="28"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        
    </Style>

    <Style x:Key="SectionHeader"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="20"/>
        <Setter Property="FontAttributes"
                Value="Bold"/>

        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        <Setter Property="Margin"
                Value="0,15,0,10"/>
        
    </Style>

    <Style x:Key="SubSectionHeader"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="16"/>
       
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
       
    </Style>

    <!-- Text Styles -->
    <Style x:Key="BodyText"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
      
    </Style>

    <Style x:Key="CaptionText"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
    </Style>

    <Style x:Key="SmallText"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="11"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
    </Style>

    <Style x:Key="LinkText"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="TextColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="TextDecorations"
                Value="Underline"/>
    </Style>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton"
            TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontFamily"
                Value="RobotoCondensedSemiBold"/>
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="CornerRadius"
                Value="25"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="Padding"
                Value="30,0"/>
    </Style>

    <Style x:Key="SecondaryButton"
            TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Secondary}"/>
        <Setter Property="TextColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily"
                Value="RobotoCondensedSemiBold"/> 
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="CornerRadius"
                Value="25"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="Padding"
                Value="30,0"/>
    </Style>

    <Style x:Key="OutlineButton"
            TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="Transparent"/>
        <Setter Property="TextColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="BorderColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="BorderWidth"
                Value="2"/>
        <Setter Property="FontFamily"
                Value="RobotoCondensedSemiBold"/>
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="CornerRadius"
                Value="25"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="Padding"
                Value="30,0"/>
    </Style>

    <Style x:Key="SmallButton"
            TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="CornerRadius"
                Value="15"/>
        <Setter Property="HeightRequest"
                Value="30"/>
        <Setter Property="Padding"
                Value="15,0"/>
    </Style>

    <!-- Icon Button Styles -->
    <Style x:Key="CircleIconButton"
            TargetType="ImageButton">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius"
                Value="25"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="WidthRequest"
                Value="50"/>
        <Setter Property="Padding"
                Value="12"/>
    </Style>

    <Style x:Key="CircleIconButtonSmall"
            TargetType="ImageButton">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Secondary}"/>
        <Setter Property="CornerRadius"
                Value="18"/>
        <Setter Property="HeightRequest"
                Value="36"/>
        <Setter Property="WidthRequest"
                Value="36"/>
        <Setter Property="Padding"
                Value="8"/>
    </Style>

    <!-- Input Styles -->
    <Style x:Key="RoundedSearchBar"
            TargetType="SearchBar">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray300}}"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        <Setter Property="PlaceholderColor"
                Value="{StaticResource PrimaryDark}"/>
        <Setter Property="FontSize"
                Value="14"/>
    </Style>

    <Style x:Key="RoundedEntry"
            TargetType="Entry">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"/>
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        <Setter Property="PlaceholderColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="FontSize"
                Value="14"/>
    </Style>

    <!-- Badge Styles -->
    <Style x:Key="Badge"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius"
                Value="10"/>
        <Setter Property="Padding"
                Value="8,4"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <Style x:Key="BadgeText"
            TargetType="Label">
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontSize"
                Value="10"/>
        
    </Style>

    <!-- Separator -->
    <Style x:Key="Separator"
            TargetType="BoxView">
        <Setter Property="HeightRequest"
                Value="1"/>
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"/>
        <Setter Property="Margin"
                Value="0,10"/>
    </Style>

    <!-- Avatar Styles -->
    <Style x:Key="AvatarFrame"
            TargetType="Frame">
        <Setter Property="CornerRadius"
                Value="40"/>
        <Setter Property="Padding"
                Value="0"/>
        <Setter Property="HeightRequest"
                Value="80"/>
        <Setter Property="WidthRequest"
                Value="80"/>
        <Setter Property="IsClippedToBounds"
                Value="True"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <Style x:Key="AvatarFrameSmall"
            TargetType="Frame"
            BasedOn="{StaticResource AvatarFrame}">
        <Setter Property="CornerRadius"
                Value="20"/>
        <Setter Property="HeightRequest"
                Value="40"/>
        <Setter Property="WidthRequest"
                Value="40"/>
    </Style>

    <!-- Tag/Chip Styles -->
    <Style x:Key="Chip"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Secondary}"/>
        <Setter Property="CornerRadius"
                Value="15"/>
        <Setter Property="Padding"
                Value="12,6"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <Style x:Key="ChipSelected"
            TargetType="Frame"
            BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
    </Style>

    <Style x:Key="ChipText"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="TextColor"
                Value="{StaticResource Primary}"/>
    </Style>

    <Style x:Key="ChipTextSelected"
            TargetType="Label"
            BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor"
                Value="White"/>
    </Style>

    <!-- Progress/Rating Styles -->
    <Style x:Key="ProgressBar"
            TargetType="ProgressBar">
        <Setter Property="ProgressColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="BackgroundColor"
                Value="{StaticResource Gray200}"/>
    </Style>

    <!-- Player Control Styles -->
    <Style x:Key="PlayerButton"
            TargetType="ImageButton">
        <Setter Property="BackgroundColor"
                Value="Transparent"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="WidthRequest"
                Value="50"/>
    </Style>

    <Style x:Key="PlayButton"
            TargetType="ImageButton">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius"
                Value="35"/>
        <Setter Property="HeightRequest"
                Value="70"/>
        <Setter Property="WidthRequest"
                Value="70"/>
        <Setter Property="Padding"
                Value="15"/>
    </Style>

    <!-- Slider Styles -->
    <Style x:Key="AudioSlider"
            TargetType="Slider">
        <Setter Property="MinimumTrackColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="MaximumTrackColor"
                Value="{StaticResource Gray300}"/>
        <Setter Property="ThumbColor"
                Value="{StaticResource Primary}"/>
    </Style>

    <!-- Stat Card Styles (matches web hero-stats) -->
    <Style x:Key="StatCard"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource PrimaryDark}"/>

        <Setter Property="CornerRadius"
                Value="16"/>
        <Setter Property="Padding"
                Value="12,8"/>
        <Setter Property="HasShadow"
                Value="False"/>
        <Setter Property="BorderColor"
                Value="{StaticResource PrimaryDark}"/>

    </Style>

    <Style x:Key="StatNumber"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="24"/>
       
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="HorizontalOptions"
                Value="Center"/>
    </Style>

    <Style x:Key="StatLabel"
            TargetType="Label">
        <Setter Property="FontSize"
                Value="11"/>
        <Setter Property="TextColor"
                Value="#FFFFFFCC"/>
        <Setter Property="HorizontalOptions"
                Value="Center"/>
    </Style>

    <!-- Info Bar Item (matches web detail-info-bar) -->
    <Style x:Key="InfoBarFrame"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Secondary}"/>
        <Setter Property="CornerRadius"
                Value="12"/>
        <Setter Property="Padding"
                Value="12,10"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <!-- Price Badge -->
    <Style x:Key="PriceBadge"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Accent}"/>
        <Setter Property="CornerRadius"
                Value="12"/>
        <Setter Property="Padding"
                Value="10,5"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <Style x:Key="PriceBadgeText"
            TargetType="Label">
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontSize"
                Value="13"/>
      
    </Style>

    <!-- Timeline Styles (matches web tour route) -->
    <Style x:Key="TimelineNumber"
            TargetType="Frame">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius"
                Value="16"/>
        <Setter Property="Padding"
                Value="0"/>
        <Setter Property="HeightRequest"
                Value="32"/>
        <Setter Property="WidthRequest"
                Value="32"/>
        <Setter Property="HasShadow"
                Value="False"/>
    </Style>

    <Style x:Key="TimelineLine"
            TargetType="BoxView">
        <Setter Property="WidthRequest"
                Value="2"/>
        <Setter Property="Color"
                Value="{StaticResource Primary}"/>
        <Setter Property="Opacity"
                Value="0.3"/>
    </Style>

    <!-- Accent Button Style -->
    <Style x:Key="AccentButton"
            TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Accent}"/>
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontFamily"
                Value="RobotoCondensedSemiBold"/>
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="CornerRadius"
                Value="25"/>
        <Setter Property="HeightRequest"
                Value="50"/>
        <Setter Property="Padding"
                Value="30,0"/>
    </Style>



</ResourceDictionary>
