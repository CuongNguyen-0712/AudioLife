<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:VinhKhanhAudioGuide.Mobile.Converters">

    <!-- Converters -->
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    <converters:BoolToTextColorConverter x:Key="BoolToTextColorConverter"/>
    <converters:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColorConverter"/>
    <converters:BoolToHeartGlyphConverter x:Key="BoolToHeartGlyphConverter"/>
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    <converters:MinutesToHoursConverter x:Key="MinutesToHoursConverter"/>
    <converters:BoolToRotationConverter x:Key="BoolToRotationConverter"/>
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>

    <!-- Spacing tokens for editorial rhythm -->
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space10">40</x:Double>
    <Thickness x:Key="ChipRowPadding">0,0,16,0</Thickness>

    <Style x:Key="LayerDivider" TargetType="Grid">
        <Setter Property="HeightRequest" Value="8"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerLow}"/>
    </Style>

    <!-- Surface layering styles -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerLowest}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="CardFrameSmall" TargetType="Frame" BasedOn="{StaticResource CardFrame}">
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="CardFrameLarge" TargetType="Frame" BasedOn="{StaticResource CardFrame}">
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="SurfaceSectionFrame" TargetType="Frame" BasedOn="{StaticResource CardFrame}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerLow}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="SurfaceHighlightFrame" TargetType="Frame" BasedOn="{StaticResource CardFrame}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Header styles with asymmetry -->
    <Style x:Key="PageHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="Margin" Value="24,0,16,0"/>
        <Setter Property="LineHeight" Value="1.1"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="Margin" Value="24,20,16,12"/>
    </Style>

    <Style x:Key="SubSectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Medium"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="Margin" Value="24,8,16,8"/>
    </Style>

    <!-- Text styles -->
    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Regular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="LineHeight" Value="1.35"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Regular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}"/>
    </Style>

    <Style x:Key="SmallText" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Regular"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource Gray500}"/>
    </Style>

    <Style x:Key="LinkText" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Medium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}"/>

    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Padding" Value="28,0"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}"/>
        <Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Padding" Value="28,0"/>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Padding" Value="28,0"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="HeightRequest" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!-- Icon button styles -->
    <Style x:Key="CircleIconButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="50"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="CircleIconButtonSmall" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="WidthRequest" Value="36"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- Input styles -->
    <Style x:Key="RoundedSearchBar" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="14"/>
        <!-- <Setter Property="SearchBarHandler.PlatformView.BackgroundTintList" Value="Transparent"/>
        <Setter Property="SearchBarHandler.PlatformView.Layer.BorderWidth" Value="0"/> -->
    </Style>

    <Style x:Key="RoundedEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Badge and chip styles -->
    <Style x:Key="Badge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-Medium"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="AvatarFrame" TargetType="Frame">
        <Setter Property="CornerRadius" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HeightRequest" Value="80"/>
        <Setter Property="WidthRequest" Value="80"/>
        <Setter Property="IsClippedToBounds" Value="True"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}"/>
    </Style>

    <Style x:Key="AvatarFrameSmall" TargetType="Frame" BasedOn="{StaticResource AvatarFrame}">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="WidthRequest" Value="40"/>
    </Style>

        <!-- CATEGORY -->
    <!-- Chip styles-->
    <Style x:Key="Chip" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20, 8"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="ChipSelected" TargetType="Frame" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- Chip text: unselected=dark gray, selected=white -->
    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}"/>
    </Style>

    <Style x:Key="ChipTextSelected" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}"/>
    </Style>

    <!-- Progress and player controls -->
    <Style x:Key="ProgressBar" TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Primary}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHighest}"/>
    </Style>

    <Style x:Key="PlayerButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="50"/>
    </Style>

    <Style x:Key="PlayButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius" Value="35"/>
        <Setter Property="HeightRequest" Value="70"/>
        <Setter Property="WidthRequest" Value="70"/>
        <Setter Property="Padding" Value="15"/>
    </Style>

    <Style x:Key="AudioSlider" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource Primary}"/>
        <Setter Property="MaximumTrackColor" Value="{StaticResource SurfaceContainerHighest}"/>
        <Setter Property="ThumbColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- Stat and info blocks use surface hierarchy instead of separators -->
    <Style x:Key="StatCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurface}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoCondensed-Regular"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <Style x:Key="InfoBarFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="PriceBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource TertiaryContainer}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="PriceBadgeText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TimelineNumber" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HeightRequest" Value="32"/>
        <Setter Property="WidthRequest" Value="32"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="TimelineLine" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="2"/>
        <Setter Property="HeightRequest" Value="38"/>
        <Setter Property="Color" Value="{StaticResource PrimaryContainer}"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Tertiary}"/>
        <Setter Property="TextColor" Value="{StaticResource OnTertiary}"/>
        <Setter Property="FontFamily" Value="RobotoCondensed-SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Padding" Value="28,0"/>
    </Style>

</ResourceDictionary>
